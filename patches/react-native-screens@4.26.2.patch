+
+// Hiding the tab bar while a screen whose search controller is integrated into
+// it (iOS 26 search tab) is still on screen makes UIKit move the field into the
+// navigation bar, and showing the bar again doesn't move it back. Re-attaching
+// the controller makes UIKit place it afresh.
++ (void)reattachSearchControllerOf:(UIViewController *)controller
+{
+#if !TARGET_OS_TV
+  UINavigationItem *navigationItem = controller.navigationItem;
+  UISearchController *searchController = navigationItem.searchController;
+  if (searchController == nil) {
+    return;
+  }
+  navigationItem.searchController = nil;
+  navigationItem.searchController = searchController;
+#endif
+}
+
+// Hide the enclosing tab bar for screens that ask for it, in step with the
+// push/pop. The stack's navigation controller is nested inside the tab's view
+// controller, so UIKit's own `hidesBottomBarWhenPushed` handling doesn't apply;
+// we drive `setTabBarHidden:` from here, where it animates with the transition.
+// Toggling it from a JS re-render lands at an arbitrary point mid-transition
+// instead, and the tab bar flickers.
+- (void)updateTabBarVisibilityForScreenView:(RNSScreenView *)screenView
+                       navigationController:(UINavigationController *)navigationController
+                                   animated:(BOOL)animated
+{
+#if !TARGET_OS_TV
+  if (@available(iOS 18.0, *)) {
+    UITabBarController *tabBarController = navigationController.tabBarController;
+    if (tabBarController == nil) {
+      return;
+    }
+    // A stack nested in another stack's screen within the same tab doesn't
+    // decide: the tab's own stack and its top screen own the tab bar. (Stacks
+    // above the tab bar controller, like a root stack, don't count.)
+    for (UIViewController *parent = navigationController.parentViewController;
+         parent != nil && parent != tabBarController;
+         parent = parent.parentViewController) {
+      if ([parent isKindOfClass:[UINavigationController class]]) {
+        return;
+      }
+    }
+    BOOL hidden = screenView.hidesBottomBarWhenPushed;
+    BOOL wasHidden = tabBarController.isTabBarHidden;
+    if (hidden != wasHidden) {
+      [tabBarController setTabBarHidden:hidden animated:animated];
+    }
+    // Re-place the field now, with the bar already marked visible, so it rides
+    // back in with the tab bar. Waiting for the transition to finish leaves it
+    // in the navigation bar for the whole pop and then jumps it down.
+    if (wasHidden && !hidden) {
+      [RNSScreenStackView reattachSearchControllerOf:screenView.controller];
+    }
+    id<UIViewControllerTransitionCoordinator> coordinator = navigationController.transitionCoordinator;
+    if (!animated || coordinator == nil) {
+      return;
+    }
+    // A cancelled interactive pop leaves the old screen on top; settle on
+    // whatever screen actually ended up there.
+    __weak UINavigationController *weakNavigationController = navigationController;
+    [coordinator animateAlongsideTransition:nil
+                                 completion:^(id<UIViewControllerTransitionCoordinatorContext> context) {
+                                   UIViewController *top = weakNavigationController.topViewController;
+                                   if (![top.view isKindOfClass:[RNSScreenView class]]) {
+                                     return;
+                                   }
+                                   BOOL topHidden = static_cast<RNSScreenView *>(top.view).hidesBottomBarWhenPushed;
+                                   if (topHidden != tabBarController.isTabBarHidden) {
+                                     [tabBarController setTabBarHidden:topHidden animated:YES];
+                                   }
+                                 }];
+  }
+#endif
 }
 
