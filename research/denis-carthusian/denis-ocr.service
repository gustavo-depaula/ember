# Install: see "Running the full drafts" in README.md.
[Unit]
Description=Denis the Carthusian: dots.mocr drafts of every volume
After=network-online.target
# A failure that repeats is a bug, not a hiccup: after 5 in half an hour, stop and
# show as failed rather than restart forever (it once looped for 12 hours).
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/Documents/ember/.claude/worktrees/bridge-cse_01JRg9EA6b5WHThBdtG4ivyc/research/denis-carthusian/pipeline.sh
Restart=on-failure
RestartSec=60
# Let in-flight pages finish writing before vLLM is torn down.
TimeoutStopSec=60

[Install]
WantedBy=default.target
