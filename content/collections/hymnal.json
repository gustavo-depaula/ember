	"description": {
		"en-US": "The hymns, sequences and canticles of the Roman tradition, gathered by hour and season.",
		"pt-BR": "Os hinos, sequências e cânticos da tradição romana, reunidos por hora e por tempo litúrgico."
	},
	"icon": "scroll",
	"languages": [
		"en-US",
		"pt-BR"
