{"id":"indice-pleg-euc","source":"m_estructura/indices/m_estructura_indice_pleg_euc.html","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"bold","t":"Preces Eucharisticæ"}]],"cls":"ind1"}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_1#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica I (Canon Romanus)"]]}]},"in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Te ígitur, clementíssime Pater, per Iesum Christum..."}]]}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_2#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica II"]]}]},"in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Vere Sanctus es, Dómine, fons omnis sanctitátis..."}]]}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_3#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica III"]]}]},"in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Vere Sanctus es, Dómine, et mérito te laudat omnis a te cóndita"}," ",{"m":"italic","t":"creatúra..."}]]}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_4#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica IV"]]}]},"in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Confitémur tibi, Pater sancte, quia magnus es et ómnia ópera tua..."}]]}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_i#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica V-I"]]}]},"in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Vere Sanctus es et glorificándus, amátor hóminum Deus..."}]]}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_ii#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica V-II"]]}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iii#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica V-III"]]}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iv#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica V-IV"]]}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_i#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Euch. \"De Reconciliatione\" I"]]}]},"in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Vere Sanctus es, Dómine, qui ab orígine mundi semper operáris..."}]]}]},"in":["misal_latin"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_ii#","in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[["Prex Euch. \"De Reconciliatione\" II"]]}]},"in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Te ígitur, Pater omnípotens, benedícimus per Iesum Christum Fílium"}," ",{"m":"italic","t":"tuum..."}]]}]},"in":["misal_latin"]},{"text":{"*":[{"k":"p","lines":[[{"m":"bold","t":"Plegarias Eucarísticas"}]],"cls":"ind1"}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_1#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Plegaria Eucarística I (Canon Romano)"]]}]},"in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Padre misericordioso, te pedimos humildemente..."}]]}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_2#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Plegaria Eucarística II"]]}]},"in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Santo eres en verdad, Señor, fuente de toda santidad..."}]]}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_3#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Plegaria Eucarística III"]]}]},"in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Santo eres en verdad, Padre, y con razón te alaban todas tus"}," ",{"m":"italic","t":"criaturas..."}]]}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_4#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Plegaria Eucarística IV"]]}]},"in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Te alabamos, Padre santo, porque eres grande..."}]]}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_i#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Pleg. Euc. para varias necesidades I"]]}]},"in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Santo eres en verdad y digno de gloria, Dios que amas a los"}," ",{"m":"italic","t":"hombres..."}]]}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_ii#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Pleg. Euc. para varias necesidades II"]]}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iii#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Pleg. Euc. para varias necesidades III"]]}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iv#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Pleg. Euc. para varias necesidades IV"]]}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_i#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Pleg. Euc. de la Reconciliación I"]]}]},"in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Santo eres en verdad, Señor, que desde el principio del mundo..."}]]}]},"in":["misal_cast"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_ii#","in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[["Pleg. Euc. de la Reconciliación II"]]}]},"in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"A ti, pues, Padre omnipotente, te bendecimos por Jesucristo, tu"}," ",{"m":"italic","t":"Hijo..."}]]}]},"in":["misal_cast"]},{"text":{"*":[{"k":"p","lines":[[{"m":"bold","t":"Eucharistic Prayers"}]],"cls":"ind1"}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_1#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer I (Roman Canon)"]]}]},"in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"To you, therefore, most merciful Father..."}]]}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_2#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer II"]]}]},"in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"You are indeed Holy, O Lord, the fount of all holiness..."}]]}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_3#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer III"]]}]},"in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"You are indeed Holy, O Lord, and all you have created..."}]]}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_4#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer IV"]]}]},"in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"We give you praise, Father most holy, for you are great..."}]]}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_i#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer for Various Needs I"]]}]},"in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"You are indeed Holy and to be glorified, O God..."}]]}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_ii#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer for Various Needs II"]]}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iii#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer for Various Needs III"]]}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iv#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer for Various Needs IV"]]}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_i#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer for Reconciliation I"]]}]},"in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"You are indeed Holy, O Lord, and from the world's beginning..."}]]}]},"in":["misal_engl"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_ii#","in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[["Eucharistic Prayer for Reconciliation II"]]}]},"in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"You, therefore, almighty Father, we bless through Jesus Christ your"}," ",{"m":"italic","t":"Son..."}]]}]},"in":["misal_engl"]},{"text":{"*":[{"k":"p","lines":[[{"m":"bold","t":"Preghiere Eucaristiche"}]],"cls":"ind1"}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_1#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preghiera Eucaristica I (Canone Romano)"]]}]},"in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Padre clementissimo, noi ti supplichiamo e ti chiediamo..."}]]}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_2#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preghiera Eucaristica II"]]}]},"in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Padre veramente santo, fonte di ogni santità..."}]]}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_3#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preghiera Eucaristica III"]]}]},"in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Padre veramente santo, a te la lode da ogni creatura..."}]]}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_4#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preghiera Eucaristica IV"]]}]},"in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Noi ti lodiamo, Padre santo, per la tua grandezza..."}]]}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_ii#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preghiera Eucaristica V-a"]]}]},"in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Ti glorifichiamo, Padre santo: tu ci sostieni sempre nel nostro"}," ",{"m":"italic","t":"cammino..."}]]}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iii#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preghiera Eucaristica V-b"]]}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iv#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preghiera Eucaristica V-c"]]}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_i#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preghiera Eucaristica V-d"]]}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_i#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preg. Euc. della Riconciliazione I"]]}]},"in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Padre veramente santo, fin dall'origine del mondo..."}]]}]},"in":["misal_ital"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_ii#","in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[["Preg. Euc. della Riconciliazione II"]]}]},"in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Noi ti benediciamo, Dio onnipotente Signore del cielo e della"}," ",{"m":"italic","t":"terra..."}]]}]},"in":["misal_ital"]},{"text":{"*":[{"k":"p","lines":[[{"m":"bold","t":"Das Eucharistische Hochgebet"}]],"cls":"ind1"}]},"in":["misal_germ"]},{"ref":"upstream:plegarias_euc/plegaria_euc_1#","in":["misal_germ"]},{"text":{"*":[{"k":"p","lines":[["Erstes Hochgebet (Der Römische Messkanon)"]]}]},"in":["misal_germ"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Dich, gütiger Vater, bitten wir..."}]]}]},"in":["misal_germ"]},{"ref":"upstream:plegarias_euc/plegaria_euc_2#","in":["misal_germ"]},{"text":{"*":[{"k":"p","lines":[["Zweites Hochgebet"]]}]},"in":["misal_germ"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Ja, du bist heilig, großer Gott, du bist der Quell aller"}],[{"m":"italic","t":"Heiligkeit..."}]]}]},"in":["misal_germ"]},{"ref":"upstream:plegarias_euc/plegaria_euc_3#","in":["misal_germ"]},{"text":{"*":[{"k":"p","lines":[["Drittes Hochgebet"]]}]},"in":["misal_germ"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Ja, du bist heilig, großer Gott, und alle deine Werke verkünden dein"}," ",{"m":"italic","t":"Lob..."}]]}]},"in":["misal_germ"]},{"ref":"upstream:plegarias_euc/plegaria_euc_4#","in":["misal_germ"]},{"text":{"*":[{"k":"p","lines":[["Viertes Hochgebet"]]}]},"in":["misal_germ"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Wir preisen dich, heiliger Vater, denn groß bist du..."}]]}]},"in":["misal_germ"]},{"text":{"*":[{"k":"p","lines":[[{"m":"bold","t":"Preces Eucharisticæ"}]],"cls":"ind1"}]},"in":["misal_port"]},{"ref":"upstream:plegarias_euc/plegaria_euc_1#","in":["misal_port"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica I (Canon Romanus)"]]}]},"in":["misal_port"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Pai de misericórdia, a quem sobem nossos louvores..."}]]}]},"in":["misal_port"]},{"ref":"upstream:plegarias_euc/plegaria_euc_2#","in":["misal_port"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica II"]]}]},"in":["misal_port"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Na verdade, ó Pai, vós sois santo e fonte de toda santidade..."}]]}]},"in":["misal_port"]},{"ref":"upstream:plegarias_euc/plegaria_euc_3#","in":["misal_port"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica III"]]}]},"in":["misal_port"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Na verdade, vós sois santo, ó Deus do universo..."}]]}]},"in":["misal_port"]},{"ref":"upstream:plegarias_euc/plegaria_euc_4#","in":["misal_port"]},{"text":{"*":[{"k":"p","lines":[["Prex Eucharistica IV"]]}]},"in":["misal_port"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Nós proclamamos a vossa grandeza, Pai santo..."}]]}]},"in":["misal_port"]},{"text":{"*":[{"k":"p","lines":[[{"m":"bold","t":"Prières Eucharistiques"}]],"cls":"ind1"}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_1#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["Prière eucharistique I (Canon Romanus)"]]}]},"in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Toi, Père très aimant..."}]]}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_2#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["Prière eucharistique II"]]}]},"in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Toi qui es vraiment Saint,..."}]]}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_3#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["Prière eucharistique III"]]}]},"in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Tu es vraiment Saint, Dieu de l'univers,..."}]]}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_4#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["Prière eucharistique IV"]]}]},"in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Père très saint,..."}]]}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_i#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["Prière eucharistique V-I"]]}]},"in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Vraiment, tu es saint et digne de louange,..."}]]}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_ii#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["Prière eucharistique V-II"]]}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iii#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["Prière eucharistique V-III"]]}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_5_iv#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["Prière eucharistique V-IV"]]}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_i#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["PE pour la réconciliation I"]]}]},"in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Toi, Seigneur, tu es vraiment Saint,..."}]]}]},"in":["misal_fran"]},{"ref":"upstream:plegarias_euc/plegaria_euc_rec_ii#","in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[["PE pour la réconciliation II"]]}]},"in":["misal_fran"]},{"text":{"*":[{"k":"p","lines":[[{"m":"italic","t":"Père tout-puissant, nous te bénissons..."}]]}]},"in":["misal_fran"]}],"title":{}}
