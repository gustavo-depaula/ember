  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Parátum cor eius, sperans in Dómino,"
       ],
       [
        "confirmátum est cor eius, non timébit,"
       ],
       [
        "donec despíciat inimícos suos."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Confiando em Deus, seu coração está seguro. Seu coração está tranquilo e nada teme, e confusos há de ver seus inimigos"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "His heart is steadfast, trusting the Lord."
       ],
       [
        "His heart is tranquil, without fear,"
       ],
       [
        "till at last he looks down on his foes."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Su corazón está firme en el Señor."
       ],
       [
        "Su corazón está seguro, sin temor,"
       ],
       [
        "hasta que vea derrotados a sus enemigos."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Il ne craint pas l'annonce d'un malheur :"
       ],
       [
        "le cœur ferme, il s'appuie sur le Seigneur."
       ],
       [
        "Son cœur est confiant, il ne craint pas :"
       ],
       [
        "il verra ce que valaient ses oppresseurs."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Er fürchtet sich nicht vor Verleumdung;"
       ],
       [
        "sein Herz ist fest, er vertraut auf den Herrn."
       ]
      ]
     }
    ]
   },
   "role": "verse"
  },
