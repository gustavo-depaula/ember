  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Aclamen al Señor, familias de los pueblos, aclamen la gloria y el poder del Señor; aclamen la gloria del nombre del Señor."
       ]
      ]
     }
    ]
   },
   "part": "psalm",
   "role": "verse"
  },
  {
   "text": {
    "*": [
