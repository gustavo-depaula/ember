   "part": "psalm",
   "role": "people"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Zions Nahrung will ich reichlich segnen,"
       ],
       [
        "mit Brot seine Armen sättigen."
       ],
       [
        "Seine Priester will ich bekleiden mit Heil,"
       ],
       [
        "seine Frommen sollen jauchzen und jubeln."
       ]
      ]
     }
    ]
   },
   "part": "psalm",
   "role": "verse"
