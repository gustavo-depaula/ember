      "k": "p",
      "lines": [
       [
        "Dort lasse ich Davids Macht erstarken"
       ],
       [
        "und stelle für meinen Gesalbten ein Licht auf."
       ],
       [
        "Ich bedecke seine Feinde mit Schande;"
       ],
       [
        "doch auf ihm erglänzt seine Krone.“"
       ]
      ]
     }
    ]
