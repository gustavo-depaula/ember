      "k": "p",
      "lines": [
       [
        "Der Herr hat den Zion erwählt,"
       ],
       [
        "ihn zu seinem Wohnsitz erkoren:"
       ],
       [
        "„Das ist für immer der Ort meiner Ruhe;"
       ],
       [
        "hier will ich wohnen, ich hab‘ ihn erkoren."
       ]
      ]
     }
    ]
   },
   "part": "psalm",
   "role": "verse"
  },
  {
