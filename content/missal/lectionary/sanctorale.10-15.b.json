":"104","text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Cantaré eternamente las misericordias del"],["Señor."]]}]},"part":"psalm","role":"people"},{"slot":"105","text":{"*":[{"k":"p","lines":[["Dios es temible en el consejo de los santos,"],["es grande y terrible para toda su corte."],["Señor del universo, ¿quién como tú?"],["El poder y la fidelidad te rodean."]]}]},"part":"psalm","role":"verse"},{"slot":"106","text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Cantaré eternamente las misericordias del"],["Señor."]]}]},"part":"psalm","role":"people"},{"slot":"107","text":{"*":[{"k":"p","lines":[["Dichoso el pueblo que sabe aclamarte:"],["caminará, oh, Señor, a la luz de tu rostro;"],["tu nombre es su gozo cada día,"],["tu justicia es su orgullo."]]}]},"part":"psalm","role":"verse"},{"slot":"108","text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Cantaré eternamente las misericordias del"],["Señor."]]}]},"part":"psalm","role":"people"},{"slot":"109","text":{"*":[{"k":"p","lines":[["Porque tú eres su honor y su fuerza,"],["y con tu favor realzas nuestro poder."],["Porque el Señor es nuestro escudo, y el Santo de Israel nuestro rey."]]}]},"part":"psalm","role":"verse"},{"slot":"110","text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Cantaré eternamente las misericordias del"],["Señor."]]}]},"part":"psalm","role":"people"},{"slot":"115","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Laus tibi, Christe."]]}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Glória a vós, Senhor."]]}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Praise to you, Lord Jesus Christ."]]}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Gloria a ti, Señor Jesús."]]}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Lode a te, o Cristo."]]}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"R/. "},"Louange à toi, Seigneur Jésus !"]]}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"A: "},"Lob sei dir, Christus."]]}]},"role":"people","par