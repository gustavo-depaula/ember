   "part": "psalm",
   "role": "people"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "¡Cambia, Señor, nuestra suerte como los torrentes del Négueb! Los que siembran entre lágrimas cosecharán entre canciones."
       ]
      ]
     }
    ]
   },
   "part": "psalm",
   "role": "verse"
