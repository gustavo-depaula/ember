  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Eúntes in mundum univérsum, prædicáte Evangélium."
       ],
       [
        {
         "m": "rubric",
         "t": "vel: "
        },
        "Allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Ide, por todo o mundo, e a todos pregai o Evangelho"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Go out to all the world and tell the Good News."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Id al mundo entero y proclamad el Evangelio."
       ],
       [
        {
         "m": "rubric",
         "t": "O bien: "
        },
        "Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Andate in tutto il mondo e proclamate il Vangelo."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Allez dans le monde entier. Proclamez l'Évangile."
       ],
       [
        {
         "m": "rubric",
         "t": "Ou bien: "
        },
        "Alléluia"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Geht hinaus in die ganze Welt, und verkündet allen das Evangelium!"
       ],
       [
        {
         "m": "rubric",
         "t": "Oder: "
        },
        "Halleluja."
       ]
      ]
     }
    ]
   },
   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Laudáte Dóminum, omnes gentes,"
       ],
       [
        "collaudáte eum, omnes pópuli."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Cantai louvores ao Senhor, todas as gentes, povos todos, festejai-o!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "O praise the Lord, all you nations, acclaim him all you peoples!"
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Alabad al Señor todas las naciones,"
       ],
       [
        "aclamadlo todos los pueblos."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Genti tutte, lodate il Signore,"
       ],
       [
        "popoli tutti, cantate la sua lode."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Louez le Seigneur, tous les peuples ;"
       ],
       [
        "fêtez-le, tous les pays !"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Lobet den Herrn, alle Völker,"
       ],
       [
        "preist ihn, alle Nationen!"
       ]
      ]
     }
    ]
   },
   "role": "verse"
  },
