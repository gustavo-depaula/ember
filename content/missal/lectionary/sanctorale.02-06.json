    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Convérte, Dómine, captivitátem nostram,"
       ],
       [
        "sicut torréntes in austro."
       ],
       [
        "Qui séminant in lácrimis,"
       ],
       [
        "in exsultatióne metent."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Mudai a nossa sorte, ó Senhor, como torrentes no deserto. Os que lançam as sementes entre lágrimas, ceifarão com alegria."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Deliver us, O Lord, from our bondage as streams in dry land. Those who are sowing in tears will sing when they reap."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Recoge, Señor, a nuestros cautivos"
       ],
       [
        "como los torrentes del Negueb."
       ],
       [
        "Los que sembraban con lágrimas"
       ],
       [
        "cosechan entre cantares."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ristabilisci, Signore, la nostra sorte,"
       ],
       [
        "come i torrenti del Negheb."
       ],
       [
        "Chi semina nelle lacrime mieterà"
       ],
       [
        "nella gioia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Ramène, Seigneur, nos captifs,"
       ],
       [
        "comme les torrents au désert."
       ],
       [
        "Qui sème dans les larmes"
       ],
       [
        "moissonne dans la joie. +"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
