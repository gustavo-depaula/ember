   "part": "psalm",
   "role": "people"
  },
  {
   "text": {
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "¡Alaben al Señor, todas las naciones, glorifíquenlo, todos los pueblos!"
       ]
      ]
     }
    ]
   },
   "part": "psalm",
   "role": "verse"
  },
