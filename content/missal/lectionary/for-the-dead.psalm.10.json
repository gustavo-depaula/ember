   },
   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Doce me fácere beneplácitum tuum,"
       ],
       [
        "quia Deus meus es tu."
       ],
       [
        "Spíritus tuus bonus dedúcet me in terram rectam."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Ensinai-me a cumprir a vossa vontade, porque sois o meu Deus. O vosso espírito de bondade me conduza por caminho recto."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Teach me to do your will for you, O Lord, are my God. Let your good spirit guide me in ways that are level and smooth."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Enséñame a cumplir tu ley,"
       ],
       [
        "ya que tú eres mi Dios."
       ],
       [
        "Tu espíritu, que es bueno,"
       ],
       [
        "me guíe por tierra llana."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Insegnami a compiere il tuo volere,"
       ],
       [
        "perché sei tu il mio Dio."
       ],
       [
        "Il tuo spirito buono"
       ],
       [
        "mi guidi in terra piana"
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Apprends-moi à faire ta volonté,"
       ],
       [
        "car tu es mon Dieu."
       ],
       [
        "Ton souffle est bienfaisant :"
       ],
       [
        "qu'il me guide en un pays de plaines."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Lehre mich, deine Willen zu tun; denn du bist mein Gott."
       ],
       [
        "Dein guter Geist leite mich auf ebenem Pfad."
       ],
       [
        "Um deines Namens willen, Herr, erhalt mich am Leben,"
       ],
       [
        "führe mich heraus aus der Not in deiner Gerechtigkeit!"
       ]
      ]
     }
    ]
   },
   "role": "verse"
