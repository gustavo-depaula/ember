       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Herr, lass mich deine Huld erfahren; denn ich vertraue auf dich."
       ],
       [
        {
         "m": "rubric",
         "t": "Oder: "
        },
        "Herr, erhöre mein Gebet!"
       ]
      ]
     }
    ]
   },
   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Dómine, exáudi oratiónem meam,"
       ],
       [
        "áuribus pércipe obsecratiónem meam in veritáte tua;"
       ],
       [
        "exáudi me in tua iustítia."
       ],
       [
        "Et non intres in iudícium cum servo tuo,"
       ],
       [
        "quia non iustificábitur in conspéctu tuo omnis vivens"
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Ouvi, Senhor, a minha oração, pela vossa fidelidade, escutai a minha súplica, atendei-me pela vossa justiça. Não chameis a juízo o vosso servo, porque ninguém é justo diante de Vós."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Lord, listen to my prayer: turn your ear to my appeal. You are faithful, you are just; give answer. Do not call your servant to judgement for no one is just in your sight."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Señor, escucha mi oración;"
       ],
       [
        "tú, que eres fiel, atiende a mi súplica;"
       ],
       [
        "tú, que eres justo, escúchame."
       ],
       [
        "No llames a juicio a tu siervo,"
       ],
       [
        "pues ningún hombre vivo es inocente frente a ti."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Signore, ascolta la mia preghiera,"
       ],
       [
        "porgi l'orecchio alla mia supplica,"
       ],
       [
        "tu che sei fedele,"
       ],
       [
        "e per la tua giustizia rispondimi."
       ],
       [
        "Non chiamare in giudizio il tuo servo:"
       ],
       [
        "nessun vivente davanti a te è giusto"
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Seigneur, entends ma prière ;"
       ],
       [
        "dans ta justice écoute mes appels,"
       ],
       [
        "dans ta fidélité réponds-moi."
       ],
       [
        "N'entre pas en jugement avec ton serviteur :"
       ],
       [
        "aucun vivant n'est juste devant toi."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, höre mein Gebet, vernimm mein Flehen;"
       ],
       [
        "in deiner Treue erhöre mich, in deiner Gerechtigkeit!"
       ],
       [
        "Geh mit deinem Knecht nicht ins Gericht;"
       ],
       [
        "denn keiner, der lebt, ist gerecht vor dir."
       ]
      ]
     }
    ]
   },
   "role": "verse"
  },
