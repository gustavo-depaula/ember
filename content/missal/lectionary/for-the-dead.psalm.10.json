   },
   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Velóciter exáudi me, Dómine;"
       ],
       [
        "defécit spíritus meus."
       ],
       [
        "Audítam fac mihi mane misericórdiam tuam,"
       ],
       [
        "quia in te sperávi."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Ouvi-me, Senhor, sem demora, porque se apaga a minha vida. Fazei-me sentir desde a manhã a vossa bondade, porque em Vós confio."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Lord, make haste and give me answer: for my spirit fails within me. In the morning let me know your love for I put my trust in you."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Escúchame enseguida, Señor,"
       ],
       [
        "que me falta el aliento."
       ],
       [
        "En la mañana hazme escuchar tu gracia,"
       ],
       [
        "ya que confío en ti."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Rispondimi presto, Signore, viene meno il mio spirito."
       ],
       [
        "Non nascondermi il tuo volto,"
       ],
       [
        "perché non sia come chi scende nella fossa."
       ],
       [
        "Al mattino fammi sentire la tua grazia,"
       ],
       [
        "perché in te confido"
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Vite, réponds-moi, Seigneur :"
       ],
       [
        "je suis à bout de souffle !"
       ],
       [
        "Fais que j'entende au matin ton amour,"
       ],
       [
        "car je compte sur toi."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, erhöre mich bald,"
       ],
       [
        "denn mein Geist wird müde."
       ],
       [
        "Lass mich deine Huld erfahren am frühen Morgen;"
       ],
       [
        "denn ich vertraue auf dich."
       ]
      ]
     }
    ]
   },
   "role": "verse"
  },
