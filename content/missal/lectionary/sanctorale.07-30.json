  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Doce me, Dómine, iustificatiónes tuas."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Ó Senhor, ensinai-me os vossos mandamentos!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Lord, teach me your decrees."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Enséñame, Señor, tus decretos."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Insegnami, Signore, i tuoi decreti."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Apprends-moi, Seigneur, tes commandements."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Herr, lehre mich deine Gesetze!"
       ]
      ]
     }
    ]
   },
   "role": "people",
   "part": "psalm",
   "from": "common.doctors.psalm.3"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "In quo mundábit adulescéntior viam suam?"
       ],
       [
        "In custodiéndo sermónes tuos."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Como um jovem poderá ter vida pura? Observando, ó Senhor, vossa palavra."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "How shall the young remain sinless? By obeying your word."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "¿Cómo podrá un joven andar honestamente?"
       ],
       [
        "Cumpliendo tus palabras."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Come potrà un giovane tenere pura la sua via?"
       ],
       [
        "Osservando la tua parola."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Comment, jeune, garder pur son chemin ?"
       ],
       [
        "En observant ta parole."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Wie geht ein junger Mann seinen Pfad ohne Tadel?"
       ],
       [
        "Wenn er sich hält an dein Wort."
       ]
      ]
     }
    ]
   },
   "role": "verse",
   "part": "psalm",
   "from": "common.doctors.psalm.3"
  },
  {
   "text": {
