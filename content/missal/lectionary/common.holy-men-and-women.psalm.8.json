   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Beátus omnis qui timet Dóminum,"
       ],
       [
        "qui ámbulat in viis eius."
       ],
       [
        "Labóres mánuum tuárum manducábis,"
       ],
       [
        "beátus es, et bene tibi erit."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Feliz és tu se temes o Senhor e trilhas seus caminhos! Do trabalho de tuas mãos hás de viver, serás feliz, tudo irá bem."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "O blessed are those who fear the Lord and walk in his ways! By the labor of your hands you shall eat. You will be happy and prosper."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Dichoso el que teme al Señor"
       ],
       [
        "y sigue sus caminos."
       ],
       [
        "Comerás del fruto de tu trabajo,"
       ],
       [
        "serás dichoso, te irá bien."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Beato chi teme il Signore"
       ],
       [
        "e cammina nelle sue vie."
       ],
       [
        "Della fatica delle tue mani ti nutrirai,"
       ],
       [
        "sarai felice e avrai ogni bene."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Heureux qui craint le Seigneur"
       ],
       [
        "et marche selon ses voies !"
       ],
       [
        "Tu te nourriras du travail de tes mains :"
       ],
       [
        "Heureux es-tu ! À toi, le bonheur !"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Wohl dem Mann, der den Herrn fürchtet und ehrt"
       ],
       [
        "und der auf seinen Wegen geht!"
       ],
       [
        "Was deine Hände erwarben, kannst du genießen;"
       ],
       [
        "wohl dir, es wird dir gut ergehn."
       ]
      ]
     }
    ]
   },
   "role": "verse"
  },
