   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ierúsalem, quæ ædificáta est ut cívitas"
       ],
       [
        "sibi compácta in idípsum."
       ],
       [
        "Illuc enim ascendérunt tribus, tribus Dómini,"
       ],
       [
        "testimónium Israel, ad confiténdum nómini Dómini."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Jerusalém, cidade bem edificada num conjunto harmonioso; para lá sobem as tribos de Israel, as tribos do Senhor. Para louvar, segundo a lei de Israel, o nome do Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Jerusalem is built as a city strongly compact. It is there that the tribes go up, the tribes of the Lord. For Israel's law it is, there to praise the Lord's name."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Jerusalén está fundada"
       ],
       [
        "como ciudad bien compacta."
       ],
       [
        "Allá suben las tribus,"
       ],
       [
        "las tribus del Señor,"
       ],
       [
        "según la costumbre de Israel,"
       ],
       [
        "a celebrar el nombre del Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Gerusalemme è costruita"
       ],
       [
        "come città salda e compatta."
       ],
       [
        "Là salgono insieme le tribù,"
       ],
       [
        "le tribù del Signore."
       ],
       [
        "Salgono secondo la legge di Israele,"
       ],
       [
        "per lodare il nome del Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Jérusalem, te voici dans tes murs :"
       ],
       [
        "ville où tout ensemble ne fait qu'un !"
       ],
       [
        "C'est là que montent les tribus,"
       ],
       [
        "les tribus du Seigneur. *"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Jerusalem, du starke Stadt,"
       ],
       [
        "dicht gebaut und fest gefügt."
       ],
       [
        "Dorthin ziehen die Stämme hinauf, die Stämme des Herrn,"
       ],
       [
        "wie es Israel geboten ist,"
       ],
       [
        "den Namen des Herrn zu preisen."
       ],
       [
        "Denn dort stehen Throne bereit für das Gericht,"
       ],
       [
        "die Throne des Hauses David."
       ]
      ]
     }
    ]
   },
   "role": "verse"
  },
  {
   "text": {
    "de": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
