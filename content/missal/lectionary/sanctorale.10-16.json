  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ecce sic benedicétur homo,"
       ],
       [
        "qui timet Dóminum."
       ],
       [
        "Benedícat tibi Dóminus ex Sion,"
       ],
       [
        "et vídeas bona Ierúsalem"
       ],
       [
        "ómnibus diébus vitæ tuæ."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Será assim abençoado todo homem que teme o Senhor. O Senhor te abençoe de Sião, cada dia de tua vida."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Indeed thus shall be blessed the man who fears the Lord. May the Lord bless you from Zion in a happy Jerusalem all the days of your life."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Esta es la bendición del hombre que teme al Señor."
       ],
       [
        "Que el Señor te bendiga desde Sion,"
       ],
       [
        "que veas la prosperidad de Jerusalén"
       ],
       [
        "todos los días de tu vida."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ecco com'è benedetto"
       ],
       [
        "l'uomo che teme il Signore."
       ],
       [
        "Ti benedica il Signore da Sion."
       ],
       [
        "Possa tu vedere il bene di Gerusalemme"
       ],
       [
        "tutti i giorni della tua vita!"
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Voilà comment sera béni"
       ],
       [
        "l'homme qui craint le Seigneur. *"
       ],
       [
        "De Sion, que le Seigneur te bénisse !"
       ],
       [
        "Tu verras le bonheur de Jérusalem tous les jours de ta vie. *"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "So wird der Mann gesegnet,"
       ],
       [
        "der den Herrn fürchtet und ehrt."
       ],
       [
        "Es segne dich der Herr vom Zion her."
       ],
       [
        "Du sollst dein Leben lang das Glück Jerusalems schauen."
       ]
      ]
     }
    ]
   },
