  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Qui fecerit voluntatem Dei, hic frater meus et soror mea et mater est."
       ]
      ],
      "role": "summary"
     },
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "cross",
         "t": "✠"
        },
        " Léctio sancti Evangélii secúndum Marcum"
       ]
      ],
      "cite": "3, 31-35",
      "role": "announcement"
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Quem faz a vontade de Deus, esse é meu irmão, minha irmã e minha mãe"
       ]
      ],
      "role": "summary"
     },
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "cross",
         "t": "✠"
        },
        " Proclamação do Evangelho de Jesus Cristo segundo Marcos"
       ]
      ],
      "cite": "3, 31-35",
      "role": "announcement"
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "cross",
         "t": "✠"
        },
        " A reading from the holy Gospel according to Mark"
       ]
      ],
      "cite": "3:31-35",
      "role": "announcement"
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "El que haga la voluntad de Dios, ese es mi hermano y mi hermana y mi madre"
       ]
      ],
      "role": "summary"
     },
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "cross",
         "t": "✠"
        },
        " Lectura del santo Evangelio según san Marcos"
       ]
      ],
      "cite": "3, 31-35",
      "role": "announcement"
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Chi fa la volontà di Dio, costui per me è fratello, sorella e madre."
       ]
      ],
      "role": "summary"
     },
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "cross",
         "t": "✠"
        },
        " Dal Vangelo secondo Marco"
       ]
      ],
      "cite": "3, 31-35",
      "role": "announcement"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "cross",
         "t": "✠"
        },
        " Évangile de Jésus-Christ selon saint Marc"
       ]
      ],
      "cite": "3, 31-35",
      "role": "announcement"
     }
    ],
    "de": [
