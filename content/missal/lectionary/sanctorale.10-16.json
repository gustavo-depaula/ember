  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Uxor tua sicut vitis fructífera"
       ],
       [
        "in latéribus domus tuæ;"
       ],
       [
        "fílii tui sicut novéllæ olivárum"
       ],
       [
        "in circúitu mensæ tuæ."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "A tua esposa é uma videira bem fecunda no coração da tua casa; os teus filhos são rebentos de oliveira ao redor de tua mesa."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Your wife like a fruitful vine in the heart of your house; your children like shoots of the olive, around your table."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Tu mujer, como parra fecunda,"
       ],
       [
        "en medio de tu casa;"
       ],
       [
        "tus hijos, como renuevos de olivo,"
       ],
       [
        "alrededor de tu mesa."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "La tua sposa come vite feconda"
       ],
       [
        "nell'intimità della tua casa;"
       ],
       [
        "i tuoi figli come virgulti d'ulivo"
       ],
       [
        "intorno alla tua mensa."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Ta femme sera dans ta maison"
       ],
       [
        "comme une vigne généreuse, *"
       ],
       [
        "et tes fils, autour de la table,"
       ],
       [
        "comme des plants d'olivier."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Wie ein fruchtbarer Weinstock ist deine Frau"
       ],
       [
        "drinnen in deinem Haus."
       ],
       [
        "Wie junge Ölbäume sind deine Kinder"
       ],
       [
        "rings um deinen Tisch."
       ]
      ]
     }
    ]
   },
   "part": "psalm",
   "role": "verse"
  },
