   "from": "common.holy-men-and-women.psalm.9"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Vere pacátam et quiétam"
       ],
       [
        "feci ánimam meam,"
       ],
       [
        "sicut ablactátus in sinu matris suæ,"
       ],
       [
        "sicut ablactátus, ita in me est ánima mea."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Fiz calar e sossegar a minha alma; ela está em grande paz dentro de mim, como a criança bem tranquila, amamentada no regaço acolhedor de sua mãe."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Truly I have set my soul in silence and peace. A weaned child on its mother's breast, even so is my soul."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Sino que acallo y modero mis deseos,"
       ],
       [
        "como un niño en brazos de su madre;"
       ],
       [
        "como un niño saciado"
       ],
       [
        "así está mi alma dentro de mí."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Io invece resto quieto e sereno;"
