   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Diláta angústias cordis mei,"
       ],
       [
        "et de necessitátibus meis érue me."
       ],
       [
        "Vide humilitátem meam et labórem meum,"
       ],
       [
        "et dimítte univérsa delícta mea."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Livrai-me, Senhor, das minhas aflições, vede minha miséria e minha dor; perdoai todos os meus pecados."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Relieve the anguish of my heart and set me free from my distress. See my affliction and my toil and take all my sins away."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Ensancha mi corazón oprimido"
       ],
       [
        "y sácame de mis tribulaciones."
       ],
       [
        "Mira mis trabajos y mis penas"
       ],
       [
        "y perdona todos mis pecados."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Allèvia le angosce del mio cuore,"
       ],
       [
        "liberami dagli affanni."
       ],
       [
        "Vedi la mia miseria e la mia pena"
       ],
       [
        "e perdona tutti i miei peccati"
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "L'angoisse grandit dans mon cœur :"
       ],
       [
        "tire-moi de ma détresse."
       ],
       [
        "Vois ma misère et ma peine,"
       ],
       [
        "enlève tous mes péchés."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Befrei mein Herz von der Angst,"
       ],
       [
        "führe mich heraus der Bedrängnis!"
       ],
       [
        "Sieh meine Not und Plage an,"
       ],
       [
        "und vergib mir all meine Sünden!"
       ]
      ]
     }
    ]
   },
   "role": "verse"
