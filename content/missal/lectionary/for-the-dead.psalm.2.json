  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Ad te, Dómine, levávi ánimam meam."
       ],
       [
        {
         "m": "rubric",
         "t": "Vel: "
        },
        "Qui sústinent te, Dómine, non confundéntur."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "A vós, Senhor, eu elevo a minha alma."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "To you, O Lord, I lift up my soul."
       ],
       [
        {
         "m": "rubric",
         "t": "or"
        },
        " Those who hope in you, 0 Lord, shall not be disappointed."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "A ti, Señor, levanto mi alma."
       ],
       [
        {
         "m": "rubric",
         "t": "O bien: "
        },
        "Los que esperan en ti, Señor, no quedan defraudados."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "A te, Signore, innalzo l'anima mia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Vers toi, Seigneur, j'élève mon âme."
       ],
       [
        {
         "m": "rubric",
         "t": "ou: "
        },
        "Pour qui espère en toi, pas de honte, Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Zu dir, o Herr, erhebe ich meine Seele."
       ],
       [
        {
         "m": "rubric",
         "t": "Oder: "
        },
        "Wer auf dich hofft, wird nicht zuschanden."
       ]
      ]
     }
    ]
   },
   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Reminíscere miseratiónum tuárum, Dómine,"
       ],
       [
        "et misericordiárum tuárum, quóniam a sǽculo sunt."
       ],
       [
        "Secúndum misericórdiam tuam meménto mei tu,"
       ],
       [
        "propter bonitátem tuam, Dómine."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Recordai, Senhor meu Deus, vossa ternura"
       ],
       [
        "e a vossa compaixão que são eternas! De mim lembrai-vos, porque sois misericórdia"
       ],
       [
        "e sois bondade sem limites, ó Senhor!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Remember your mercy, Lord, and the love you have shown from of old. In your love remember me, because of your goodness, O Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Recuerda, Señor, que tu ternura"
       ],
       [
        "y tu misericordia son eternas;"
       ],
       [
        "acuérdate de mí con misericordia, por tu bondad, Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ricòrdati, Signore, del tuo amore,"
       ],
       [
        "della tua fedeltà che è da sempre."
       ],
       [
        "Ricòrdati di me nella tua misericordia,"
       ],
       [
        "per la tua bontà, Signore"
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Rappelle-toi, Seigneur, ta tendresse,"
       ],
       [
        "ton amour qui est de toujours."
       ],
       [
        "Dans ton amour, ne m'oublie pas,"
       ],
       [
        "en raison de ta bonté, Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Denk an dein Erbarmen, Herr,"
       ],
       [
        "und an die Taten deiner Huld;"
       ],
       [
        "denn sie bestehen seit Ewigkeit."
       ],
       [
        "Denk nicht an meine Jugendsünden und meine Frevel!"
       ],
       [
        "In deiner Huld denk an mich, Herr, denn du bist gütig."
       ]
      ]
     }
    ]
   },
   "role": "verse"
  },
