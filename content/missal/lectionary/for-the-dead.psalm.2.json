   },
   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Custódi ánimam meam, et érue me;"
       ],
       [
        "non erubéscam, quóniam sperávi in te."
       ],
       [
        "Innocéntia et ǽquitas custódiant me,"
       ],
       [
        "quia sustínui te."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Defendei a minha alma e livrai-me: não me envergonharei de ter confiado em Vós. A inocência e rectidão me protejam, porque em Vós pus a minha esperança."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Preserve my life and rescue me. Do not disappoint me, you are my refuge. May innocence and uprightness protect me: for my hope is in you, O Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Guarda mi vida y líbrame,"
       ],
       [
        "no quede yo defraudado de haber acudido a ti."
       ],
       [
        "La inocencia y la rectitud me protegerán,"
       ],
       [
        "porque espero en ti."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Proteggimi, dammi salvezza;"
       ],
       [
        "al tuo riparo io non sia deluso."
       ],
       [
        "Mi proteggano integrità e rettitudine,"
       ],
       [
        "perché in te ho sperato"
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Garde mon âme, délivre-moi ;"
       ],
       [
        "je m'abrite en toi : épargne-moi la honte."
       ],
       [
        "Droiture et perfection veillent sur moi,"
       ],
       [
        "sur moi qui t'espère !"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Erhalte mein Leben und rette mich,"
       ],
       [
        "lass mich nicht scheitern!"
       ],
       [
        "Denn ich nehme zu dir meine Zuflucht."
       ],
       [
        "Unschuld und Redlichkeit mögen mich schützen,"
       ],
       [
        "denn ich hoffe auf dich, o Herr."
       ]
      ]
     }
    ]
   },
   "role": "verse"
