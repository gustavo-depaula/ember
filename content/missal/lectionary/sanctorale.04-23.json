   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Eúntes ibant et flebant,"
       ],
       [
        "semen spargéndum portántes;"
       ],
       [
        "veniéntes autem vénient in exsultatióne"
       ],
       [
        "portántes manípulos suos."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Chorando de tristeza sairão, espalhando suas sementes; cantando de alegria voltarão, carregando os seus feixes!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "They go out, they go our, full of tears, carrying seed for the sowing: they come back, they come back, full of song, carrying their sheaves."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Al ir, iba llorando,"
       ],
       [
        "llevando la semilla;"
       ],
       [
        "al volver, vuelve cantando,"
       ],
       [
        "trayendo sus gavillas."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Nell'andare, se ne va piangendo,"
       ],
       [
        "portando la semente da gettare,"
       ],
       [
        "ma nel tornare, viene con gioia,"
       ],
       [
        "portando i suoi covoni."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Il s'en va, il s'en va en pleurant,"
       ],
       [
        "il jette la semence ;"
       ],
       [
        "il s'en vient, il s'en vient dans la joie,"
       ],
       [
        "il rapporte les gerbes."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Sie gehen hin unter Tränen"
       ],
       [
        "und tragen den Samen zur Aussaat."
       ],
       [
        "Sie kommen wieder mit Jubel"
       ],
       [
        "und bringen ihre Garben ein."
       ]
      ]
     }
    ]
