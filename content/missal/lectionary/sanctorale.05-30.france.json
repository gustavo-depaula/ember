   "part": "psalm",
   "role": "people"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Si des méchants s’avancent contre moi"
       ],
       [
        "pour me déchirer, +"
       ],
       [
        "ce sont eux, mes ennemis, mes adversaires, *"
       ],
       [
        "qui perdent pied et succombent."
       ]
      ]
