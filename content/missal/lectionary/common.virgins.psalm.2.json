  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Iúvenes et vírgines, láudate nomen Dómini."
       ],
       [
        {
         "m": "rubric",
         "t": "vel: "
        },
        "Allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Vós jovens, vós moças e rapazes, louvai todos o nome do Senhor!"
       ],
       [
        {
         "m": "rubric",
         "t": "Ou: "
        },
        "Aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Young men and women, praise the name of the Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Jóvenes y doncellas, alabad el nombre del Señor."
       ],
       [
        {
         "m": "rubric",
         "t": "O bien: "
        },
        "Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Giovani e ragazze lodate il nome del Signore."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure: "
        }
       ],
       [
        "Alleluia, alleluia, alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Jeunes gens et jeunes filles, louez le nom du Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "R/. "
        },
        "Ihr jungen Männer und auch ihr Mädchen, lobt den Namen des Herrn!"
       ],
       [
        {
         "m": "rubric",
         "t": "Oder: "
        },
        "Halleluja."
       ]
      ]
     }
    ]
   },
   "role": "people"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Laudáte Dóminum de cælis,"
       ],
       [
        "laudáte eum, in excélsis."
       ],
       [
        "Laudáte eum, omnes ángeli eius,"
       ],
       [
        "laudáte eum, omnes virtútes eius."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Louvai o Senhor Deus nos altos céus, louvai-o no excelso firmamento! Louvai-o, anjos seus, todos louvai-o, louvai-o, legiões celestiais!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Praise the Lord from the heavens, praise him in the heights. Praise him, all his angels, praise him all his host."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Alabad al Señor en el cielo,"
       ],
       [
        "alabad al Señor en lo alto."
       ],
       [
        "Alabadlo todos sus ángeles;"
       ],
       [
        "alabadlo todos sus ejércitos."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Lodate il Signore dai cieli,"
       ],
       [
        "lodatelo nell'alto dei cieli."
       ],
       [
        "Lodatelo, voi tutti, suoi angeli,"
       ],
       [
        "lodatelo, voi tutte, sue schiere."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Louez le Seigneur du haut des cieux,"
       ],
       [
        "louez-le dans les hauteurs."
       ],
       [
        "Vous, tous ses anges, louez-le,"
       ],
       [
        "louez-le, tous les univers."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Lobet den Herrn vom Himmel her,"
       ],
       [
        "lobt ihn in den Höhen!"
       ],
       [
        "Lobt ihn, all seine Engel,"
       ],
       [
        "lobt ihn, all seine Scharen!"
       ]
      ]
     }
    ]
   },
   "role": "verse"
  },
