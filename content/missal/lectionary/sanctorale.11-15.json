      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Blessed are you, O Lord; teach me your statutes."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Bendito eres, Señor,"
       ],
       [
        "enséñame tus decretos."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Benedetto sei tu, Signore:"
       ],
       [
        "insegnami i tuoi decreti."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Toi, Seigneur, tu es béni :"
       ],
       [
        "apprends-moi tes commandements."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Gepriesen seist du, Herr."
       ],
