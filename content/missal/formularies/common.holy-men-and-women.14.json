   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Divíni operátio sacraménti, omnípotens Deus, in hac festivitáte beátæ ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "illúminet nos páriter et inflámmet, ut et sanctis iúgiter desidériis ferveámus, et bonis opéribus abundémus. Per Christum."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "May the working of this divine Sacrament enlighten and inflame us, almighty God, on this feast day of blessed ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", that we may be ever fervent with holy desires and abound in good works."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Dios todopoderoso,"
       ],
       [
        "la eficacia divina de este sacramento"
       ],
       [
        "nos ilumine e inflame"
       ],
       [
        "en esta fiesta de santa ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "para que ardamos siempre en santos deseos"
       ],
       [
        "y abundemos en obras buenas."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "L'azione del tuo sacramento, Dio onnipotente, in questa memoria di santa ",
        {
         "m": "rubric",
         "t": "N. "
        },
        " ci illumini e ci infiammi, perché, ardenti di santi desideri, portiamo frutti abbondanti di opere buone. Per Cristo nostro Signore.."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Dieu tout-puissant,"
       ],
       [
        "que l'action du sacrement divin"
       ],
       [
        "nous apporte lumière et ferveur"
       ],
       [
        "en cette fête de sainte ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "pour que nous brûlions toujours du désir de la sainteté"
       ],
       [
        "et fassions en abondance toute sorte de bien."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Allmächtiger Gott, das Brot des Lebens, das wir empfangen haben, schenke uns am Gedenktag der heiligen ",
        {
         "m": "rubric",
         "t": "N. ("
        },
        "und ",
        {
         "m": "rubric",
         "t": "N.)"
        },
        " Licht und Kraft, damit wir nach dem streben, was dir gefällt, und reich werden an guten Werken. Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
