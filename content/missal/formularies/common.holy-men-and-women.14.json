    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Ou bien, pour plusieurs saintes : "
        }
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Oder, für mehrere heilige Frauen:"
        }
       ]
      ]
