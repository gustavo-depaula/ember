  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Hóstias tibi, Dómine, pro beátæ ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "commemoratióne deférimus, supplíciter deprecántes, ut indulgéntiam nobis páriter cónferant et salútem. Per Christum."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "We bring you these sacrificial gifts, O Lord, to commemorate blessed ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", humbly entreating that they may bestow on us both pardon and salvation."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Te presentamos, Señor, estas ofrendas"
       ],
       [
        "en la memoria de santa ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "rogándote, humildemente,"
       ],
       [
        "que nos alcancen el perdón y la salud eterna."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Le offerte che ti presentiamo, o Signore, nella memoria di santa ",
        {
         "m": "rubric",
         "t": "N."
        },
        " ci ottengano il perdono e la salvezza. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Nous te présentons, Seigneur, ce sacrifice"
       ],
       [
        "en mémoire de sainte ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "et nous te supplions humblement :"
       ],
       [
        "qu'avec ton pardon,"
