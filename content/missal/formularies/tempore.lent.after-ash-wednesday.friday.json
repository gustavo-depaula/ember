  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Vias tuas, Dómine, demónstra nobis,"
       ],
       [
        "et sémitas tuas édoce nos."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Mostrai-me, Senhor, vossos caminhos,"
       ],
       [
        "e fazei-me conhecer a vossa estrada."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "O Lord, make me know your ways,"
       ],
       [
        "teach me your paths."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Señor, enséñanos tus caminos, instrúyenos en tus sendas."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Fammi conoscere, o Signore, le tue vie, insegnami i tuoi sentieri."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        },
        "Possono forse gli invitati a nozze essere in lutto finché lo sposo è con loro?"
       ]
      ],
      "cite": "Mt 9, 15"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Seigneur, enseigne-moi tes chemins,"
       ],
       [
        "fais-moi connaître ta route."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Zeige mir, Herr, deine Wege, lehre mich deine Pfade!"
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
