  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Audívit Dóminus, et misértus est mihi, Dóminus factus est adiútor meus."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Escutai-me, Senhor Deus, tende piedade!"
       ],
       [
        "Sede, Senhor, meu abrigo protetor!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "The Lord heard and had mercy on me; the Lord became my helper."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Escucha, Señor, y ten piedad de mí; Señor, socórreme."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Il Signore mi ha ascoltato, ha avuto pietà di me. Il Signore è venuto in mio aiuto."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Le Seigneur m'a entendu, il m'a pris en pitié."
       ],
       [
        "Le Seigneur est venu à mon aide."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Höre mich, Herr, und sei mir gnädig!"
       ],
       [
        "Herr, sei du mein Helfer!"
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
