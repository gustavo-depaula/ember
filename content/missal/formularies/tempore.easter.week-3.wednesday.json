    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Surréxit Dóminus et illúxit nobis,"
       ],
       [
        "quos redémit sánguine suo, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Ressurgiu o Senhor e nos iluminou,"
       ],
       [
        "a nós que remiu com seu sangue, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "The Lord has risen and shone his light upon us, whom he has redeemed by his Blood, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Ha resucitado el Señor e ilumina a los que hemos sido redimidos con su sangre. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Il Signore è risorto e ha fatto splendere su di noi la sua luce: egli ci ha redenti con il suo sangue. Alleluia."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "Chiunque vede il Figlio e crede in lui ha la vita eterna. Alleluia."
       ]
      ],
      "cite": "Cf. Gv 6, 40"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Le Seigneur est ressuscité,"
       ],
       [
        "il nous a rachetés par son sang,"
       ],
       [
        "et nous remplit de sa lumière, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Der Herr ist auferstanden, er hat uns erlöst durch sein Blut. Er ist unser Licht und Heil. Halleluja."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
