  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Repleátur os meum laude tua, ut possim cantáre;"
       ],
       [
        "gaudébunt lábia mea, dum cantávero tibi, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Vosso louvor é transbordante em minha boca,"
       ],
       [
        "a alegria cantará sobre meus lábios, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Let my mouth be filled with your praise, that I may sing aloud; my lips shall shout for joy, when I sing to you, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Llena estaba mi boca de tu alabanza para poder cantar. Te aclamarán mis labios, Señor. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Della tua lode è piena la mia bocca: tutto il giorno canto il tuo splendore; cantando le tue lodi esulteranno le mie labbra. Alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Que ma bouche soit remplie de ta louange,"
       ],
       [
        "pour que je puisse chanter ;"
       ],
       [
        "joie sur mes lèvres qui chantent pour toi, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Mein Mund ist erfüllt von deinem Lob, von deinem Ruhm den ganzen Tag, meine Lippen sollen jubeln, denn dir will ich singen und spielen. Halleluja."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
