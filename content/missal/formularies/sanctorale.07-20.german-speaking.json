        {
         "m": "rubric",
         "t": "Commune-Texte für Märtyrer:"
        },
        " ",
        {
         "m": "link",
         "t": "vm",
         "to": "common.martyrs.13"
        },
        " ",
        {
         "m": "rubric",
         "t": ", oder für Jungfrauen:"
        },
        " ",
