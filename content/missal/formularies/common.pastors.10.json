  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Isti sunt viri sancti facti amíci Dei, divínæ veritátis præcónio gloriósi ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "allelúia",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Estes são homens santos, que se tornaram amigos de Deus, gloriosos mensageiros da verdade divina ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "aleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "O chosen people, proclaim the mighty works of him who called you out of darkness into his wonderful light ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Estos son los varones santos, amigos de Dios, insignes en la predicación de la verdad divina ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ecco gli uomini santi che sono divenuti amici di Dio, annuncio gioioso della verità divina",
        {
         "m": "rubric",
         "t": "( T. P."
        },
        "Alleluia ",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Voici les saints ",
        {
         "m": "rubric",
         "t": "N."
        },
        " et ",
        {
         "m": "rubric",
         "t": "N."
        },
        " :"
       ],
       [
        "ils sont les amis de Dieu,"
       ],
       [
        "dont la gloire fut de proclamer"
       ],
       [
        "la vérité reçue du Seigneur ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "alléluia",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Diese Männer sind Freunde Gottes geworden, Künder der göttlichen Wahrheit."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
