  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ego pascam oves meas, et ego eas accubáre fáciam, dicit Dóminus ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "allelúia",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Eu mesmo vou apascentar as minhas ovelhas e fazê-las repousar, diz o Senhor ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "aleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "I will pasture my sheep; I myself will give them rest, says the Lord ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Yo mismo apacentaré mis ovejas y las haré reposar, dice el Señor ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "«Io stesso condurrò le mie pecore al pascolo e le farò riposare», dice il Signore ",
        {
         "m": "rubric",
         "t": "( T. P."
        },
        "Alleluia ",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "C'est moi qui ferai paître mon troupeau,"
       ],
       [
        "et c'est moi qui le ferai reposer, dit le Seigneur ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "alléluia",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Ich werde meine Schafe auf die Weide führen, und ich werde sie ruhen lassen - so spricht Gott der Herr."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
