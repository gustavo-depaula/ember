  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Confitébor tibi in pópulis, Dómine, et narrábo nomen tuum frátribus mei ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "allelúia",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Eu vos louvarei, Senhor, entre os povos, e anunciarei vosso nome aos meus irmãos ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "aleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "I will praise you, Lord, among the nations; I will tell of your name to my kin ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Te daré gracias entre las naciones, Señor; contaré tu fama a mis hermanos ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ti loderò, Signore, tra le genti, e annuncerò il tuo nome ai miei fratelli (T.P. Alleluia). ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Je te rendrai grâce parmi les peuples, Seigneur ;"
       ],
       [
        "je proclamerai ton nom devant mes frères ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "alléluia",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
