  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Audíte verbum Dómini, gentes, et annuntiáte illud in fínibus terræ: Ecce Salvátor noster advéniet, et iam nolíte timére."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Ó nações, escutai a palavra do Senhor"
       ],
       [
        "e levai-a até os confins da terra:"
       ],
       [
        "Eis que chega o nosso Salvador, não tenhais medo!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Hear the word of the Lord, O nations;"
       ],
       [
        "declare it to the distant lands:"
       ],
       [
        "Behold, our Savior will come; you need no longer fear."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Escuchad, pueblos, la palabra del Señor; anunciadla en los confines de la tierra: he aquí nuestro Salvador que viene, no temáis."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ascoltate, genti, la parola del Signore, annunciatela alle isole più lontane: Coraggio, non temete! Ecco, giunge il vostro Dio."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Écoutez, nations, la parole du Seigneur !"
       ],
       [
        "Annoncez-la jusqu'aux extrémités de la terre :"
       ],
       [
        "« Voici notre Sauveur qui vient, ne craignez plus. »"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Ihr Völker, hört das Wort des Herrn und verkündet es in aller Welt. Seht, euer Gott wird kommen und euch erretten, fürchtet euch nicht."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
