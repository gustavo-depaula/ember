   "part": "communionAntiphon"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Veni, Dómine, visitáre nos in pace, ut lætémur coram te corde perfécto."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Vinde, Senhor, visitai-nos na paz,"
       ],
       [
        "para que nos alegremos de todo o coração na vossa presença."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Come, O Lord, visit us in peace,"
       ],
       [
        "that we may rejoice before you with a blameless heart."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Ven, Señor, a visitarnos con tu paz para que nos alegremos delante de ti con un corazón íntegro."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Vieni, o Signore, a visitarci nella pace, perché possiamo gioire davanti a te con cuore integro."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure"
        }
       ],
       [
        "Molti verranno dall'oriente e dall'occidente e siederanno a mensa con Abramo, Isacco e Giacobbe nel regno dei cieli."
       ]
      ],
      "cite": "Mt 8, 11"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Viens, Seigneur, nous visiter dans la paix,"
       ],
       [
        "afin que, de tout cœur, nous nous réjouissions devant toi."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Komm, Herr, such uns heim mit deinem Erbarmen; dann wird unsere Freude vollendet sein."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
