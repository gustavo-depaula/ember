      "lines": [
       [
        "..."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Vossos lábios espalham a graça, o encanto,"
       ],
       [
        "porque Deus para sempre vos deu sua bênção!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Graciousness is poured out upon your lips, for God has blessed you for ever more."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "En tus labios se derrama la gracia: el Señor te bendice eternamente."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Sulle tue labbra è diffusa la grazia: ti ha benedetto Dio per sempre."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "La grâce est répandue sur tes lèvres :"
       ],
       [
        "oui, Dieu te bénit pour toujours."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
