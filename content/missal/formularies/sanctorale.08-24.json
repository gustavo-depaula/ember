  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Annuntiáte de die in diem salutáre Dei, annuntiáte inter gentes glóriam eius."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Proclamai todos os dias a salvação de Deus,"
       ],
       [
        "anunciai entre as nações a glória do Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Proclaim the salvation of God day by day; tell among the nations his glory."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Proclamad día tras día la victoria de Dios, contad a los pueblos su gloria."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Annunciate di giorno in giorno la salvezza del Signore, in mezzo alle genti narrate la sua gloria."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "De jour en jour, annoncez le salut de Dieu,"
       ],
       [
        "annoncez parmi les nations sa gloire."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Verkündet Gottes Heil von Tag zu Tag! Erzählt bei den Völkern von seiner Herrlichkeit!"
       ]
      ]
     }
    ]
   },
