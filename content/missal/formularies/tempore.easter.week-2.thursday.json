  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ecce ego vobíscum sum ómnibus diébus,"
       ],
       [
        "usque ad consummatiónem sǽculi, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Eis que estarei convosco todos os dias"
       ],
       [
        "até o fim do mundo, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Behold, I am with you always, even to the end of the age, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Sabed que yo estoy con vosotros todos los días, hasta el final de los tiempos. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ecco, io sono con voi tutti i giorni, sino alla fine del mondo. Alleluia."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "Colui che Dio ha mandato annuncia le parole di Dio e dona lo Spirito senza misura. Alleluia."
       ]
      ],
      "cite": "Cf. Gv 3, 34"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Je suis avec vous tous les jours,"
       ],
       [
        "jusqu'à la fin du monde, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Ich bin bei euch alle Tage bis zum Ende der Welt. Halleluja."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
