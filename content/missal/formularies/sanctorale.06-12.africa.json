   "part": "collect"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Father, who filled Saint Onophrius with the fire of your love"
       ],
       [
        "and gave him the privilege of serving you"
       ],
       [
        "through a life of contemplation and penance;"
       ],
       [
        "inspired by his example and helped by his prayer"
       ],
       [
        "may we learn to love you above all things"
       ],
       [
        "and devote ourselves to your service."
       ],
       [
        "Through our Lord Jesus Christ, your Son,"
       ],
       [
        "who lives and reigns with you in the unity of the Holy Spirit,"
       ],
       [
        "one God, for ever and ever."
       ]
      ]
     }
    ]
   },
   "part": "collect"
  },
