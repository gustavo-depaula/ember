       ]
      ]
     }
    ]
   },
   "part": "prayerOverOfferings"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Supplicátio tibi nostra, Dómine, et grata páriter exsístat oblátio, ut fámulo tuo ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", pro cuius salúte defértur, plenitúdinem tuæ redemptiónis acquírat. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Possam agradar-vos, Senhor, nossa oração e nossa oferenda apresentadas pela salvação do vosso servo ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", para que alcance a plenitude da vossa redenção. Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "May both our prayer and our offering be pleasing to you, O Lord,"
       ],
       [
        "that your servant ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "for whose salvation they are offered, may gain through them"
       ],
       [
        "the fullness of your redemption Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Que te sean gratas, Señor,"
       ],
       [
        "nuestra súplica y nuestra ofrenda,"
       ],
       [
        "para que tu siervo ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "por cuya salvación las hemos ofrecido,"
       ],
       [
        "alcance la plenitud de tu redención."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ti siano gradite, o Signore, le preghiere e le offerte che ti presentiamo per il nostro fratello ",
        {
         "m": "rubric",
         "t": "["
        },
        "la nostra sorella",
        {
         "m": "rubric",
         "t": "] N."
        },
        ", perché ottengano a lui ",
        {
         "m": "rubric",
         "t": "["
        },
        "lei",
        {
         "m": "rubric",
         "t": "]"
        },
        " la pienezza della tua redenzione. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Que notre supplication et notre offrande"
       ],
       [
        "te soient l'une et l'autre agréables, Seigneur ;"
       ],
       [
        "nous te les présentons pour le salut de ton serviteur ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "afin qu'il obtienne ta rédemption en plénitude."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr und Gott, nimm die Gebete und Gaben, die wir für das Heil deines Dieners ",
        {
         "m": "rubric",
         "t": "("
        },
        "deiner Dienerin",
        {
         "m": "rubric",
         "t": ") N."
        },
        " darbringen, gnädig an. Schenke ihm ",
        {
         "m": "rubric",
         "t": "("
        },
        "ihr",
        {
         "m": "rubric",
         "t": ")"
        },
        " die volle Erlösung und die ewige Freude. Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
   },
   "part": "prayerOverOfferings"
  },
  {
