       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Præsta, quǽsumus, omnípotens Deus, ut ánima fámuli tui ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", pro qua hoc sacrifícium tuæ obtúlimus maiestáti, per huius virtútem sacraménti a peccátis ómnibus expiáta, lucis perpétuæ, te miseránte, recípiat beatitúdinem. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Deus onipotente, tendo oferecido este sacrifício, nós vos pedimos em favor do vosso servo ",
        {
         "m": "rubric",
         "t": "N."
        },
        " para que, liberto de todos os pecados pela força deste sacramento, receba, por vossa misericórdia, a felicidade da luz perpétua. Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Grant, we pray, almighty God,"
       ],
       [
        "that the soul of your servant ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "for whom we have offered"
       ],
       [
        "this sacrifice to your majesty,"
       ],
       [
        "may by the power of this sacrament be cleansed of all sins"
       ],
       [
        "and receive from your mercy"
       ],
       [
        "the happiness of perpetual light."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Dios todopoderoso,"
       ],
       [
        "te pedimos que el alma tu siervo ",
        {
         "m": "rubric",
