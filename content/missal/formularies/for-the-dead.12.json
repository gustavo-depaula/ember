   "part": "collect"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Deus indulgentiárum, da ánimæ fámuli tui ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", cuius córporis anniversárium depositiónis diem celebrámus, refrigérii sedem, quiétis beatitúdinem et lúminis claritátem. Per Dóminum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Ó Deus de perdão, celebrando o aniversário da morte do vosso servo ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", concedei-lhe a tranquilidade da paz, a felicidade do descanso e o esplendor da luz. Por nosso Senhor Jesus Cristo, vosso Filho, que é Deus, e convosco vive e reina, na unidade do Espírito Santo, por todos os séculos dos séculos."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "O God of all forgiveness,"
       ],
       [
        "grant to the soul of your servant ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "whose anniversary we celebrate,"
       ],
       [
        "a place of refreshment, of blessed rest and resplendent light. Through our lord Jesus Christ, your son,"
       ],
       [
        "who lives and reigns with you in the unity of the Holy Spirit,"
       ],
       [
        "one God, for ever and ever."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Dios de perdón,"
       ],
       [
        "al celebrar el aniversario d"
       ],
       [
        "e la sepultura de tu siervo ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "concede a su alma"
       ],
       [
        "sentarse en tu banquete,"
       ],
       [
        "la felicidad del descanso"
       ],
       [
        "y la claridad de la luz."
       ],
       [
        "Por nuestro Señor Jesucristo."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Dio del perdono, concedi all'anima del nostro fratello ",
        {
         "m": "rubric",
         "t": "["
        },
        "alla nostra sorella",
        {
         "m": "rubric",
         "t": "] N."
        },
        ", che ricordiamo nell'anniversario della morte ",
        {
         "m": "rubric",
         "t": "["
        },
        "sepoltura",
        {
         "m": "rubric",
         "t": "]"
        },
        ", il riposo eterno, la beata pace e lo splendore della tua luce. Per il nostro Signore Gesù Cristo, tuo Figlio, che è Dio, e vive e regna con te, nell'unità dello Spirito Santo, per tutti i secoli dei secoli."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "En cet anniversaire de la mort de ton serviteur ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "nous venons vers toi, Dieu qui aimes pardonner :"
       ],
       [
        "accorde à son âme le lieu du réconfort,"
       ],
       [
        "le bonheur dans le repos"
       ],
       [
        "et la clarté de ta lumière."
       ],
       [
        "Par Jésus Christ, ton Fils, notre Seigneur,"
       ],
       [
        "qui vit et règne avec toi dans l'unité du Saint-Esprit,"
       ],
       [
        "Dieu, pour les siècles des siècles."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Gott, du bist reich an Erbarmen für alle, die zu dir kommen. Schenke deinem Diener ",
        {
         "m": "rubric",
         "t": "("
        },
        "deiner Dienerin",
        {
         "m": "rubric",
         "t": ") N."
        },
        ", dessen ",
        {
         "m": "rubric",
         "t": "("
        },
        "deren",
        {
         "m": "rubric",
         "t": ")"
        },
        " Todestag wir begehen, seligen Frieden, ewige Ruhe und den Glanz deines Lichtes. Darum bitten wir durch Jesus Christus."
       ]
      ]
     }
    ]
   },
   "part": "collect"
  },
  {
