       [
        {
         "m": "rubric",
         "t": "Ou pour une fondatrice :"
        }
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Oder (für eine heilige Gründerin):"
        }
       ]
