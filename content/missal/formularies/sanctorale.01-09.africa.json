{"id":"sanctorale.01-09.africa","source":"santos/santos_africa#0109","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of Africa]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["January 9"],["Saint Adrian of Canterbury, Abbot"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"From the Common of Pastors: For Missionaries or from the Common of"}," ",{"m":"rubric","t":"Holy Men and Women: For an Abbot"}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["O Father of mercy,"],["who called Saint Adrian to follow the Lord"],["as a monk and a missionary;"],["grant, we beseech you,"],["that we may be filled with the same faith and zeal,"],["and walk always as children of the light."],["Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"slot":"1","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"2","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis virginibus et religiosis "},{"m":"link","t":"... In Sanctis enim, qui Christo se dedicavérunt...","to":"preface.57"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"SANTAS VIRGENS E RELIGIOSOS "},{"m":"link","t":"... Neles, chamais novamente os fiéis...","to":"preface.57"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY VIRGINS AND RELIGIOUS "},{"m":"link","t":"... For in the Saints who consecrated themselves...","to":"preface.57"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santas Vírgenes y Religiosos "},{"m":"link","t":"...Porque celebramos tu providencia admirable...","to":"preface.57"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DELLE SANTE VERGINI E DEI SANTI RELIGIOSI "},{"m":"link","t":"... Nei tuoi santi, che per il regno...","to":"preface.57"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis virginibus et religiosis "},{"m":"link","t":"... Nous célébrons les prévenances de ton amour...","to":"preface.57"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN JUNGFRAUEN UND ORDENSLEUTEN "},{"m":"link","t":"... Inmitten der Kirche berufst du Menschen...","to":"preface.57"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.57"],"title":{"*":"Saint Adrian of Canterbury, Abbot"}}
