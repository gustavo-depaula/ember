  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Veníte, adorémus Deum, et procidámus ante Dóminum, qui fecit nos; quia ipse est Dóminus Deus noster."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Vinde, adoremos e prostremo-nos por terra,"
       ],
       [
        "e ajoelhemo-nos ante o Deus que nos criou!"
       ],
       [
        "Porque ele é o nosso Deus, nosso Pastor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "O come, let us worship God"
       ],
       [
        "and bow low before the God who made us, for he is the Lord our God."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Entrad, postrémonos por tierra, bendiciendo al Señor, creador nuestro. Porque él es nuestro Dios."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Venite: prostrati adoriamo, in ginocchio davanti al Signore che ci ha fatti. È lui il Signore, nostro Dio."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Venez, adorons Dieu,"
       ],
       [
        "prosternons-nous devant le Seigneur qui nous a faits,"
       ],
       [
        "car il est notre Dieu."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Kommt, lasst uns niederfallen, uns verneigen vor dem Herrn, unserem Schöpfer! Denn er ist unser Gott."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
