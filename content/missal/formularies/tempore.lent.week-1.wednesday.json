   "part": "communionAntiphon"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Læténtur omnes qui sperant in te, Dómine, in ætérnum exsultábunt et habitábis in eis."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Hão de alegrar-se os que em vós esperam, Senhor,"
       ],
       [
        "exultarão eternamente e neles habitareis."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "All who take refuge in you shall be glad, O Lord,"
       ],
       [
        "and ever cry out their joy, and you shall dwell among them."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Que se alegren todos los que esperan en ti, Señor: gozarán eternamente y habitarás en ellos."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Gioiscano quanti in te si rifugiano, o Signore: esultino senza fine perché tu sei con loro."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "Come Giona fu un segno per quelli di Ninive, così il Figlio dell'uomo lo sarà per questa generazione."
       ]
      ],
      "cite": "Lc 11, 30"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Allégresse pour tous ceux qui espèrent en toi, Seigneur :"
       ],
       [
        "ils exulteront dans l'éternité"
       ],
       [
        "et tu habiteras parmi eux !"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, alle, die dir vertrauen, sollen sich freuen und sollen immerfort jubeln, denn du bist mit ihnen."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
