{"id":"sanctorale.04-20.africa","source":"santos/santos_africa#0420","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of Africa]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["April 20"],["Saint Marcellinus, Bishop"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"From the Common of Pastors: For a Bishop"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["O God, our Father,"],["who desire all peoples of the world"],["to recognise Jesus as the one you sent to save us;"],["look with kindness o us,"],["as we celebrate the memorial of Saint Marcellinus,"],["and fill us with the same missionary zeal and spirit."],["Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"slot":"13","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"14","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis pastoribus "},{"m":"link","t":"... Quia sic tríbuis Ecclésiam tuam sancti...","to":"preface.56"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Pastores "},{"m":"link","t":"... Vós nos concedeis a alegria...","to":"preface.56"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY PASTORS "},{"m":"link","t":"... For, as on the festival of Saint...","to":"preface.56"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Pastores "},{"m":"link","t":"... Porque nos concedes la alegría...","to":"preface.56"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI SANTI PASTORI "},{"m":"link","t":"... Tu doni alla tua Chiesa...","to":"preface.56"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis pastoribus "},{"m":"link","t":"... Tu donnes à ton Église de se réjouir..","to":"preface.56"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HIRTEN DER KIRCHE "},{"m":"link","t":"... am Fest des heiligen N. deine Größe...","to":"preface.56"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.56"],"title":{"*":"Saint Marcellinus, Bishop"}}
