   "part": "prayerOverOfferings"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Hóstias, quǽsumus, Dómine,"
       ],
       [
        "propítius inténde,"
       ],
       [
        "quas sacris altáribus exhibémus,"
       ],
       [
        "ut, nobis indulgéntiam largiéndo,"
       ],
       [
        "tuo nómini dent honórem."
       ],
       [
        "Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, olhai com bondade"
       ],
       [
        "as oferendas que colocamos neste altar,"
       ],
       [
        "para que, alcançando-nos vossa misericórdia,"
       ],
       [
        "glorifiquem o vosso nome."
       ],
       [
        "Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Regard with favor, O Lord, we pray,"
       ],
       [
        "the offerings we set upon this sacred altar, that, bestowing on us your pardon,"
       ],
       [
        "our oblations may give honor to your name."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Mira, Señor, propicio las ofrendas que presentamos en tu altar, para que nos obtengan el perdón y proclamen la gloria de tu nombre."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Accogli con bontà, o Signore, l'offerta che presentiamo sul tuo santo altare, perché ottenga a noi il perdono e renda onore al tuo nome. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Regarde avec bonté,"
       ],
       [
        "Seigneur, nous t'en prions,"
       ],
       [
        "les offrandes que nous déposons sur l'autel qui t'est consacré ;"
       ],
       [
        "en nous procurant ton pardon,"
       ],
       [
        "qu'elles servent à la gloire de ton nom."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, schau gnädig auf die Gaben, die wir auf den Altar legen."
       ],
       [
        "Das heilige Opfer bringe deinem Namen Ehre und tilge unsere Sünden."
       ],
       [
        "Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
   },
   "part": "prayerOverOfferings"
  },
