  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Dívites eguérunt et esuriérunt; quæréntes autem Dóminum non minuéntur omni bono."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Os ricos empobrecem e passam fome,"
       ],
       [
        "mas nada falta aos que procuram o Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "The rich suffer want and go hungry,"
       ],
       [
        "but those who seek the Lord lack no blessing."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Los ricos empobrecen y pasan hambre, los que buscan al Señor no carecen de nada."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "I leoni sono miseri e affamati; a chi cerca il Signore non manca alcun bene."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Des riches ont tout perdu, ils ont faim ;"
       ],
       [
        "qui cherche le Seigneur ne manquera d'aucun bien."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Reiche müssen darben und hungern. Wer aber den Herrn sucht, braucht kein Gut zu entbehren."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
