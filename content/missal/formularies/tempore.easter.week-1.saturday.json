  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Edúxit Dóminus pópulum suum in exsultatióne,"
       ],
       [
        "et eléctos suos in lætítia, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "O Senhor fez sair com grande júbilo o seu povo,"
       ],
       [
        "e seus eleitos entre gritos de alegria, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "The Lord brought out his people with joy,"
       ],
       [
        "his chosen ones with shouts of rejoicing, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "El Señor sacó a su pueblo con alegría, a sus escogidos con gritos de triunfo."
       ],
       [
        "Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Il Signore ha liberato il suo popolo con esultanza, i suoi eletti con canti di gioia. Alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Le Seigneur a fait sortir en grande fête son peuple,"
       ],
       [
        "ses élus, avec des cris de joie, alléluia !"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Der Herr führte sein Volk heraus in Freude, seine Erwählten in Jubel. Halleluja."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
