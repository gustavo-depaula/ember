  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Omnes, qui in Christo baptizáti estis,"
       ],
       [
        "Christum induístis, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Vós todos que fostes batizados em Cristo"
       ],
       [
        "vos revestistes de Cristo, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "All of you who have been baptized in Christ have put on Christ, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Cuantos habéis sido bautizados en Cristo os habéis revestido de Cristo."
       ],
       [
        "Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Quanti siete stati battezzati in Cristo vi siete rivestiti di Cristo. Alleluia."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "Andate in tutto il mondo e proclamate il Vangelo a ogni creatura. Alleluia."
       ]
      ],
      "cite": "Mc 16, 15"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Vous tous que le baptême a unis au Christ,"
       ],
       [
        "vous avez revêtu le Christ, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Ihr alle, die ihr auf Christus getauft worden seid, habt Christus als Gewand angelegt. Halleluja."
       ]
      ]
     }
    ]
   },
