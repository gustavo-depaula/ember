       ],
       [
        "e, por intercessão de São Matias,"
       ],
       [
        "possamos participar eternamente"
       ],
       [
        "da gloriosa sorte dos santos em vossa luz."
       ],
       [
        "Por Cristo, nosso Senhor."
       ]
      ]
     }
