  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Præsénti oblatióne, Dómine, in beáti ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "commemoratióne deláta, fidélibus tuis, quǽsumus, pacis et unitátis dona largíre. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "h4",
      "lines": [
       [
        "Sobre as oferendas"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Through the present oblation, O Lord, which we offer in commemoration of blessed ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", bestow on your faithful, we pray, the gifts of unity and peace."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Señor, por esta oblación que te presentamos"
       ],
       [
        "en la conmemoración de san ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "otorga a tus fieles los dones de la paz y la unidad."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "L'offerta che ti presentiamo, o Signore, nella memoria di san ",
        {
         "m": "rubric",
         "t": "N."
        },
        " ottenga ai tuoi fedeli i doni dell'unità e della pace. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Grâce à l'offrande qui t'est présentée, Seigneur,"
       ],
       [
        "en la mémoire de saint ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "accorde largement à tes fidèles"
       ],
       [
        "les dons de l'unité et de la paix."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, unser Gott, am Gedenktag des heiligen ",
        {
         "m": "rubric",
         "t": "N."
        },
        " sind wir um deinen Altar versammelt und bringen unsere Gaben dar. Schenke deinen Gläubigen in diesem Opfer Frieden und Einheit. Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
