 ],
 "title": {
  "la": "Tempus Adventus — Hebdomada II — Feria quarta",
  "pt-BR": "Quarta-feira da 2ª Semana do Advento",
  "en-US": "Wednesday of the Second Week of Advent",
  "es": "Tiempo de Adviento — Miércoles de la II Semana",
  "it": "Tempo di Avvento — II SETTIMANA — Mercoledì",
