  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ab omni nos, quǽsumus, Dómine, vetustáte purgátos,"
       ],
       [
        "sacraménti Fílii tui veneránda percéptio"
       ],
       [
        "in novam tránsferat creatúram."
       ],
       [
        "Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Purificados de toda antiga culpa,"
       ],
       [
        "nós vos pedimos, Senhor,"
       ],
       [
        "que a sagrada comunhão no sacramento do vosso Filho"
       ],
       [
        "nos transforme em nova criatura."
       ],
       [
        "Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "We pray, O Lord,"
       ],
       [
        "that the reverent reception of the Sacrament of your Son may cleanse us from our old ways"
       ],
       [
        "and transform us into a new creation."
       ],
       [
        "Through Christ our Lord."
