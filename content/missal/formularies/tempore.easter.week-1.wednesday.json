  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Veníte, benedícti Patris mei, percípite regnum,"
       ],
       [
        "quod vobis parátum est ab orígine mundi, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Vinde, benditos do meu Pai:"
       ],
       [
        "tomai posse do reino preparado para vós"
       ],
       [
        "desde a origem do mundo, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Come, you blessed of my Father;"
       ],
       [
        "receive the kingdom prepared for you from the foundation of the world, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Venid vosotros, benditos de mi Padre; heredad el reino preparado para vosotros desde la creación del mundo. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Venite, benedetti del Padre mio, ricevete in eredità il regno preparato per voi fin dalla creazione del mondo. Alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Venez les bénis de mon Père,"
       ],
       [
        "recevez en héritage le Royaume"
       ],
       [
        "préparé pour vous depuis la fondation du monde, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Kommt her, ihr, die ihr von meinem Vater gesegnet seid, nehmt das Reich in Besitz, das seit Anfang der Welt für euch bestimmt ist. Halleluja."
       ]
      ]
     }
    ]
   },
