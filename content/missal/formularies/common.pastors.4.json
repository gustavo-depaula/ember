  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ego veni ut vitam hábeant, et abundántius hábeant, dicit Dóminus ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "allelúia",
        {
         "m": "rubric",
         "t": "). "
        }
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Eu vim para que tenham vida, e a tenham em abundância, diz o Senhor ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "aleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "I have come that they may have life, and have it more abundantly, says the Lord ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Yo he venido para que tengan vida y la tengan abundante, dice el Señor ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "«Io sono venuto perché abbiano la vita e l'abbiano in abbondanza», dice il Signore",
        {
         "m": "rubric",
         "t": "( T. P."
        },
        "Alleluia ",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Je suis venu pour que les brebis aient la vie,"
       ],
       [
        "la vie en abondance, dit le Seigneur ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "alléluia",
        {
         "m": "rubric",
         "t": "). "
        }
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Ich bin gekommen, damit sie das Leben haben und es in Fülle haben - so spricht der Herr."
       ]
      ]
     }
    ]
