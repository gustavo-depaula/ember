  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Lauda, Ierúsalem, Dóminum, qui ádipe fruménti sátiat te."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Glorifica o Senhor, Jerusalém,"
       ],
       [
        "ele te dá como alimento a flor do trigo."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "O Jerusalem, glorify the Lord,"
       ],
       [
        "who gives you your fill of finest wheat."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Glorifica al Señor, Jerusalén, que te sacia con flor de harina."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Celebra il Signore, Gerusalemme! Egli ti sazia con fiore di frumento."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Glorifie le Seigneur, Jérusalem :"
       ],
       [
        "de la fleur du froment, il te rassasie."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Jerusalem, preise den Herrn, er sättigt dich mit bestem Weizen."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
