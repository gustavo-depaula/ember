       [
        "Communion antiphon"
       ]
      ],
      "cite": "Mt 19:29"
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Everyone who has given up home,"
       ],
       [
        "brothers, or sisters, father or mother,"
       ],
       [
        "wife or children or property for my sake"
       ],
       [
        "will receive many times as much and inherit everlasting life."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Prayer after communion"
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Refreshed by our participation in the memorial of the death and resurrection of your Son,"
       ],
       [
        "we ask, O Lord,"
       ],
       [
        "that by the example of Saint John Neumann,"
       ],
       [
        "we may experience the power of this sacrament and remain constantly in the Church"
       ],
       [
        "by the bond of unity and truth."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  }
