  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Gaudéte in Dómino semper: íterum dico, gaudéte. Dóminus enim prope est."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Alegrai-vos sempre no Senhor!"
       ],
       [
        "Repito, alegrai-vos!"
       ],
       [
        "O Senhor está próximo."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Rejoice in the Lord always; again I say, rejoice. Indeed, the Lord is near."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Alegraos siempre en el Señor; os lo repito, alegraos. El Señor está cerca."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Rallegratevi sempre nel Signore:"
       ],
       [
        "ve lo ripeto: rallegratevi,"
       ],
       [
        "il Signore è vicino!"
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Soyez toujours dans la joie du Seigneur ;"
       ],
       [
        "je le redis : soyez dans la joie."
       ],
       [
        "Le Seigneur est proche."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Freut euch im Herrn zu jeder Zeit! Noch einmal sage ich: Freut euch! Denn der Herr ist nahe."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
