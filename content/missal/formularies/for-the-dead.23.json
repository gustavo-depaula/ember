   "part": "communionAntiphon"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Quemádmodum desíderat cervus ad fontes aquárum, ita desíderat ánima mea ad te, Deus: sitívit ánima mea ad Deum fortem vivum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Assim como a corça suspira pelas águas correntes, suspira igualmente minh'alma por vós, ó meu Deus! Minha alma tem sede de Deus, e deseja o Deus vivo."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Like the deer that yearns for running streams, so my soul is yearning for you, my god."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Como busca la cierva corrientes de agua, así mi alma te busca a ti, Dios mío; mi alma tiene sed de Dios, del Dios vivo."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Come la cerva anela ai corsi d'acqua, così l'anima mia anela a te, o Dio. L'anima mia ha sete di Dio, del Dio vivente."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Quemádmodum desíderat cervus ad fontes aquárum, ita desíderat ánima mea ad te, Deus: sitívit ánima mea ad Deum fortem vivum."
       ]
      ]
     }
    ]
   },
