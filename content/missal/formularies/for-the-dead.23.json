   "part": "postcommunion"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Invéniant, quǽsumus, Dómine, fámuli tui, omnésque in Christo quiescéntes, lucis ætérnæ consórtium, qui, in hac luce pósiti, tuum consecúti sunt sacraméntum. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, nós vos pedimos por vossos servos e por todos os que adormeceram em Cristo; tendo eles participado deste sacramento nesta vida, cheguem ao vosso convívio na luz que não se apaga. Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "May your departed servants"
       ],
       [
        "and all who sleep in Christ"
       ],
       [
        "inherit eternal light, we pray, O Lord, for while still in this life"
       ],
       [
        "they received this, your holy sacrament."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Te pedimos, Señor, que tus siervos"
       ],
       [
        "y cuantos descansan en Cristo"
       ],
       [
        "participen en la luz eterna,"
       ],
       [
        "ya que, mientras vivieron en este mundo,"
       ],
       [
        "recibieron tu sacramento."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "O Signore, i nostri fratelli ",
        {
         "m": "rubric",
         "t": "["
        },
        "le nostre sorelle",
        {
         "m": "rubric",
         "t": "] N."
        },
        " e",
        {
         "m": "rubric",
         "t": " N."
        },
        " e tutti coloro che riposano in Cristo abbiano parte alla luce eterna, poiché nella breve luce del giorno terreno hanno ricevuto il sacramento di salvezza. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Invéniant, quǽsumus, Dómine, fámuli tui, omnésque in Christo quiescéntes, lucis ætérnæ consórtium, qui, in hac luce pósiti, tuum consecúti sunt sacraméntum. Per Christum."
       ]
      ]
     }
    ]
