{"id":"sanctorale.12-10.spain","source":"santos/santos_dic#1210Z","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"(en las diócesis de España)"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["10 de diciembre"],["Santa Eulalia de Mérida, virgen y mártir"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[["Eulalia, de esclarecido linaje por su nacimiento, pero más todavía por su muerte, nació en Mérida a finales del siglo III. Prudencio hace una primorosa descripción de su martirio, coincidiendo admirablemente con las actas escritas por un testigo ocular. Murió, tras crueles torturas, a la edad de doce años, un día 10 de diciembre. Es una de las mártires españolas más veneradas. Murió con tan sólo doce años de edad, en el año 305, bajo el emperador Maximiano."]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"Común de mártires:"}],[{"m":"link","t":"vm","to":"common.martyrs.13"}],[{"m":"rubric","t":", o de vírgenes:"}],[{"m":"link","t":"1","to":"common.virgins.1"},{"m":"link","t":"2","to":"common.virgins.2"},{"m":"link","t":"3","to":"common.virgins.3"}],[{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Oración colecta"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Oh, Dios,"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["fuente de todos los bienes,"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["que para llevarnos a la\nconfesión de tu nombre"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["te has servido incluso del martirio de los\nniños,"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["haz que tu Iglesia,"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["alentada por el ejemplo de santa\nEulalia de Mérida, mártir,"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["no tema sufrir por ti"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["y desee\nardientemente la gloria del premio eterno."]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Por nuestro Señor\nJesucristo."]]}]},"part":"collect"},{"mark":"readings","at":"1210Z"},{"slot":"69","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"70","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis martyribus"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Quóniam beáti mártyris N. pro confessióne...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Quóniam tu magnificáris in tuórum...","to":"preface.55"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...O sangue que o Santo Mártir N. derramou...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Vós sois exaltado quando celebramos os santos...","to":"preface.55"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY MARTYRS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For the blood of your blessed...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For you are glorified when your Saints...","to":"preface.55"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque la sangre del glorioso mártir...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Porque tú eres ensalzado en la alabanza de tus santos...","to":"preface.55"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI MARTIRI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... A imitazione del Cristo tuo Figlio...","to":"preface.54"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Martyrs"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nous reconnaissons un signe éclatant de ta grâce...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... En louant tes saints martyrs,...","to":"preface.55"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"MÄRTYRERN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...Im Martyrium des (der) heiligen N. ...","to":"preface.54"}]],"cls":"indicepref"}]},"part":"preface","suggested":true},{"slot":"71","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis virginibus et religiosis "},{"m":"link","t":"... In Sanctis enim, qui Christo se dedicavérunt...","to":"preface.57"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Das Santas Virgens e Religiosos "},{"m":"link","t":"...Recordando os santos e santas...","to":"preface.57"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY VIRGINS AND RELIGIOUS "},{"m":"link","t":"... For in the Saints who consecrated themselves...","to":"preface.57"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santas Vírgenes y Religiosos "},{"m":"link","t":"...Porque celebramos tu providencia admirable...","to":"preface.57"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DELLE SANTE VERGINI E DEI SANTI RELIGIOSI "},{"m":"link","t":"... Nei tuoi santi, che per il regno...","to":"preface.57"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des religieux "},{"m":"link","t":"... Nous célébrons les prévenances de ton amour...","to":"preface.57"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN JUNGFRAUEN UND ORDENSLEUTEN "},{"m":"link","t":"... Inmitten der Kirche berufst du Menschen...","to":"preface.57"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"lectionary":"sanctorale.12-10.spain","prefaces":["preface.54","preface.55","preface.57"],"commons":["common.martyrs.13","common.virgins.1","common.virgins.2","common.virgins.3"],"title":{"*":"Santa Eulalia de Mérida, virgen y mártir"}}
