     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Ubi sollemnitas Ascensionis non est de præcepto servanda, assignatur, tamquam diei proprio, dominicæ VII Paschæ."
        }
       ],
       [
        {
         "m": "rubric",
         "t": "Hæc Missa adhibetur vespere pridie sollemnitatis sive ante sive post I Vesperas Ascensionis."
        }
       ]
      ]
     }
    ],
