       [
        "fáciant nos, eius vestígia sectántes, conténdere."
       ],
       [
        "Qui vivit et regnat in sǽcula sæculórum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Os dons que recebemos do vosso altar, Senhor,"
