        "Solemnity"
       ],
       [
        "At the Vigil Mass"
       ]
      ]
     },
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Where the Solemnity of the Ascension is not to be observed as a Holyday of Obligation, it is assigned to the Seventh Sunday of Easter as its proper day."
        }
       ],
       [
        {
         "m": "rubric",
         "t": "This Mass is used on the evening of the day before the Solemnity, either before or after First Vespers (Evening Prayer I) of the Ascension."
        }
       ]
