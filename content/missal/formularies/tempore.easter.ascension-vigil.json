  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Regna terræ, cantáte Deo, psállite Dómino,"
       ],
       [
        "qui ascéndit super cælum cæli;"
       ],
       [
        "magnificéntia et virtus eius in núbibus, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Reinos da terra, celebrai o nosso Deus, cantai-lhe salmos! Dai glória a Deus e exaltai o seu poder por sobre as nuvens, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "You kingdoms of the earth, sing to God;"
       ],
       [
        "praise the Lord, who ascends above the highest heavens; his majesty and might are in the skies, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Reyes de la tierra, cantad a Dios, tocad al Señor que asciende a lo más alto de los cielos; su majestad y su poder sobre las nubes. Aleluya."
       ]
      ]
     },
     {
      "k": "p",
      "lines": [
       [
        "Regni della terra, cantate a Dio, cantate inni al Signore, che ascende nei cieli eterni. Sopra le nubi splende la sua bellezza e la sua potenza. Alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Regna terræ, cantáte Deo, psállite Dómino,"
       ],
       [
        "qui ascéndit super cælum cæli;"
       ],
       [
        "magnificéntia et virtus eius in núbibus, alléluia."
       ]
      ]
     }
    ]
   },
