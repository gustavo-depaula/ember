      "lines": [
       [
        "Solenidade"
       ],
       [
        "Missa da Vigília"
       ]
      ]
     },
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "No Brasil, a Solenidade da Ascensão é celebrada no sétimo domingo da Páscoa."
        }
       ],
       [
        {
         "m": "rubric",
         "t": "Esta Missa se celebra na noite do dia que precede a Solenidade, antes ou depois das I Vésperas da Ascensão."
