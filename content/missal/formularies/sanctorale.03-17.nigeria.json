  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Communion Antiphon"
       ]
      ],
      "cite": "Mt 10: 27"
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "What I say to you in the darkness"
       ],
       [
        "speak in the light, says the Lord,"
       ],
       [
        "what you hear whispered,"
       ],
       [
        "proclaim on the housetops."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Prayer after communion"
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Receiving, almighty Father,"
       ],
       [
        "the Body and Blood of your Son,"
       ],
       [
        "we have known a foretaste of the heavenly banquet;"
       ],
       [
        "grant that, in communion with Saint Patrick"
       ],
       [
        "and all our forebearers in faith,"
       ],
       [
        "we may be true to your commandments on earth"
       ],
       [
        "and so share eternal joy in heaven."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  }
