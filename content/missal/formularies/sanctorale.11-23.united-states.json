{"id":"sanctorale.11-23.united-states","source":"santos/santos_nov#1123X","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of the United States]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["November 23"],["Blessed Miguel Agustín Pro, Priest and Martyr"]]}]},"part":"title"},{"text":{"*":[{"k":"h3","lines":[["Memorial"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"From the Common of Martyrs:"}],[{"m":"link","t":"1","to":"common.martyrs.6"},{"m":"link","t":"2","to":"common.martyrs.7"}],[{"m":"rubric","t":", or from the Common of Pastors:"}],[{"m":"link","t":"1","to":"common.pastors.6"},{"m":"link","t":"2","to":"common.pastors.7"}],[{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Our God and Father,"],["who conferred upon your servant Blessed Miguel Agustín Pro the grace of ardently seeking your greater glory"],["and the salvation of others,"],["grant through his intercession and example,"],["that by faithfully and joyfully performing our daily duties and effectively assisting those around us,"],["we may serve you with zeal"],["and ever seek your glory."],["Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"slot":"206","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"207","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis martyribus"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Quóniam beáti mártyris N. pro confessióne...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Quóniam tu magnificáris in tuórum...","to":"preface.55"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...O sangue que o Santo Mártir N. derramou...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Vós sois exaltado quando celebramos os santos...","to":"preface.55"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY MARTYRS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For the blood of your blessed...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For you are glorified when your Saints...","to":"preface.55"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque la sangre del glorioso mártir...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Porque tú eres ensalzado en la alabanza de tus santos...","to":"preface.55"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI MARTIRI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... A imitazione del Cristo tuo Figlio...","to":"preface.54"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Martyrs"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nous reconnaissons un signe éclatant de ta grâce...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... En louant tes saints martyrs,...","to":"preface.55"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"MÄRTYRERN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...Im Martyrium des (der) heiligen N. ...","to":"preface.54"}]],"cls":"indicepref"}]},"part":"preface","suggested":true},{"slot":"208","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis pastoribus "},{"m":"link","t":"... Quia sic tríbuis Ecclésiam tuam sancti...","to":"preface.56"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos Pastores "},{"m":"link","t":"...Vós nos concedeis a alegria...","to":"preface.56"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY PASTORS "},{"m":"link","t":"... For, as on the festival of Saint...","to":"preface.56"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Pastores "},{"m":"link","t":"... Porque nos concedes la alegría...","to":"preface.56"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI SANTI PASTORI "},{"m":"link","t":"... Tu doni alla tua Chiesa...","to":"preface.56"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Pasteurs "},{"m":"link","t":"... Tu donnes à ton Église de se réjouir..","to":"preface.56"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HIRTEN DER KIRCHE "},{"m":"link","t":"... am Fest des heiligen N. deine Größe...","to":"preface.56"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":11.0,"prefaces":["preface.54","preface.55","preface.56"],"commons":["common.martyrs.6","common.martyrs.7","common.pastors.6","common.pastors.7"],"title":{"*":"Blessed Miguel Agustín Pro, Priest and Martyr"}}
