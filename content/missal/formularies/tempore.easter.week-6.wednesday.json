  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Confitébor tibi in pópulis, Dómine,"
       ],
       [
        "et narrábo nomen tuum frátribus meis, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Eu vos louvarei, Senhor, entre os povos,"
       ],
       [
        "e anunciarei vosso nome aos meus irmãos, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "I will praise you, Lord, among the nations; I will tell of your name to my kin, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Te daré gracias entre las naciones, Señor; contaré tu fama a mis hermanos. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ti loderò, Signore, tra le genti, e annuncerò il tuo nome ai miei fratelli. Alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Je te rendrai grâce parmi les peuples, Seigneur ;"
       ],
       [
        "je proclamerai ton nom devant mes frères, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Ich will dir danken, Herr, vor den Völkern; deinen Namen will ich meinen Brüdern verkünden. Halleluja."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
