   "part": "communionAntiphon"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Dicit Dóminus: Ego elégi vos de mundo"
       ],
       [
        "et pósui vos ut eátis, et fructum afferátis,"
       ],
       [
        "et fructus vester máneat, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Assim diz o Senhor:"
       ],
       [
        "Eu vos escolhi do mundo"
       ],
       [
        "e vos destinei para irdes e produzirdes fruto"
       ],
       [
        "e o vosso fruto permaneça, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "I have chosen you from the world, says the Lord, and have appointed you to go out and bear fruit, fruit that will last, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Dice el Señor: «Yo os he escogido sacándoos del mundo y os he destinado para que vayáis y deis fruto y vuestro fruto permanezca». Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Dice il Signore: «Io ho scelto voi e vi ho costituiti perché andiate e portiate frutto e il vostro frutto rimanga». Alleluia."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "Quando verrà lo Spirito della verità, vi guiderà alla verità tutta intera. Alleluia."
       ]
      ],
      "cite": "Cf. Gv 16, 13"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Je vous ai choisis en vous prenant dans le monde, dit le Seigneur,"
       ],
       [
        "afin que vous alliez, que vous portiez du fruit,"
       ],
       [
        "et que votre fruit demeure, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "So spricht der Herr: Ich habe euch aus der Welt erwählt und euch dazu bestimmt, dass ihr hingeht und Frucht bringt und dass eure Frucht bleibt. Halleluja."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
