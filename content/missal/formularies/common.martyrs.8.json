  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Gaudéte, iusti, in Dómino; rectos decet collaudátio, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Ó justos, alegrai-vos no Senhor;"
       ],
       [
        "aos retos fica bem glorificá-lo, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Ring out your joy to the Lord, O you just, for praise is fitting for the upright, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Aclamad, justos, al Señor, que merece la alabanza de los buenos. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Gioite, giusti, nel Signore; ai retti si addice la lode. Alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Criez de joie pour le Seigneur, hommes justes !"
       ],
       [
        "Hommes droits, à vous la louange, alléluia !"
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
