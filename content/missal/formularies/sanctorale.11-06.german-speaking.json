{"id":"sanctorale.11-06.german-speaking","source":"santos/santos_nov#1106Z","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In den Diözesen deutscher Sprache]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["6. November"],["Hl. Leonhard, Einsiedler"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[["Der Einsiedler Leonard lebte wahrscheinlich im 6. Jh. im heutigen St-Léonard-de-Noblat (Bistum Limoges). Nach der legendären Lebensbeschreibung aus dem 11. Jh. soll er aus dem fränkischen Adel stammen und Schüler des heiligen Remiguis von Reims gewesen sein."]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"Commune-Texte für Ordensleute:"}],[{"m":"link","t":"1","to":"common.holy-men-and-women.10"},{"m":"link","t":"2","to":"common.holy-men-and-women.11"}],[{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Tagesgebet"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Barmherziger Gott, du hast den heiligen Einsiedler Leonhard berufen, Gefangene zu befreien und Sünder auf den rechten Weg zu führen. Löse uns aus den Fesseln der Sünde und erhalte uns in der Freiheit, zu der du uns berufen hast. Darum bitten wir durch Jesus Christus."]]}]},"part":"collect"},{"slot":"81","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"82","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Qui in Sanctórum concílio celebráris,...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Tu enim Sanctórum tuórum confessióne...","to":"preface.53"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...Na assembleia dos Santos...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Pois, pelo testemunho admirável...","to":"preface.53"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"SAINTS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For you are praised in the company...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For in the marvellous confession of...","to":"preface.53"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque eres glorificado en la asamblea...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Porque mediante el testimonio admirable de tus santos...","to":"preface.53"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI SANTI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nella festosa assemblea dei santi...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Nella testimonianza di fede dei tuoi santi...","to":"preface.53"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Saints"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Car tu es glorifié dans l'assemblée des saints...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Tu ne cesses de fortifier ton Église...","to":"preface.53"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Die Schar der Heiligen verkündet...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Denn in den Heiligen schenkst du der Kirche...","to":"preface.53"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.52","preface.53"],"commons":["common.holy-men-and-women.10","common.holy-men-and-women.11"],"title":{"*":"Hl. Leonhard, Einsiedler"}}
