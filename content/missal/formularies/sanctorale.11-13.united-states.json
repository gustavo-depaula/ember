   "part": "title"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "From the Common of Virgins:"
        },
        " ",
        {
         "m": "link",
         "t": "1",
         "to": "common.virgins.1"
        },
        {
         "m": "link",
         "t": "2",
         "to": "common.virgins.2"
        },
        {
         "m": "link",
         "t": "3",
         "to": "common.virgins.3"
        },
        " ",
        {
         "m": "rubric",
         "t": ", or from the Common of Holy Men and Women:"
        },
        " ",
        {
         "m": "link",
         "t": "For Those",
         "to": "common.holy-men-and-women.12"
        },
        " ",
        {
         "m": "rubric",
         "t": "Who Practiced Works of Mercy."
        }
       ]
      ]
     }
    ]
   },
   "part": "title"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Collect"
       ]
      ]
     }
    ]
   },
   "part": "collect"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "God our Father,"
       ],
       [
        "who called Saint Frances Xavier Cabrini from Italy"
       ],
       [
        "to serve the immigrants of America,"
       ],
       [
        "by her example,"
       ],
       [
        "teach us to have concern for the stranger,"
       ],
       [
        "the sick, and all those in need,"
       ],
       [
        "and by her prayers help us to see Christ"
       ],
       [
        "in all the men and women we meet."
       ],
       [
        "Through our Lord Jesus Christ, your Son,"
       ],
       [
        "who lives and reigns with you in the unity of the Holy Spirit,"
       ],
       [
        "one God, for ever and ever."
       ]
      ]
     }
    ]
   },
   "part": "collect"
  },
