   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ecce fidélis servus et prudens, quem constítuit Dóminus super famíliam suam."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Eis o servo fiel e prudente,"
       ],
       [
        "a quem o Senhor confiou a sua família."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Behold, a faithful and prudent steward, whom the Lord set over his household."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Este es el administrador fiel y prudente a quien el Señor puso al frente de su servidumbre."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ecco il servo fedele e prudente, che il Signore ha messo a capo della sua famiglia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Voici le serviteur fidèle et avisé"
       ],
       [
        "que le Seigneur a placé à la tête de sa famille."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Seht, das ist der treue und kluge Hausvater, dem der Herr seine Familie anvertraut, damit er für sie sorge."
       ]
      ]
     }
    ]
