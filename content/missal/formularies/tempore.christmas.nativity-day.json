      "cite": "Gv 1, 14"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Tous les lointains de la terre ont vu"
       ],
       [
        "le salut de notre Dieu."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Alle Enden der Erde sahen die rettende Tat unseres Gottes."
       ]
      ]
