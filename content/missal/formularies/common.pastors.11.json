    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor nosso Deus, os sacramentos que recebemos alimentem em nós a mesma fé transmitida pela pregação apostólica e que São ",
        {
         "m": "rubric",
         "t": "N."
        },
        " guardou com solicitude. Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "May the Sacrament we have received, O Lord our God, nourish in us that faith taught by the preaching of the Apostles and kept safe by the labors of blessed ",
        {
         "m": "rubric",
         "t": "N."
        },
        " Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Señor, Dios nuestro,"
       ],
       [
        "que los sacramentos que hemos recibido"
       ],
       [
        "alimenten en nosotros aquella fe"
       ],
       [
        "que nos enseñó la predicación apostólica"
       ],
       [
        "y que san ",
        {
         "m": "rubric",
         "t": "N."
        },
        " conservó celosamente."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
