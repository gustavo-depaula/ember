  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Sacrifícium, Dómine, pro Fílii tui súpplices"
       ],
       [
        "venerábili nunc ascensióne deférimus:"
       ],
       [
        "præsta, quǽsumus,"
       ],
       [
        "ut his commérciis sacrosánctis"
       ],
       [
        "ad cæléstia consurgámus."
       ],
       [
        "Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, na festa da venerável ascensão do vosso Filho"
       ],
       [
        "nós vos apresentamos humildemente este sacrifício."
       ],
       [
        "Concedei que, por este intercâmbio de dons,"
       ],
       [
        "sejamos elevados às realidades do céu."
       ],
       [
        "Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "We offer sacrifice now in supplication, O Lord, to honor the wondrous Ascension of your Son: grant, we pray,"
       ],
       [
        "that through this most holy exchange"
       ],
       [
        "we, too, may rise up to the heavenly realms."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
