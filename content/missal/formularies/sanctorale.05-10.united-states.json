{"id":"sanctorale.05-10.united-states","source":"santos/santos_may#0510Z","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of the United States]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["May 10"],["Saint Damien de Veuster, Priest"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"From the Common of Pastors:"}],[{"m":"link","t":"1","to":"common.pastors.6"},{"m":"link","t":"2","to":"common.pastors.7"}],[{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Father of mercy,"],["who gave us in Saint Damien"],["a shining witness of love for the poorest and most abandoned, grant that, by his intercession,"],["as faithful witnesses of the heart of your Son Jesus,"],["we too may be servants of the most needy and rejected. Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"slot":"49","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"50","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis pastoribus "},{"m":"link","t":"... Quia sic tríbuis Ecclésiam tuam sancti...","to":"preface.56"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos Pastores "},{"m":"link","t":"...Vós nos concedeis a alegria...","to":"preface.56"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY PASTORS "},{"m":"link","t":"... For, as on the festival of Saint...","to":"preface.56"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Pastores "},{"m":"link","t":"... Porque nos concedes la alegría...","to":"preface.56"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI SANTI PASTORI "},{"m":"link","t":"... Tu doni alla tua Chiesa...","to":"preface.56"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Pasteurs "},{"m":"link","t":"... Tu donnes à ton Église de se réjouir..","to":"preface.56"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HIRTEN DER KIRCHE "},{"m":"link","t":"... am Fest des heiligen N. deine Größe...","to":"preface.56"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.56"],"commons":["common.pastors.6","common.pastors.7"],"title":{"*":"Saint Damien de Veuster, Priest"}}
