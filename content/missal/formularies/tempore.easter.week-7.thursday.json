  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Adeámus cum fidúcia ad thronum grátiæ,"
       ],
       [
        "ut misericórdiam consequámur,"
       ],
       [
        "et grátiam inveniámus in auxílio opportúno, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Aproximemo-nos, com toda a confiança, do trono da graça,"
       ],
       [
        "para conseguirmos misericórdia"
       ],
       [
        "e alcançarmos a graça de um auxílio"
       ],
       [
        "no momento oportuno, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "With boldness let us approach the throne of grace, that we may receive mercy"
       ],
       [
        "and find grace as a timely help, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Comparezcamos confiados ante el trono de la gracia, para alcanzar misericordia y encontrar gracia para un auxilio oportuno. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Accostiamoci con piena fiducia al trono della grazia per ricevere misericordia e trovare grazia, che ci sostenga al momento opportuno. Alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Avançons-nous avec assurance"
       ],
       [
        "vers le Trône de la grâce, pour obtenir miséricorde"
       ],
       [
        "et recevoir, en temps voulu, la grâce de son secours, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Mit Zuversicht lasst uns zum Thron der Gnade hintreten, damit wir Erbarmen finden und Gnade empfangen, Hilfe zur rechten Zeit. Halleluja."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
