   "part": "communionAntiphon"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Pater, pro eis rogo, ut ipsi in nobis unum sint,"
       ],
       [
        "ut credat mundus quia tu me misísti,"
       ],
       [
        "dicit Dóminus, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Pai, rogo por eles, para que sejam um em nós,"
       ],
       [
        "a fim de que o mundo creia que tu me enviaste,"
       ],
       [
        "diz o Senhor, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Father, I pray for them, that they may be one in us,"
       ],
       [
        "so that the world may believe it was you who sent me, says the Lord, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Padre, por ellos ruego, para que todos sean uno en nosotros, para que el mundo crea que tú me has enviado, dice el Señor. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "«Padre, prego per quelli che crederanno in me, perché tutti siano una cosa sola, e il mondo creda che tu mi hai mandato», dice il Signore. Alleluia."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "«Se hanno osservato la mia parola, osserveranno anche la vostra», dice il Signore. Alleluia."
       ]
      ],
      "cite": "Gv 15, 20"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Père, je te prie pour eux :"
       ],
       [
        "qu'ils soient un en nous, eux aussi,"
       ],
       [
        "pour que le monde croie que tu m'as envoyé,"
       ],
       [
        "dit le Seigneur, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "So spricht der Herr: Ich bitte dich, Vater, für sie: Lass sie eins sein in uns, damit die Welt glaubt, dass du mich gesandt hast. Halleluja."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
