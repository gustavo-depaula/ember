       [
        "Communion Antiphon"
       ]
      ],
      "cite": "Mt 25:34"
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Come, you whom my Father has blessed."
       ],
       [
        "Inherit the kingdom prepared for you from the foundation of the world."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Prayer after communion"
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Father of life,"
       ],
       [
        "who has nourished us"
       ],
       [
        "at the table of the Word and of the Eucharist;"
       ],
       [
        "strengthened by these gifts,"
       ],
       [
        "and sustained by the example and prayer of the Saints of Africa,"
       ],
       [
        "may we work for the spreading of your Kingdom"
       ],
       [
        "in holiness and love."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  }
