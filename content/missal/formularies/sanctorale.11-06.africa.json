{"id":"sanctorale.11-06.africa","source":"santos/santos_africa#1106","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of Africa]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["November 6"],["All Saints of Africa"]]}]},"part":"title"},{"text":{"*":[{"k":"h3","lines":[["Memorial"]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Entrance Antiphon"]],"cite":"Ps 92:13-14"}]},"part":"entranceAntiphon"},{"text":{"*":[{"k":"p","lines":[["The righteous will flourish like the palm tree, and grow like a Lebanon cedar."],["Planted in the house of the Lord, they will flourish in the courts of our God."]]}]},"part":"entranceAntiphon"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["God, our Father,"],["who raised up in the Church of Africa"],["many men and women outstanding in holiness;"],["grant us, we beseech you, the gift of your grace,"],["that we may follow their example"],["in order to be, one day, their fellow citizens in heaven."],["Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"text":{"*":[{"k":"h4","lines":[["Prayer over the Offerings"]]}]},"part":"prayerOverOfferings"},{"text":{"*":[{"k":"p","lines":[["Father of love and mercy,"],["receive our prayers and gifts on this feast of the Saints of Africa,"],["may this celebration bring us closer to you,"],["the source of life and holiness,"],["and give us renewed vigour in living our baptismal call."],["Through Christ our Lord."]]}]},"part":"prayerOverOfferings"},{"slot":"32","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"33","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Qui in Sanctórum concílio celebráris,...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Tu enim Sanctórum tuórum confessióne...","to":"preface.53"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Santos"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Na assembleia dos Santos,...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Pelo testemunho admirável de vossos Santos...","to":"preface.53"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"SAINTS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For you are praised in the company...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For in the marvellous confession of...","to":"preface.53"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque eres glorificado en la asamblea...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Porque mediante el testimonio admirable de tus santos...","to":"preface.53"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI SANTI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nella festosa assemblea dei santi...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Nella testimonianza di fede dei tuoi santi...","to":"preface.53"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Car tu es glorifié dans l'assemblée des saints...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Tu ne cesses de fortifier ton Église...","to":"preface.53"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Die Schar der Heiligen verkündet...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Denn in den Heiligen schenkst du der Kirche...","to":"preface.53"}]],"cls":"indicepref"}]},"part":"preface","suggested":true},{"text":{"*":[{"k":"h4","lines":[["Communion Antiphon"]],"cite":"Mt 25:34"}]},"part":"communionAntiphon"},{"text":{"*":[{"k":"p","lines":[["Come, you whom my Father has blessed."],["Inherit the kingdom prepared for you from the foundation of the world."]]}]},"part":"communionAntiphon"},{"text":{"*":[{"k":"h4","lines":[["Prayer after communion"]]}]},"part":"postcommunion"},{"text":{"*":[{"k":"p","lines":[["Father of life,"],["who has nourished us"],["at the table of the Word and of the Eucharist;"],["strengthened by these gifts,"],["and sustained by the example and prayer of the Saints of Africa,"],["may we work for the spreading of your Kingdom"],["in holiness and love."],["Through Christ our Lord."]]}]},"part":"postcommunion"}],"precedence":11.0,"prefaces":["preface.52","preface.53"],"title":{"*":"All Saints of Africa"}}
