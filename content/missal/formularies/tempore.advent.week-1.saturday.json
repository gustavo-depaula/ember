  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Veni, et osténde nobis fáciem tuam, Dómine, qui sedes super Chérubim, et salvi érimus."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Vinde, Senhor, que estais sentado acima dos querubins;"
       ],
       [
        "mostrai-nos a vossa face, e seremos salvos."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Come and show us your face, O Lord,"
       ],
       [
        "who are seated upon the Cherubim, and we will be saved."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Ven, Señor, tú que te sientas sobre querubines, muéstranos tu rostro y sálvanos."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Vieni, e fa' splendere il tuo volto su di noi, o Signore, che siedi nei cieli, e noi saremo salvi."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Viens, Seigneur,"
       ],
       [
        "toi qui sièges au-dessus des Kéroubim ;"
       ],
       [
        "montre-nous ton visage,"
       ],
       [
        "et nous serons sauvés."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Komm, Herr, lass dein Angesicht leuchten, so ist uns geholfen. Der du auf den Kerubim thronst, erscheine!"
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
