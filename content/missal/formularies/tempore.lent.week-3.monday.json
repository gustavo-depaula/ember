  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Laudáte Dóminum, omnes gentes, quóniam confirmáta est super nos misericórdia eius."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Cantai louvores ao Senhor, todas as gentes,"
       ],
       [
        "pois comprovado é seu amor para conosco."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "O praise the Lord, all you nations,"
       ],
       [
        "for his merciful love towards us is great."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Alabad al Señor todas las naciones, firme es su misericordia con nosotros."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Genti tutte, lodate il Signore, perché forte è il suo amore per noi."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "Nessuno fu purificato fra i molti lebbrosi in Israele, se non Naamàn, il Siro."
       ]
      ],
      "cite": "Cf. Lc 4, 27"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Louez le Seigneur, tous les peuples !"
       ],
       [
        "Son amour envers nous s'est montré le plus fort."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Lobt den Herrn, alle Völker! Denn mächtig waltet über uns seine Huld."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
