  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Tui nobis, quǽsumus, Dómine, commúnio sacraménti et purificatiónem cónferat, et tríbuat unitátem. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Nós vos pedimos, Senhor,"
       ],
       [
        "que a comunhão no vosso sacramento"
       ],
       [
        "nos purifique dos pecados"
       ],
       [
        "e nos conduza à unidade."
       ],
       [
        "Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "May communion in this your Sacrament,"
       ],
       [
        "we pray, O Lord,"
       ],
       [
        "bring with it purification and the unity that is your gift."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Que la comunión en tu sacramento, Señor, nos purifique de nuestras culpas y nos conceda la unidad."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "La comunione al tuo sacramento ci purifichi, o Signore, e ci raccolga nell'unità e nella pace. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Que notre communion à ton sacrement, Seigneur,"
       ],
       [
        "purifie chacun de nous,"
       ],
       [
        "et réalise notre unité."
       ],
       [
        "Par le Christ, notre Seigneur"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Gütiger Gott, das Sakrament,"
       ],
       [
        "das wir empfangen haben, mache uns frei von Schuld"
       ],
       [
        "und schenke uns Einheit und Frieden."
       ],
       [
        "Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  },
