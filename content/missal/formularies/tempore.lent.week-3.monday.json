  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Concupíscit et déficit ánima mea in átria Dómini. Cor meum et caro mea exsultavérunt in Deum vivum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Minha alma desfalece de saudades e anseia pelos átrios do"
       ],
       [
        "Senhor!"
       ],
       [
        "Meu coração e minha carne rejubilam"
       ],
       [
        "e exultam de alegria no Deus vivo!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "My soul is longing and yearning for the courts of the Lord. My heart and my flesh cry out to the living God."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Mi alma se consume y anhela los atrios del Señor, mi corazón y mi carne retozan por el Dios vivo."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "L'anima mia anela e desidera gli atri del Signore. Il mio cuore e la mia carne esultano nel Dio vivente."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Mon âme s'épuise à désirer"
       ],
       [
        "les parvis du Seigneur ;"
       ],
       [
        "mon cœur et ma chair sont un cri de joie"
       ],
       [
        "vers le Dieu vivant !"
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Meine Seele verzehrt sich in Sehnsucht nach den Vorhöfen des Herrn,"
       ],
       [
        "mein Herz und mein Leib jauchzen ihm zu,"
       ],
       [
        "ihm, dem lebendigen Gott."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
