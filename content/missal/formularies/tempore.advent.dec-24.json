  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ecce iam venit plenitúdo témporis, in quo misit Deus Fílium suum in terram."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Eis que já chegou a plenitude do tempo,"
       ],
       [
        "em que Deus mandou à terra o seu Filho."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Behold, when the fullness of time had come, God sent his Son into the world."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Ya llega la plenitud del tiempo, en la que Dios envía a su Hijo a la tierra."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ecco ormai la pienezza del tempo: Dio ha mandato suo Figlio nel mondo."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Voici maintenant venue la plénitude des temps :"
       ],
       [
        "Dieu a envoyé son Fils sur la terre."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Nun ist die Fülle der Zeit gekommen, da Gott seinen Sohn in die Welt sendet."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
  {
