{"id":"sanctorale.06-15.german-speaking","source":"santos/santos_jun#0615Z","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In den Diözesen deutscher Sprache]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["15. Juni"],["Hl. Vitus (Veit), Märtyrer"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[["Er stammte aus Sizilien und erlitt das Martyrium in der Diokletianischen Verfolgung um das Jahr 304. Der Legende zufolge wurde er in einen Kessel mit siedendem Öl geworfen. Seine Verehrung ist seit Ende des 5. Jh. bezeugt."]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"Commune-Texte für Märtyrer:"}," ",{"m":"link","t":"1","to":"common.martyrs.6"},{"m":"link","t":"2","to":"common.martyrs.7"}," ",{"m":"rubric","t":"oder, in der österl. Zeit:"}," ",{"m":"link","t":"met","to":"common.martyrs.10"}," ",{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Tagesgebet"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Barmherziger Gott, mit deiner Kraft hat der heilige Vitus in jugendlichem Alter die Qualen des Martyriums bestanden. Wir ehren sein Andenken und empfehlen dir alle, deren Glaube bedroht ist. Stärke sie in der Hoffnung und festige sie in der Liebe. Darum bitten wir durch Jesus Christus."]]}]},"part":"collect"},{"slot":"69","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface"}],"precedence":12,"prefaces":["preface.54","preface.55"],"commons":["common.martyrs.6","common.martyrs.7","common.martyrs.10"],"title":{"*":"Hl. Vitus (Veit), Märtyrer"}}
