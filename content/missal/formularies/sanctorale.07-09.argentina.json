{"id":"sanctorale.07-09.argentina","source":"santos/santos_arg#0709","kind":"sanctoral","items":[{"text":{"*":[{"k":"h3","lines":[["En Argentina: Memoria obligatoria"]]}]},"part":"title"},{"text":{"*":[{"k":"h2","lines":[["9 de julio"],["Nuestra Señora de Itatí"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"(en las diócesis de Argentina...)"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h4","lines":[["Antífona de entrada"]],"cite":"Cf. Lc 1, 48"}]},"part":"entranceAntiphon"},{"text":{"*":[{"k":"p","lines":[["Me llamarán feliz todas las generaciones, porque Dios miró con bondad la pequeñez de su servidora."]]}]},"part":"entranceAntiphon"},{"text":{"*":[{"k":"h4","lines":[["Oración colecta"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Dios misericordioso, que para honrar la pura y limpia Concepción de la Virgen María y como defensa y custodia de tu pueblo suscitaste la advocación de Nuestra Señora de Itatí; concédenos que, bajo su protección, nos veamos libres de todo peligro y seamos conducidos al gozo de la vida eterna. Por nuestro Señor Jesucristo, tu Hijo, que vive y reina contigo en la unidad del Espíritu Santo, y es Dios, por los siglos de los siglos."]]}]},"part":"collect"},{"text":{"*":[{"k":"h4","lines":[["Oración sobre las ofrendas"]]}]},"part":"prayerOverOfferings"},{"text":{"*":[{"k":"p","lines":[["Recibe, Señor, nuestras oraciones y ofrendas y, al invocar la maternal intercesión de la santísima Virgen María, ayúdanos a celebrar dignamente el sacrificio de nuestra redención. Por Jesucristo, nuestro Señor."]]}]},"part":"prayerOverOfferings"},{"slot":"5","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"6","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De Beata Maria Virgine"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Et te in beátæ Maríæ semper Vírginis...","to":"preface.43"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Vere namque in omnes terræ fines magna...","to":"preface.44"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"VIRGEM MARIA"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... À sombra do Espírito Santo,...","to":"preface.43"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Celebrando a memória da Virgem Maria,...","to":"preface.44"}]],"cls":"indicepref"},{"k":"p","lines":[["III ",{"m":"link","t":"... Acolhendo a vossa Palavra...","to":"preface.45"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"BLESSED VIRGIN MARY"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For by the overshadowing of the Holy Spirit...","to":"preface.43"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For truly even to earth's ends...","to":"preface.44"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santa María Virgen"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Y alabar, bendecir y proclamar tu gloria...","to":"preface.43"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... En verdad hiciste obras grandes...","to":"preface.44"}]],"cls":"indicepref"},{"k":"p","lines":[["III ",{"m":"link","t":"... Ella, al aceptar tu Palabra con limpio corazón,...","to":"preface.45"}]],"cls":"indicepref"},{"k":"p","lines":[["IV ",{"m":"link","t":"... Te alabamos y te bendecimos...","to":"preface.46"}]],"cls":"indicepref"},{"k":"p","lines":[["V ",{"m":"link","t":"... Porque en esta etapa final de la historia...","to":"preface.47"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DELLA BEATA VERGINE MARIA"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Per opera dello Spirito Santo,...","to":"preface.43"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Grandi cose tu hai fatto, Signore,...","to":"preface.44"}]],"cls":"indicepref"},{"k":"p","lines":[["III ",{"m":"link","t":"... All'annunzio dell'angelo,...","to":"preface.45"}]],"cls":"indicepref"},{"k":"p","lines":[["IV ",{"m":"link","t":"... Umile ancella accolse la tua parola...","to":"preface.46"}]],"cls":"indicepref"},{"k":"p","lines":[["V ",{"m":"link","t":"... Tu hai rivelato nella pienezza dei tempi...","to":"preface.47"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"De la Bienheureuse Vierge Marie"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... En ce jour où nous célébrons la...","to":"preface.43"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Oui, tu as fait des merveilles...","to":"preface.44"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"SELIGEN JUNGFRAU MARIA"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Vom Heiligen Geist überschattet,...","to":"preface.43"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Du hast an der ganzen Schöpfung Großes getan...","to":"preface.44"}]],"cls":"indicepref"}]},"part":"preface","suggested":true},{"text":{"*":[{"k":"h4","lines":[["Antífona de la comunión"]]}]},"part":"communionAntiphon"},{"text":{"*":[{"k":"p","lines":[["Yo soy la Madre del amor hermoso, del temor de Dios, de la ciencia y de la santa esperanza."]]}]},"part":"communionAntiphon"},{"text":{"*":[{"k":"h4","lines":[["Oración después de la comunión"]]}]},"part":"postcommunion"},{"text":{"*":[{"k":"p","lines":[["Padre santo, alimentados con el sacramento de la salvación, concédenos que quienes veneramos a la Virgen María en su advocación de Nuestra Señora de Itatí, experimentemos el auxilio de tu gracia para crecer en el amor a Jesucristo, tu Hijo. Que vive y reina por los siglos de los siglos."]]}]},"part":"postcommunion"}],"precedence":10.0,"prefaces":["preface.43","preface.44","preface.45","preface.46","preface.47"],"title":{"*":"Nuestra Señora de Itatí"}}
