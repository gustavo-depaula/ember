   },
   "part": "entranceAntiphon",
   "role": "rubric"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "O quam pulchra es, virgo Christi, quæ corónam Dómini digna fuísti accípere, corónam perpétuæ virginitátis ",
        {
         "m": "rubric",
         "t": "( T. P. "
        },
        "allelúia ",
        {
         "m": "rubric",
         "t": "). "
        }
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "How beautiful you are, O virgin of Christ, who were worthy to receive the Lord's crown, the crown of perpetual virginity ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Qué hermosa eres, virgen de Cristo, que fuiste digna de recibir la corona del Señor, la corona de la perpetua virginidad ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Come sei bella, o vergine di Cristo, degna di ricevere la corona del Signore, la corona della verginità eterna ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Que tu es belle, vierge du Christ !"
       ],
       [
        "Tu as mérité de recevoir la couronne du Seigneur,"
       ],
       [
        "la couronne de la virginité à jamais ",
        {
         "m": "rubric",
         "t": "( T. P. "
        },
        "alléluia ",
        {
         "m": "rubric",
         "t": "). "
        }
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
  {
