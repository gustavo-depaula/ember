      "k": "h2",
      "lines": [
       [
        "Die 5 februarii"
       ],
       [
        "S. Agathæ, virginis et martyris"
       ]
      ]
     },
     {
      "k": "h3",
      "lines": [
       [
        "Memoria"
       ]
      ]
     },
     {
      "k": "p",
      "lines": [
       [
        "Martyrium subiit Catanæ in Sicilia, probabiliter in persecutione Decii. Eius cultus iam ab antiquo per totam Ecclesiam diffusus est eiusque nomen in Canonem Romanum insertum."
       ]
      ]
     },
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "De Communi martyrum:"
        },
        " ",
        {
         "m": "link",
         "t": "vm",
         "to": "common.martyrs.13"
        },
        {
         "m": "rubric",
         "t": ", vel de Communi virginum:"
        },
        " ",
        {
         "m": "link",
         "t": "1",
         "to": "common.virgins.1"
        },
        {
         "m": "link",
