  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Grátiam tuam nobis, Dómine,"
       ],
       [
        "semper accúmulet divíni participátio sacraménti,"
       ],
       [
        "et, sua nos virtúte mundándo,"
       ],
       [
        "tanti múneris capáces indesinénter effíciat."
       ],
       [
        "Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, a participação no divino sacramento"
       ],
       [
        "aumente sempre em nós a vossa graça,"
       ],
       [
        "e, purificando-nos pela sua força,"
       ],
       [
        "nos torne cada vez mais dignos de tão grande dom."
       ],
       [
        "Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "May our partaking of this divine Sacrament, O Lord, constantly increase your grace within us,"
       ],
       [
        "and, by cleansing us with its power,"
       ],
       [
        "make us always ready to receive so great a gift."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "La participación en este divino sacramento"
       ],
       [
        "nos colme siempre de tu gracia, Señor,"
       ],
       [
        "y, al purificarnos con su fuerza,"
       ],
       [
        "nos haga cada vez más dignos de este gran regalo."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "La partecipazione a questi santi misteri ci dia grazia su grazia, o Signore, e con la sua forza purificatrice ci renda sempre più degni di così grande dono. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Seigneur, que notre participation à ton sacrement divin,"
       ],
       [
        "augmente sans cesse en nous ta grâce :"
       ],
       [
        "que sa force nous purifie"
       ],
       [
        "et nous dispose à recevoir toujours mieux"
       ],
       [
