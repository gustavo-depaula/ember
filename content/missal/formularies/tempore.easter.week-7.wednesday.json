  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Omnes gentes, pláudite mánibus,"
       ],
       [
        "iubiláte Deo in voce exsultatiónis, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Povos todos do universo, batei palmas,"
       ],
       [
        "gritai a Deus aclamações de alegria, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "All peoples, clap your hands."
       ],
       [
        "Cry to God with shouts of joy, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Pueblos todos, batid palmas, aclamad a Dios con gritos de júbilo. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Popoli tutti, battete le mani! Acclamate Dio con grida di gioia. Alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Tous les peuples, battez des mains,"
       ],
       [
        "acclamez Dieu par vos cris de joie, alléluia."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Ihr Völker alle, klatscht in die Hände; jauchzt Gott zu mit lautem Jubel! Halleluja."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
