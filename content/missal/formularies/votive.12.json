{"id":"votive.12","source":"comunes_votivas/votivas#0012","kind":"votive","items":[{"slot":"145","text":{"la":[{"k":"h2","lines":[["10. DE BEATA MARIA VIRGINE"]]},{"k":"p","lines":[[{"m":"rubric","t":"In his Missis adhibetur color albus."}]]},{"k":"h3","lines":[["A"]]}],"pt-BR":[{"k":"h2","lines":[["10. BEM-AVENTURADA VIRGEM MARIA"]]},{"k":"p","lines":[[{"m":"rubric","t":"Estas Missas celebram-se com vestes sagradas de cor branca."}]]},{"k":"h3","lines":[["A"]]}],"en-US":[{"k":"h2","lines":[["10. THE BLESSED VIRGIN MARY"]]},{"k":"p","lines":[[{"m":"rubric","t":"In these Masses, the color white is used."}]]},{"k":"h3","lines":[["A"]]}],"es":[{"k":"h2","lines":[["10. DE LA BIENAVENTURADA VIRGEN MARIA"]]},{"k":"h3","lines":[["A"]]},{"k":"p","lines":[[{"m":"rubric","t":"En estas misas se utiliza el color blanco."}]]}],"it":[{"k":"h2","lines":[["10. BEATA VERGINE MARIA"]]},{"k":"p","lines":[[{"m":"rubric","t":"Colore liturgico bianco."}],["A."]]}],"fr":[{"k":"h2","lines":[["10. De la Bienheureuse Vierge Marie"]]},{"k":"p","lines":[[{"m":"rubric","t":"Pour cette messe, on emploie la couleur blanche."}]]},{"k":"h3","lines":[["A"]]}],"de":[{"k":"h2","lines":[["10. VON DER SELIGEN JUNGFRAU MARIA"]]},{"k":"p","lines":[[{"m":"rubric","t":"Diese Messen werden in weißer Farbe gefeiert."}]]},{"k":"h3","lines":[["A"]]}]},"part":"title"},{"slot":"144","text":{"la":[{"k":"p","lines":[["Sumitur quælibet Missa de Communi beatæ Maríæ Virginis, iuxta diversa anni tempora."]]}],"pt-BR":[{"k":"p","lines":[["Escolhe-se uma Missa do Comum da Bem-aventurada Virgem Maria, segundo o Tempo litúrgico."]]}],"en-US":[{"k":"p","lines":[["Any Mass from the common of the blessed virgin Mary is used, in accordance with the various times of the year."]]}],"es":[{"k":"p","lines":[["Se toma la misa del Común de Santa María Virgen, según los diversos tiempos del año litúrgico."]]}],"it":[{"k":"p","lines":[["Si possono utilizzare le Messe dal Comune della beata Vergine Maria"]]}],"de":[{"k":"p","lines":[["