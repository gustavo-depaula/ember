  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ubi fratres in unum gloríficant Deum, ibi dabit Dóminus benedictiónem ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "allelúia",
