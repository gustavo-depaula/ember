      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Where brothers unite to glorify God, there the Lord will give blessing ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Donde se reúnen los hermanos para glorificar a Dios, allí el Señor les dará la bendición ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Dove i fratelli glorificano Dio in unità, lì il Signore darà benedizione ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Là où des frères, tous ensemble, glorifient Dieu,"
       ],
       [
        "le Seigneur donnera sa bénédiction ",
