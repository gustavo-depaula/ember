  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Súscipe, Dómine, quǽsumus, hóstias pro salúte tuæ plebis oblátas, quibus nos, intercedénte beáto ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", et peccándi illécebras fúgere valeámus et cæléstibus propinquáre consórtiis. Per Christum."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Receive, O Lord, we pray, the offerings made for the salvation of your people, so that through the intercession of blessed ",
        {
         "m": "rubric",
         "t": "N."
        },
        " we may flee the enticements of sin and draw near to the company of heaven."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Recibe, Señor, las ofrendas que te presentamos"
       ],
       [
        "por la salvación de tu pueblo;"
       ],
       [
        "con ellas te pedimos,"
       ],
       [
        "por intercesión de san ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "alejarnos de la seducción del pecado"
       ],
       [
        "y tomar parte en los bienes del cielo."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Recibe, Señor, las ofrendas que te presentamos"
       ],
       [
        "por la salvación de tu pueblo;"
       ],
       [
        "con ellas te pedimos,"
       ],
       [
        "por intercesión de sanAccogli, o Signore, l'offerta che ti presentiamo per la salvezza del tuo popolo e concedi che, per l'intercessione di san ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "il sacrificio che celebriamo ci renda capaci di fuggire le seduzioni del peccato e affretti in noi la partecipazione ai beni del cielo. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Reçois, nous t'en prions, Seigneur,"
       ],
       [
        "le sacrifice offert pour le salut de ton peuple :"
       ],
       [
        "qu'il nous obtienne, par l'intercession de saint ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "d'éviter les séductions du péché"
       ],
       [
        "et de nous rapprocher de la vie du ciel."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ]
   },
