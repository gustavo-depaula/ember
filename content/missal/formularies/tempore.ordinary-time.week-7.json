  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Narrábo ómnia mirabília tua. Lætábor et exsultábo in te, psallam nómini tuo, Altíssime."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, de coração vos darei graças,"
       ],
       [
        "as vossas maravilhas cantarei!"
       ],
       [
        "Em vós exultarei de alegria,"
       ],
       [
        "cantarei ao vosso nome, Deus Altíssimo!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "I will recount all your wonders,"
       ],
       [
        "I will rejoice in you and be glad,"
       ],
       [
        "and sing psalms to your name, O Most High."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Proclamo todas tus maravillas, me alegro y exulto contigo, y toco en honor de tu nombre, oh Altísimo."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Annuncerò tutte le tue meraviglie. In te gioisco ed esulto, canto inni al tuo nome, o Altissimo."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "De tout mon cœur, Seigneur, je rendrai grâce,"
       ],
       [
        "je dirai tes innombrables merveilles ;"
       ],
       [
        "pour toi, j'exulterai, je danserai,"
       ],
       [
        "je fêterai ton nom, Dieu Très-Haut."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, verkünden will ich all deine Wunder. Ich will jauchzen und an dir mich freuen, für dich, du Höchster, will ich singen und spielen."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
