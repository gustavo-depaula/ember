  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Dómine, ego crédidi quia tu es Christus Fílius Dei vivi, qui in hunc mundum venísti."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, eu creio que tu és o Messias,"
       ],
       [
        "o Filho de Deus, que devia vir ao mundo."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Lord, I have come to believe that you are the Christ,"
       ],
       [
        "the Son of the living God, who is coming into this world."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Señor, yo creo que tú eres el Cristo, el Hijo de Dios, el que tenía que venir al mundo."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "O Signore, io credo che tu sei il Cristo, il Figlio del Dio vivente,"
       ],
       [
        "colui che viene nel mondo."
       ],
       [
        {
         "m": "rubric",
         "t": "★ A Cf. Mt 5, 46"
        }
       ],
       [
        "«Se amate quelli che vi amano,"
       ],
       [
        "quale merito ne avete?», dice il Signore."
       ],
       [
        {
         "m": "rubric",
         "t": "★ B Mc 2, 12"
        }
       ],
       [
        "Tutti si meravigliarono"
       ],
       [
        "e lodavano Dio, dicendo:"
       ],
       [
        "«Non abbiamo mai visto nulla di simile!»."
       ],
       [
        {
         "m": "rubric",
         "t": "★ C Lc 6, 36"
        }
       ],
       [
        "«Siate misericordiosi,"
       ],
       [
        "come è misericordioso il Padre vostro», dice il Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Seigneur, je le crois : tu es le Christ, le Fils du Dieu vivant,"
       ],
       [
        "celui qui vient dans le monde."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Ja, Herr, ich glaube, dass du der Messias bist, der Sohn Gottes, der in die Welt kommen soll."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
