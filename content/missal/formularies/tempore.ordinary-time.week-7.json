  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Dómine, in tua misericórdia sperávi. Exsultávit cor meum in salutári tuo, cantábo Dómino, qui bona tríbuit mihi."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Confiei no vosso amor, Senhor."
       ],
       [
        "Meu coração por vosso auxílio rejubile,"
       ],
       [
        "E que eu vos cante pelo bem que me fizestes!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "O Lord, I trust in your merciful love."
       ],
       [
        "My heart will rejoice in your salvation."
       ],
       [
        "I will sing to the Lord who has been bountiful with me."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Señor, yo confío en tu misericordia: mi alma gozará con tu salvación, y cantaré al Señor por el bien que me ha hecho."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Io nella tua fedeltà ho confidato; esulterà il mio cuore nella tua salvezza, canterò al Signore, che mi ha beneficato."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Seigneur, j'ai mis mon espoir en ta miséricorde ;"
       ],
       [
        "mon cœur a exulté dans ton salut !"
       ],
       [
        "Je chanterai le Seigneur"
       ],
       [
        "pour le bien qu'il m'a fait."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, ich baue auf deine Huld, mein Herz soll über deine Hilfe frohlocken. Singen will ich dem Herrn, weil er mir Gutes getan hat."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
