       [
        "Abide graciously, O Lord, with your people, who have touched the sacred mysteries,"
       ],
       [
        "that no dangers may bring affliction"
       ],
       [
        "to those who trust in you, their protector."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
