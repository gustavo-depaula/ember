  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Tua misericórdia, Deus, pópulum tibi súbditum"
       ],
       [
        "et ab omni subreptióne vetustátis expúrget,"
       ],
       [
        "et capácem sanctæ novitátis effíciat."
       ],
       [
        "Per Christum."
       ]
      ]
     }
    ],
