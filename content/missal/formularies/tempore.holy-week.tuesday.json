  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Próprio Fílio suo non pepércit Deus, sed pro nobis ómnibus trádidit illum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Deus não poupou seu próprio Filho,"
       ],
       [
        "mas o entregou por todos nós."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "God did not spare his own Son, but handed him over for us all."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Dios no se reservó a su propio Hijo, sino que lo entregó por todos nosotros."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Dio non ha risparmiato il proprio Figlio, ma lo ha consegnato per tutti noi."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "Ora il Figlio dell'uomo è stato glorificato, e Dio è stato glorificato in lui."
       ]
      ],
      "cite": "Gv 13, 31"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Dieu n'a pas épargné son propre Fils,"
       ],
       [
        "mais il l'a livré pour nous tous."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Gott hat seinen eigenen Sohn nicht geschont, sondern ihn für alle hingegeben."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
