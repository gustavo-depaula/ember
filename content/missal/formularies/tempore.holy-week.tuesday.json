  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ne tradíderis me, Dómine, in ánimas persequéntium me: quóniam insurrexérunt in me testes iníqui, et mentíta est iníquitas sibi."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Não me entregueis, Senhor, às mãos dos que me perseguem,"
       ],
       [
        "pois contra mim se levantaram falsas testemunhas,"
       ],
       [
        "mas volta-se contra eles a sua iniquidade."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Do not leave me to the will of my foes, O Lord, for false witnesses rise up against me"
       ],
       [
        "and they breathe out violence."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "No me entregues, Señor, a la saña de mis adversarios, porque se levantan contra mí testigos falsos, que respiran violencia."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Non gettarmi in preda ai miei avversari. Contro di me si sono alzati falsi testimoni che soffiano violenza."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Seigneur, ne me livre pas à la merci de l'adversaire :"
       ],
       [
        "contre moi se sont levés de faux témoins"
       ],
       [
        "qui soufflent la violence."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Überlass mich nicht meinen gierigen Gegnern; denn falsche Zeugen stehen gegen mich auf und wüten."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
