        {
         "m": "link",
         "t": "3",
         "to": "common.virgins.3"
        },
        {
         "m": "rubric",
         "t": ", ou Comum dos Santos e Santas:"
        },
        " ",
        {
         "m": "link",
         "t": "para uma monja",
         "to": "common.holy-men-and-women.9"
        },
