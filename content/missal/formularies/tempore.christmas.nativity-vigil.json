        }
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "The Creed is said. All kneel at the words \"and by the Holy Spirit was incarnate\"."
        }
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Se dice Credo. A las palabras: \"Y por obra...\" todos se arrodillan."
        }
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Si dice il Credo. Alle parole \"E per opera dello Spirito Santo… si è fatto uomo\", si genuflette."
        }
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "On récite le Credo. On s'agenouille à : il a pris chair de la Vierge Marie."
        }
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Credo. Niederknien zu den Worten \"hat Fleisch angenommen\" bzw. \"empfangen durch den Heiligen Geist\"."
        }
       ]
      ]
     }
    ]
   },
