{"id":"sanctorale.05-15.united-states","source":"santos/santos_may#0515Z","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of the United States]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["May 15"],["Saint Isidore"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"From the Common of Holy Men and Women:"}],[{"m":"link","t":"1","to":"common.holy-men-and-women.5"},{"m":"link","t":"2","to":"common.holy-men-and-women.6"}],[{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Graciously hear the prayers, O Lord,"],["which we make in commemoration of Saint Isidore,"],["that your Church may be aided by his intercession,"],["just as she has been instructed by his heavenly teaching."],["Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"slot":"82","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"83","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Qui in Sanctórum concílio celebráris,...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Tu enim Sanctórum tuórum confessióne...","to":"preface.53"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...Na assembleia dos Santos...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Pois, pelo testemunho admirável...","to":"preface.53"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"SAINTS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For you are praised in the company...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For in the marvellous confession of...","to":"preface.53"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque eres glorificado en la asamblea...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Porque mediante el testimonio admirable de tus santos...","to":"preface.53"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI SANTI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nella festosa assemblea dei santi...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Nella testimonianza di fede dei tuoi santi...","to":"preface.53"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Saints"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Car tu es glorifié dans l'assemblée des saints...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Tu ne cesses de fortifier ton Église...","to":"preface.53"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Die Schar der Heiligen verkündet...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Denn in den Heiligen schenkst du der Kirche...","to":"preface.53"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.52","preface.53"],"commons":["common.holy-men-and-women.5","common.holy-men-and-women.6"],"title":{"*":"Saint Isidore"}}
