{"id":"sanctorale.12-02.german-speaking","source":"santos/santos_dic#1202","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In den Diözesen deutscher Sprache]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["2. Dezember"],["Hl. Luzius, Bischof, Märtyrer"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[["Luzius, der Patron von Stadt und Bistum Chur, war nach der Überlieferung der erste Bischof von Chur. Er stammt wahrscheinlich aus dem nördlichen Teil von Churrätien und missionierte im 5. oder 6. Jh. in jener Gegend. Die Reliquien des Bischofs Luzius ruhen in St. Luzi in Chur."]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"Commune-Texte für Bischöfe:"}],[{"m":"link","t":"1","to":"common.pastors.3"},{"m":"link","t":"2","to":"common.pastors.4"}],[{"m":"rubric","t":", oder für Märtyrer:"}],[{"m":"link","t":"1","to":"common.martyrs.6"},{"m":"link","t":"2","to":"common.martyrs.7"}],[{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Tagesgebet"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Gott, du Licht unseres Glaubens, du hast den heiligen Bischof Luzius berufen, der Kirche von Chur durch Wort und Beispiel zu dienen. Seine Fürsprache helfe uns, den Glauben zu bewahren, den er in seiner Predigt gelehrt, und den Weg zu gehen, den er uns durch sein Leben gewiesen hat. Darum bitten wir durch Jesus Christus."]]}]},"part":"collect"},{"slot":"1","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"2","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis martyribus"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Quóniam beáti mártyris N. pro confessióne...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Quóniam tu magnificáris in tuórum...","to":"preface.55"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...O sangue que o Santo Mártir N. derramou...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Vós sois exaltado quando celebramos os santos...","to":"preface.55"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY MARTYRS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For the blood of your blessed...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For you are glorified when your Saints...","to":"preface.55"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque la sangre del glorioso mártir...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Porque tú eres ensalzado en la alabanza de tus santos...","to":"preface.55"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI MARTIRI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... A imitazione del Cristo tuo Figlio...","to":"preface.54"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Martyrs"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nous reconnaissons un signe éclatant de ta grâce...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... En louant tes saints martyrs,...","to":"preface.55"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"MÄRTYRERN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...Im Martyrium des (der) heiligen N. ...","to":"preface.54"}]],"cls":"indicepref"}]},"part":"preface","suggested":true},{"slot":"3","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis pastoribus "},{"m":"link","t":"... Quia sic tríbuis Ecclésiam tuam sancti...","to":"preface.56"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos Pastores "},{"m":"link","t":"...Vós nos concedeis a alegria...","to":"preface.56"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY PASTORS "},{"m":"link","t":"... For, as on the festival of Saint...","to":"preface.56"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Pastores "},{"m":"link","t":"... Porque nos concedes la alegría...","to":"preface.56"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI SANTI PASTORI "},{"m":"link","t":"... Tu doni alla tua Chiesa...","to":"preface.56"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Pasteurs "},{"m":"link","t":"... Tu donnes à ton Église de se réjouir..","to":"preface.56"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HIRTEN DER KIRCHE "},{"m":"link","t":"... am Fest des heiligen N. deine Größe...","to":"preface.56"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.54","preface.55","preface.56"],"commons":["common.pastors.3","common.pastors.4","common.martyrs.6","common.martyrs.7"],"title":{"*":"Hl. Luzius, Bischof, Märtyrer"}}
