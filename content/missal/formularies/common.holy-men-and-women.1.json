   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Iusti epuléntur, et exsúltent in conspéctu Dei, et delecténtur in lætítia ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
