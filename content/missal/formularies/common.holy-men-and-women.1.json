  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Omnípotens sempitérne Deus, Pater totíus consolatiónis et pacis, præsta famíliæ tuæ in celebritáte Sanctórum ad laudem tui nóminis congregátæ, ut, per Unigéniti tui sumpta mystéria, pignus accípiat redemptiónis ætérnæ. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Quem me ama, será amado por meu Pai, e nós viremos e faremos nele a nossa morada ",
        {
         "m": "rubric",
         "t": "( T. P. "
        },
        "aleluia ",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Almighty ever-living God, Father of all consolation and peace, grant your family, gathered to praise your name in celebration of the Saints, that through the mysteries of your Only Begotten Son, which they have here received, they may obtain the pledge of eternal redemption."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Dios todopoderoso y eterno,"
       ],
       [
        "Padre del consuelo y de la paz,"
       ],
       [
        "concede a tu familia,"
       ],
       [
        "reunida en la fiesta de los santos para alabar tu nombre,"
       ],
       [
        "recibir la prenda de la salvación eterna"
       ],
       [
        "en la comunión del sacramento de tu Unigénito."
       ],
       [
        "Él, que vive y reina por los siglos de los siglos."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Dio onnipotente ed eterno, Padre di ogni consolazione e pace, guarda questa tua famiglia riunita per la lode del tuo nome nella festa dei santi",
        {
         "m": "rubric",
         "t": "[N."
        },
        " e ",
        {
         "m": "rubric",
         "t": "N.]"
        },
        " e per la partecipazione ai misteri del tuo Figlio unigenito, donale il pegno della redenzione eterna. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Dieu éternel et tout-puissant,"
       ],
       [
        "Père de tout réconfort et de toute paix,"
       ],
       [
        "accorde à ta famille,"
       ],
       [
        "assemblée pour la louange de ton nom en cette fête des saints,"
       ],
       [
        "de recueillir dans sa communion à ton Fils unique"
       ],
       [
        "le gage de l'éternelle rédemption."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Allmächtiger, ewiger Gott, Vater des Erbarmens und Gott allen Trostes, am Gedenktag des heiligen ",
        {
         "m": "rubric",
         "t": "N."
        },
        " haben wir uns zum Lob deines Namens versammelt. Schenke uns durch den Leib und das Blut deines Sohnes das Unterpfand jener Vollendung, die allen verheißen ist, die dich lieben. Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  }
