   },
   "part": "postcommunion"
  },
  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Refectióne sancta enutrítam, gubérna, quǽsumus, Dómine, tuam placátus Ecclésiam, ut, poténti moderatióne recta, et increménta libertátis accípiat, et in religiónis integritáte persístat. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, governai com bondade a vossa Igreja"
       ],
       [
        "alimentada nesta santa ceia,"
       ],
       [
        "para que, conduzida por vossa mão poderosa,"
       ],
       [
        "cresça na liberdade"
       ],
       [
        "e permaneça firme na integridade da fé."
       ],
       [
        "Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Be pleased, O Lord, we pray,"
       ],
       [
        "to govern the Church you have nourished by this holy meal, so that, firmly directed,"
       ],
       [
        "she may enjoy ever greater freedom"
       ],
       [
        "and persevere in integrity of religion."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Señor, gobierna con bondad a tu Iglesia,"
       ],
       [
        "alimentada en esta mesa santa,"
       ],
       [
        "para que, dirigida por tu mano poderosa,"
       ],
       [
        "tenga cada vez mayor libertad"
       ],
       [
