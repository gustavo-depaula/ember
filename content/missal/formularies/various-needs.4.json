  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Qui manet in me et ego in eo, hic fert fructum multum, quia sine me nihil potéstis fácere, dicit Dóminus."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Aquele que permanece em mim, e eu nele,"
       ],
       [
        "esse produz muito fruto;"
       ],
       [
        "porque sem mim nada podeis fazer, diz o Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Whoever remains in me and i in him bears fruit in plenty, because without me you can do nothing, says the Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "El que permanece en mí y yo en él, ese da fruto abundante; porque sin mí no podéis hacer nada, dice el Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Chi rimane in me, e io in lui, porta molto frutto: senza di me non potete far nulla."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Celui qui demeure en moi"
       ],
       [
        "et en qui je demeure, dit le Seigneur,"
       ],
       [
        "celui-là porte beaucoup de fruit,"
       ],
       [
        "car, en dehors de moi, vous ne pouvez rien faire."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "(So spricht der Herr:) Wer in mir bleibt und in wem ich bleibe, der bringt reiche Frucht; denn getrennt von mir könnt ihr nichts vollbringen."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
