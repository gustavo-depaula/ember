  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Súscipe, quǽsumus, Dómine, múnera pópuli tui, pro sanctórum tuórum ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "et ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "festivitáte deláta, et sincéro nos corde pérfice benígnus accéptos. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Acolhei, Senhor, nós vos pedimos, os dons do vosso povo apresentados na festa dos vossos Santos ",
        {
         "m": "rubric",
         "t": "N."
        },
        " e ",
        {
         "m": "rubric",
         "t": "N."
        },
        "; e, na vossa bondade, fazei que vos agrademos pela sinceridade do coração. Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Receive, O Lord, we pray, the offerings of your people, which we bring for the feast day of Saints ",
        {
         "m": "rubric",
         "t": "N."
        },
        " and ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", and in your kindness render us fully acceptable by giving us sincerity of heart."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Recibe, Señor, los dones de tu pueblo"
       ],
       [
        "ofrecidos en la festividad de tus santos ",
        {
         "m": "rubric",
         "t": "N."
        },
        " y ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "y concédenos agradarte"
       ],
       [
        "con sincero corazón."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Accogli, o Signore, i doni del tuo popolo offerti nella festa dei santi ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "e ",
        {
         "m": "rubric",
         "t": "N. "
        },
        ", e nella tua bontà rendici a te graditi per la sincerità del cuore. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Nous t'en prions, Seigneur,"
       ],
       [
        "accueille les offrandes que ton peuple te présente"
       ],
       [
        "en la fête des saints ",
        {
         "m": "rubric",
         "t": "N."
        },
        " et ",
        {
         "m": "rubric",
         "t": "N."
        },
        " ;"
       ],
       [
        "et, dans ta bonté, donne-nous un cœur pur"
       ],
       [
        "qui te soit agréable."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, unser Gott, nimm die Gaben an, die dein Volk am Gedenktag der Heiligen ",
        {
         "m": "rubric",
         "t": "N."
        },
        " und ",
        {
         "m": "rubric",
         "t": "N."
        },
        " darbringt. Läutere unsere Herzen, damit wir selbst bei dir Aufnahme finden. Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
   },
   "part": "prayerOverOfferings"
  },
