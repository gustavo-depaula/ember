  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Communion Antiphon"
       ]
      ],
      "cite": "Cf. Mt 24:46-47"
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Blessed is the servant whom the Lord finds watching when he comes. Amen I say to you, he will put that servant in charge of all of his property."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Prayer after communion"
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "May partaking at the heavenly table, almighty God,"
       ],
       [
        "confirm and increase strength from on high"
       ],
       [
        "in all who celebrate the feast day of blessed Cyprian Michael,"
       ],
       [
        "that we may preserve in integrity the gift of faith"
       ],
       [
        "and walk in the path of salvation you trace for us."
       ],
       [
        "Through Christ our Lord. Amen."
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  }
