{"id":"sanctorale.01-20.nigeria","source":"santos/santos_africa#0120","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of Nigeria]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["January 20"],["Blessed Cyprian Michael Tansi, Priest"]]}]},"part":"title"},{"text":{"*":[{"k":"h3","lines":[["In Nigeria: Feast"]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Entrance Antiphon"]],"cite":"Cf. Ps. 132:9"}]},"part":"entranceAntiphon"},{"text":{"*":[{"k":"p","lines":[["Your priests, O Lord, shall be clothed with justice; your holy ones shall ring out their joy."]]}]},"part":"entranceAntiphon"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["O God, who joined the apostolic zeal of a pastor"],["to the way of life of a monk in Blessed Cyprian Michael;"],["grant us, by his intercession, that persevering in prayer,"],["we may seek untiringly the coming of your kingdom."],["Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"text":{"*":[{"k":"h4","lines":[["Prayer over the Offerings"]]}]},"part":"prayerOverOfferings"},{"text":{"*":[{"k":"p","lines":[["Receive, O Lord, we pray,"],["the offerings placed on your altar"],["in commemoration of blessed Cyprian Michael,"],["so that as you brought him glory"],["you may, through these sacred mysteries,"],["grant to us your pardon."],["Through Christ our Lord."]]}]},"part":"prayerOverOfferings"},{"slot":"3","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"4","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis pastoribus "},{"m":"link","t":"... Quia sic tríbuis Ecclésiam tuam sancti...","to":"preface.56"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Pastores "},{"m":"link","t":"... Vós nos concedeis a alegria...","to":"preface.56"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY PASTORS "},{"m":"link","t":"... For, as on the festival of Saint...","to":"preface.56"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Pastores "},{"m":"link","t":"... Porque nos concedes la alegría...","to":"preface.56"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI SANTI PASTORI "},{"m":"link","t":"... Tu doni alla tua Chiesa...","to":"preface.56"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis pastoribus "},{"m":"link","t":"... Tu donnes à ton Église de se réjouir..","to":"preface.56"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HIRTEN DER KIRCHE "},{"m":"link","t":"... am Fest des heiligen N. deine Größe...","to":"preface.56"}]],"cls":"indicepref"}]},"part":"preface","suggested":true},{"text":{"*":[{"k":"h4","lines":[["Communion Antiphon"]],"cite":"Cf. Mt 24:46-47"}]},"part":"communionAntiphon"},{"text":{"*":[{"k":"p","lines":[["Blessed is the servant whom the Lord finds watching when he comes. Amen I say to you, he will put that servant in charge of all of his property."]]}]},"part":"communionAntiphon"},{"text":{"*":[{"k":"h4","lines":[["Prayer after communion"]]}]},"part":"postcommunion"},{"text":{"*":[{"k":"p","lines":[["May partaking at the heavenly table, almighty God,"],["confirm and increase strength from on high"],["in all who celebrate the feast day of blessed Cyprian Michael,"],["that we may preserve in integrity the gift of faith"],["and walk in the path of salvation you trace for us."],["Through Christ our Lord. Amen."]]}]},"part":"postcommunion"}],"precedence":8.0,"prefaces":["preface.56"],"title":{"*":"Blessed Cyprian Michael Tansi, Priest"}}
