{"id":"sanctorale.12-01.africa","source":"santos/santos_africa#1201","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of Africa]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["December 1"],["Blessed Clementine Anuarite, Virgin and Martyr"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"From the Common of Martyrs: For a Virgin Martyr or from the Common of"}," ",{"m":"rubric","t":"Virgins: For One Virgin."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["O God our Father,"],["who have called Blessed Anuarite to follow the Lord"],["through a life of holiness, faithfulness and martyrdom;"],["grant, we beseech you,"],["that we may follow Christ as she did"],["and one day join her in your Kingdom."],["Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"slot":"34","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"35","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis martyribus"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Quóniam beáti mártyris N. pro confessióne...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Quóniam tu magnificáris in tuórum...","to":"preface.55"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Pelo (a) mártir S. N....","to":"preface.54"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY MARTYRS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For the blood of your blessed...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For you are glorified when your Saints...","to":"preface.55"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque la sangre del glorioso mártir...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Porque tú eres ensalzado en la alabanza de tus santos...","to":"preface.55"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI MARTIRI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... A imitazione del Cristo tuo Figlio...","to":"preface.54"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des saints martyrs"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nous reconnaissons un signe éclatant de ta grâce...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... En louant tes saints martyrs,...","to":"preface.55"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"MÄRTYRERN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...Im Martyrium des (der) heiligen N. ...","to":"preface.54"}]],"cls":"indicepref"}]},"part":"preface","suggested":true},{"slot":"36","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis virginibus et religiosis "},{"m":"link","t":"... In Sanctis enim, qui Christo se dedicavérunt...","to":"preface.57"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"SANTAS VIRGENS E RELIGIOSOS "},{"m":"link","t":"... Neles, chamais novamente os fiéis...","to":"preface.57"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY VIRGINS AND RELIGIOUS "},{"m":"link","t":"... For in the Saints who consecrated themselves...","to":"preface.57"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santas Vírgenes y Religiosos "},{"m":"link","t":"...Porque celebramos tu providencia admirable...","to":"preface.57"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DELLE SANTE VERGINI E DEI SANTI RELIGIOSI "},{"m":"link","t":"... Nei tuoi santi, che per il regno...","to":"preface.57"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis virginibus et religiosis "},{"m":"link","t":"... Nous célébrons les prévenances de ton amour...","to":"preface.57"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN JUNGFRAUEN UND ORDENSLEUTEN "},{"m":"link","t":"... Inmitten der Kirche berufst du Menschen...","to":"preface.57"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.54","preface.55","preface.57"],"title":{"*":"Blessed Clementine Anuarite, Virgin and Martyr"}}
