{"id":"sanctorale.05-30.spain","source":"santos/santos_may#0530","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"(en las diócesis de España)"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["30 de mayo"],["San Fernando"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[["Fernando III el Santo nació el año 1198 en el reino leonés, probablemente cerca de Valparaíso (Zamora) y murió en Sevilla el 30 de mayo de 1252. Hijo de Alfonso IX de León y de Berenguela, reina de Castilla, unió definitivamente las coronas de ambos reinos. Iniciado el proceso de canonización y probado el culto inmemorial, fue elevado a la gloria de los altares el 4 de febrero de 1671. Es patrono de varias instituciones españolas. También los cautivos, desvalidos y gobernantes le invocan como su especial protector."]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"Común de santos:"}],[{"m":"link","t":"A","to":"common.holy-men-and-women.5"},{"m":"link","t":"B","to":"common.holy-men-and-women.6"}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Oración colecta"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Oh, Dios,"],["que elegiste al rey san Fernando"],["como defensor de tu Iglesia en la tierra,"],["escucha las súplicas de tu pueblo"],["que te pide tenerlo como protector en el cielo."],["Por nuestro Señor Jesucristo."]]}]},"part":"collect"},{"mark":"readings","at":"0530"},{"slot":"149","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"150","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Qui in Sanctórum concílio celebráris,...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Tu enim Sanctórum tuórum confessióne...","to":"preface.53"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...Na assembleia dos Santos...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Pois, pelo testemunho admirável...","to":"preface.53"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"SAINTS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For you are praised in the company...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For in the marvellous confession of...","to":"preface.53"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque eres glorificado en la asamblea...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Porque mediante el testimonio admirable de tus santos...","to":"preface.53"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI SANTI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nella festosa assemblea dei santi...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Nella testimonianza di fede dei tuoi santi...","to":"preface.53"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Saints"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Car tu es glorifié dans l'assemblée des saints...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Tu ne cesses de fortifier ton Église...","to":"preface.53"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Die Schar der Heiligen verkündet...","to":"preface.52"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Denn in den Heiligen schenkst du der Kirche...","to":"preface.53"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"lectionary":"sanctorale.05-30.spain","prefaces":["preface.52","preface.53"],"commons":["common.holy-men-and-women.5","common.holy-men-and-women.6"],"title":{"*":"San Fernando"}}
