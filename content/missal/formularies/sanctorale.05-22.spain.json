{"id":"sanctorale.05-22.spain","source":"santos/santos_may#0522","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"(en las diócesis de España)"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["22 de mayo"],["Santa Joaquina Vedruna, religiosa"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[["Joaquina Vedruna y de Mas nació en Barcelona el año 1783. Como esposa y madre fue modelo de abnegación, prudencia y delicadeza. En el año 1826 fundó el Instituto de las Hermanas Carmelitas de la Caridad, dedicado al cuidado de los enfermos y a la educación de las jóvenes. Murió en Barcelona en 1854."]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"Común de santos: religiosos"}],[{"m":"link","t":"1","to":"common.holy-men-and-women.10"},{"m":"link","t":"2","to":"common.holy-men-and-women.11"}],[{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Oración colecta"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Señor,"],["tú que has hecho surgir en la Iglesia a santa Joaquina Vedruna"],["para la educación cristiana de la juventud y el alivio de los enfermos,"],["haz que sepamos imitar sus ejemplos"],["y dediquemos nuestra vida"],["a servir con amor a nuestros hermanos."],["Por nuestro Señor Jesucristo."]]}]},"part":"collect"},{"mark":"readings","at":"0522"},{"text":{"*":[{"k":"h4","lines":[["Oración sobre las ofrendas"]]}]},"part":"prayerOverOfferings"},{"text":{"*":[{"k":"p","lines":[["Acepta, Señor,"],["estos dones con los que vamos a celebrar"],["el memorial del amor de tu Hijo,"],["y concede a cuantos participamos en estos misterios"],["que, a ejemplo de santa Joaquina Vedruna,"],["sepamos amarte sobre todas las cosas"],["y a todas las personas por amor a ti."],["Por Jesucristo, nuestro Señor."]],"cls":"agrupado_post"}]},"part":"prayerOverOfferings"},{"slot":"106","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"107","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis virginibus et religiosis "},{"m":"link","t":"... In Sanctis enim, qui Christo se dedicavérunt...","to":"preface.57"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Das Santas Virgens e Religiosos "},{"m":"link","t":"...Recordando os santos e santas...","to":"preface.57"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY VIRGINS AND RELIGIOUS "},{"m":"link","t":"... For in the Saints who consecrated themselves...","to":"preface.57"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santas Vírgenes y Religiosos "},{"m":"link","t":"...Porque celebramos tu providencia admirable...","to":"preface.57"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DELLE SANTE VERGINI E DEI SANTI RELIGIOSI "},{"m":"link","t":"... Nei tuoi santi, che per il regno...","to":"preface.57"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des religieux "},{"m":"link","t":"... Nous célébrons les prévenances de ton amour...","to":"preface.57"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN JUNGFRAUEN UND ORDENSLEUTEN "},{"m":"link","t":"... Inmitten der Kirche berufst du Menschen...","to":"preface.57"}]],"cls":"indicepref"}]},"part":"preface","suggested":true},{"text":{"*":[{"k":"h4","lines":[["Oración después de la comunión"]]}]},"part":"postcommunion"},{"text":{"*":[{"k":"p","lines":[["Te pedimos, Señor, que esta eucaristía"],["acreciente tu vida en nosotros"],["y que, por nuestras palabras y acciones,"],["seamos, como santa Joaquina,"],["amor para los que nos rodean"],["y luz para los que nos contemplan."],["Por Jesucristo, nuestro Señor."]]}]},"part":"postcommunion"}],"precedence":12.0,"lectionary":"sanctorale.05-22.spain","prefaces":["preface.57"],"commons":["common.holy-men-and-women.10","common.holy-men-and-women.11"],"title":{"*":"Santa Joaquina Vedruna, religiosa"}}
