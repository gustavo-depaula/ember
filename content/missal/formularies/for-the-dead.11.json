  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Sacrifícium tibi, Dómine, pro fámulo tuo ",
        {
         "m": "rubric",
         "t": "N."
        },
        " supplíciter offérimus, ut, qui te iam dono tuæ illuminatiónis agnóvit, tibi adhærére perpétuo lætétur. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, humildemente vos oferecemos este sacrifício pelo vosso servo ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", para que, tendo-vos conhecido pelo dom da vossa luz, alegre-se eternamente no vosso convívio. Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "We humbly offer you sacrifice, O Lord,"
       ],
       [
        "for ",
        {
         "m": "rubric",
         "t": "N."
        },
        " your servant,"
       ],
       [
        "that he ",
        {
         "m": "rubric",
         "t": "("
        },
        "she",
        {
         "m": "rubric",
         "t": ")"
        },
        ", who by your gift of the light of faith already knew you,"
       ],
       [
        "may rejoice in holding fast to you for ever."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Te ofrecemos humildemente, Señor,"
       ],
       [
        "este sacrificio por tu siervo ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "para que se alegre en eterna unión contigo"
       ],
       [
        "quien te conoció por la luz del don de la fe."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ti offriamo, o Signore, il sacrificio per il nostro fratello [",
        {
         "m": "rubric",
         "t": "["
        },
        "la nostra sorella",
        {
         "m": "rubric",
         "t": "] N."
        },
        ", e umilmente ti preghiamo: tu, che lo hai illuminato ",
        {
         "m": "rubric",
         "t": "["
        },
        "l'hai illuminata]",
        {
         "m": "rubric",
         "t": "]"
        },
        "con il dono della fede, concedi a lui ",
        {
         "m": "rubric",
         "t": "["
        },
        "lei",
        {
         "m": "rubric",
         "t": "]"
        },
        " la gioia di essere per sempre con te in paradiso. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Seigneur, nous t'offrons ce sacrifice"
       ],
       [
        "en priant pour ton serviteur ",
        {
         "m": "rubric",
         "t": "N."
        },
        " ;"
       ],
       [
        "tu lui avais déjà donné ta lumière"
       ],
       [
        "qui lui permettait de te connaître :"
       ],
       [
        "donne-lui maintenant"
       ],
       [
        "le bonheur de s'attacher à toi pour toujours."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, unser Gott, wir bringen das Opfer dar für unseren Bruder ",
        {
         "m": "rubric",
         "t": "("
        },
        "unsere Schwester",
        {
         "m": "rubric",
         "t": ") N."
        },
        " Du hast ihm ",
        {
         "m": "rubric",
         "t": "("
        },
        "ihr",
        {
         "m": "rubric",
         "t": ")"
        },
        " in der Taufe das Licht des Glaubens geschenkt; führe ihn ",
        {
         "m": "rubric",
         "t": "("
        },
        "sie",
        {
         "m": "rubric",
         "t": ")"
        },
        " vom Glauben zum Schauen und lass ihn ",
        {
         "m": "rubric",
         "t": "("
        },
        "sie",
        {
         "m": "rubric",
         "t": ")"
        },
        " auf ewig bei dir sein. Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
   },
   "part": "prayerOverOfferings"
  },
