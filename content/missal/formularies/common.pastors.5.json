    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Súmpsimus, Dómine, sanctórum tuórum ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "et ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "memóriam celebrántes, sacraménta cæléstia; præsta, quǽsumus, ut, quod temporáliter gérimus, ætérnis gáudiis consequámur. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, pelos celestes sacramentos que recebemos na comemoração dos vossos Santos ",
        {
         "m": "rubric",
         "t": "N."
        },
        " e ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", nós vos pedimos que esta celebração na terra nos alcance as alegrias do céu. Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "We have received this heavenly Sacrament, O Lord, as we commemorate your Saints ",
        {
         "m": "rubric",
         "t": "N."
        },
        " and ",
        {
         "m": "rubric",
         "t": "N."
        },
        "; grant, we pray, that what we celebrate in time we may attain with eternal joy."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Hemos recibido, Señor, los sacramentos del cielo"
       ],
       [
        "celebrando la memoria de tus santos ",
        {
         "m": "rubric",
         "t": "N."
        },
        " y ",
        {
         "m": "rubric",
         "t": "N."
        },
        ";"
       ],
       [
        "concédenos gozar en la eternidad"
       ],
       [
        "de lo que hemos celebrado en este mundo."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ci siamo nutriti, o Signore, dei tuoi sacramenti celebrando la memoria dei santi ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "e ",
        {
         "m": "rubric",
         "t": "N. "
        },
        ": fa' che gustiamo nella gioia eterna il mistero che ci conforta nel pellegrinaggio terreno. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Nous avons reçu, Seigneur, le sacrement du ciel"
       ],
       [
        "en faisant mémoire des saints ",
        {
         "m": "rubric",
         "t": "N."
        },
        " et ",
