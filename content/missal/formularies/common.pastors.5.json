  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Dabo vobis pastóres iuxta cor meum, et pascent vos sciéntia et doctrína ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "allelúia",
        {
         "m": "rubric",
         "t": "). "
        }
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Eu vos darei pastores segundo o meu coração, que vos apascentarão com clarividência e sabedoria ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "aleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "I will appoint over you shepherds after my own heart, who will shepherd you wisely and prudently ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Os daré pastores según mi corazón, que os apacienten con ciencia y"
       ],
       [
        "doctrina ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Vi darò pastori secondo il mio cuore, che vi guideranno con scienza e intelligenza ",
        {
         "m": "rubric",
         "t": "( T. P."
        },
        "Alleluia ",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Je vous donnerai des pasteurs selon mon cœur ;"
       ],
       [
        "ils vous conduiront avec sagesse et intelligence ",
