  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Sacerdótes Dei, benedícite Dóminum; sancti et húmiles corde, laudáte Deum ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "allelúia",
        {
         "m": "rubric",
         "t": "). "
        }
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Sacerdotes de Deus, bendizei o Senhor; santos e humildes, louvai o Senhor ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "aleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Priests of God, bless the Lord; praise the Lord, all who are holy and humble of heart ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Sacerdotes del Señor, bendecid al Señor, santos y humildes de corazón, bendecid al Señor ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Benedite, sacerdoti del Signore, il Signore; lodate Dio, santi e umili di cuore ",
        {
         "m": "rubric",
         "t": "( T. P."
        },
        "Alleluia ",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Prêtres du Seigneur, bénissez le Seigneur !"
       ],
       [
        "Saints et humbles de cœur, louez Dieu ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "alléluia",
        {
         "m": "rubric",
         "t": "). "
        }
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Preist den Herrn, ihr Priester; preist den Herrn, ihr Frommen und Demütigen."
       ]
      ]
     }
    ]
