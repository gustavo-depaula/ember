  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Laudis tibi, Dómine, hóstias offérimus in tuórum commemoratióne Sanctórum, quibus nos et præséntibus éxui malis confídimus et futúris. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor, na comemoração dos vossos santos,"
       ],
       [
        "nós vos oferecemos este sacrifício de louvor;"
       ],
       [
        "por ele confiamos ser libertos"
       ],
       [
        "dos males presentes e futuros."
       ],
       [
        "Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "We offer you a sacrifice of praise in commemoration of your Saints, O Lord, by which we trust to be delivered from evils both present and to come."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Te ofrecemos, Señor,"
       ],
       [
        "este sacrificio de alabanza"
       ],
       [
        "en la conmemoración de tus santos;"
       ],
       [
        "por ellos confiamos vernos libres"
       ],
       [
        "de los males presentes y futuros."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ti offriamo, o Signore, il sacrificio di lode nella memoria dei tuoi santi: donaci per loro intercessione di essere liberati dai mali presenti e futuri. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "En célébrant, Seigneur, la mémoire des saints,"
       ],
       [
        "nous t'offrons ce sacrifice de louange ;"
       ],
       [
        "par lui, délivre-nous du mal aujourd'hui et demain,"
       ],
       [
        "comme nous en avons l'espérance."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Allmächtiger Gott, nimm die Gaben deines Volkes an, die es dir am Gedenktag der heiligen (Bischöfe) ",
        {
         "m": "rubric",
         "t": "N."
        },
        " und ",
        {
         "m": "rubric",
         "t": "N."
        },
        " darbringt. Nimm sie entgegen und schenke uns durch dieses Opfer das ewige Heil. Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
   },
   "part": "prayerOverOfferings"
  },
  {
