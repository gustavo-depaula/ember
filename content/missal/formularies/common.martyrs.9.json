      "k": "p",
      "lines": [
       [
        "Allmächtiger Gott, am Festtag der heiligen Märtyrer ",
        {
         "m": "rubric",
         "t": "N."
        },
        " und ",
        {
         "m": "rubric",
         "t": "N."
        },
