      "k": "p",
      "lines": [
       [
        "Si commórtui sumus cum Christo, et convivémus; si sustinémus, et conregnábimus, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
