  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Gaudéte, Sancti, ante conspéctum Agni; parátum est vobis regnum ab orígine mundi, allelúia."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Alegrai-vos, ó santos, na presença do Cordeiro;"
       ],
       [
        "o reino vos foi preparado desde a criação do mundo, aleluia."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Rejoice, you Saints, in the presence of the Lamb; a kingdom has been prepared for you from the foundation of the world, alleluia."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Alegraos, santos, en presencia del Cordero: el reino está preparado para vosotros desde la creación del mundo. Aleluya."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Gioite, santi, al cospetto dell'Agnello: ricevete in eredità il regno preparato per voi fin dalla creazione del mondo. Alleluia."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Saints du Seigneur, réjouissez vous en présence de l'Agneau :"
       ],
       [
        "le Royaume est préparé pour vous"
       ],
       [
        "depuis la fondation du monde, alléluia."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
