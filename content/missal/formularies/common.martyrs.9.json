   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Uníus panis alimónia refécti, in commemoratióne beatórum mártyrum ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "et ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "supplíciter te, Dómine, deprecámur, ut nos in tua iúgiter caritáte confírmes, et in novitáte vitæ concédas ambuláre. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Saciados com o alimento do mesmo pão, na comemoração dos santos mártires ",
        {
         "m": "rubric",
         "t": "N."
        },
        " e ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", humildemente vos suplicamos, Senhor, confirmai-nos sempre na vossa caridade e concedei-nos caminhar na vida nova. Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Renewed by the sustenance of the one Bread, O Lord, on the commemoration of the blessed Martyrs ",
        {
         "m": "rubric",
         "t": "N."
        },
        " and ",
        {
         "m": "rubric",
         "t": "N."
        },
        ", we humbly pray, that you may confirm us ever in your charity and make us walk in newness of life."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Alimentados con un mismo Pan"
       ],
       [
        "en la conmemoración de los santos mártires ",
        {
         "m": "rubric",
         "t": "N."
        },
        " y ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "te pedimos humildemente, Señor,"
       ],
       [
        "que nos mantengas siempre unidos en tu amor"
       ],
       [
        "y nos concedas caminar en una vida nueva."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Nutriti dell'unico pane nella memoria dei santi martiri ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "e ",
        {
         "m": "rubric",
         "t": "N. "
        },
        ", ti supplichiamo, o Signore, di confermarci sempre nel tuo amore, perché possiamo camminare in novità di vita. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Nourris et fortifiés par un même pain"
       ],
       [
        "en la mémoire des saints martyrs ",
        {
         "m": "rubric",
         "t": "N."
        },
        " et ",
        {
         "m": "rubric",
         "t": "N."
        },
        ","
       ],
       [
        "nous te supplions, Seigneur :"
       ],
       [
        "affermis-nous sans cesse dans ton amour"
       ],
       [
        "et fais-nous avancer dans la vie nouvelle."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
