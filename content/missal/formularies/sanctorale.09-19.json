    "pt-BR": [
     {
      "k": "h2",
      "lines": [
       [
        "19 de setembro"
       ],
       [
        "São Januário, bi5po e mártir"
       ]
      ]
     },
     {
      "k": "p",
      "lines": [
       [
        "Januário, bispo de Benevento, sofreu o martírio em Pozzuoli, Nápoles (Itália). É particularmente venerado na diocese de Nápoles, onde estão guardadas suas relíquias, conhecidas especialmente pela liquefação do sangue. Seu sepultamento em 19 de setembro é recordado pelo Martirológio Jeronimiano (séc. VI)."
       ]
      ]
     },
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Comum dos Mártires:"
