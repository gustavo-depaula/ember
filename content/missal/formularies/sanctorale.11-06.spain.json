       [
        "Die 6 novembris"
       ],
       [
        "Sanctorum Petri Poveda Castroverde, Innocentii ab Immaculata Canoura Arnau, presbyterorum, et sociorum, martyrum"
       ]
      ]
     },
     {
      "k": "h3",
      "lines": [
       [
        "Memoria"
       ]
      ]
     },
     {
      "k": "p",
      "lines": [
       [
        "Sancti Petrus, presbyter dioecesanus et fundator Instituti Teresiani, et Innocentius ab Immaculata, religiosus e Congregatione Passioni Iesu Christi, primitiae sunt multitudinis sanctorum beatorumque martyrum, qui, episcopi presbyterique religiosique et laici, Christo summum testimonium amoris praebentes, inter annos 1931 et 1939 in Hispania, persecutione contra Ecclesiam grassante, in odium fidei interempti sunt."
       ]
      ]
     },
