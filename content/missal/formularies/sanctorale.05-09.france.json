{
 "id": "sanctorale.05-09.france",
 "kind": "sanctoral",
 "items": [
  {
   "text": {
    "*": [
     {
      "k": "h2",
      "lines": [
       [
        "9 mai"
       ],
       [
        "Sainte Louise de Marillac"
       ]
      ]
     }
    ]
   },
   "part": "title"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Mémoire facultative en France"
        }
       ]
      ]
     }
    ]
   },
   "part": "title",
   "role": "rubric"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Louise de Marillac, née à Paris en 1591, mariée puis devenue veuve en 1625, se dévoua sans réserve aux œuvres charitables. Elle fonda, avec saint Vincent de Paul, l'institut des Filles de la Charité, connues aussi sous le nom de Sœurs de Saint-Vincent-de-Paul. Elle mourut le 15 mars 1660 et a été canonisée en 1934."
       ]
      ]
     }
    ]
   },
   "part": "title"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Commun des saints: femmes"
        },
        " ",
        {
         "m": "link",
         "t": "1",
         "to": "common.holy-men-and-women.14"
        },
        {
         "m": "link",
         "t": "2",
         "to": "common.holy-men-and-women.15"
        },
        {
         "m": "rubric",
         "t": ", vel Religieux"
        },
        " ",
        {
         "m": "link",
         "t": "1",
         "to": "common.holy-men-and-women.10"
        },
        {
         "m": "link",
         "t": "2",
         "to": "common.holy-men-and-women.11"
        },
        {
         "m": "rubric",
         "t": "."
        }
       ]
      ]
     }
    ]
   },
   "part": "title"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Antienne d'ouverture"
       ]
      ],
      "cite": "cf. Pr 31, 30.28"
     }
    ]
   },
   "part": "entranceAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "La femme qui craint le Seigneur"
       ],
       [
        "mérite la louange."
       ],
       [
        "Ses fils la disent bienheureuse"
       ],
       [
        "et son mari fait son éloge, alléluia."
       ],
       [
        {
         "m": "rubric",
         "t": "Ou bien :"
        }
       ],
       [
        "Ses doigts s’ouvrent en faveur du pauvre,"
       ],
       [
        "elle tend la main au malheureux."
       ],
       [
        "elle ne mange pas le pain de l’oisiveté, alléluia."
       ]
      ],
      "cite": "cf. Pr 31, 20.27"
     }
    ]
   },
   "part": "entranceAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Prière d'ouverture (Collecte)"
       ]
      ]
     }
    ]
   },
   "part": "collect"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Seigneur Dieu,"
       ],
       [
        "toi qui es source de la charité et qui la récompenses,"
       ],
       [
        "tu as suscité dans ton Église"
       ],
       [
        "sainte Louise de Marillac"
       ],
       [
        "pour fonder une nouvelle famille religieuse,"
       ],
       [
        "vouée au service des pauvres"
       ],
       [
        "et de toute personne en détresse;"
       ],
       [
        "nous t'en prions, accorde-nous"
       ],
       [
        "de pratiquer une charité active,"
       ],
       [
        "et d'obtenir au ciel"
       ],
       [
        "la récompense que tu promets."
       ],
       [
        "Par Jésus Christ, ton Fils, notre Seigneur,"
       ],
       [
        "qui vit et règne avec toi dans l’unité du Saint-Esprit,"
       ],
       [
        "Dieu, pour les siècles des siècles."
       ]
      ]
     }
    ]
   },
   "part": "collect"
  },
  {
   "mark": "readings"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Prière sur les offrandes"
       ]
      ]
     }
    ]
   },
   "part": "prayerOverOfferings"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Nous te présentons, Seigneur, ce sacrifice"
       ],
       [
        "en mémoire de sainte Louise de Marillac,"
       ],
       [
        "et nous te supplions humblement :"
       ],
       [
        "qu’avec ton pardon,"
       ],
       [
        "il nous apporte le salut."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ]
   },
   "part": "prayerOverOfferings"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Préface"
       ]
      ]
     }
    ]
   },
   "part": "preface"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Des Saints"
        }
       ]
      ]
     }
    ]
   },
   "part": "preface",
   "role": "rubric"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Antienne de la communion"
       ]
      ],
      "cite": "cf. Mt 13, 45-46"
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Le royaume des Cieux est comparable"
       ],
       [
        "à un négociant qui recherche des perles fines."
       ],
       [
        "Ayant trouvé une perle de grande valeur,"
       ],
       [
        "il va vendre tout ce qu’il possède,"
       ],
       [
        "et il achète la perle."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
   "text": {
    "*": [
     {
      "k": "h4",
      "lines": [
       [
        "Prière après la communion"
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Dieu tout-puissant,"
       ],
       [
        "que l’action du sacrement divin"
       ],
       [
        "nous apporte lumière et ferveur"
       ],
       [
        "en cette fête de sainte Louise de Marillac,"
       ],
       [
        "pour que nous brûlions toujours du désir de la sainteté"
       ],
       [
        "et fassions en abondance toute sorte de bien."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ]
   },
   "part": "postcommunion"
  }
 ],
 "prefaces": [
  "preface.52",
