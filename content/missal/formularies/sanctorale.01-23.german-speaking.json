{"id":"sanctorale.01-23.german-speaking","source":"santos/santos_ene#0123Z","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In den Diözesen deutscher Sprache]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["23. Januar"],["Sel. Heinrich Seuse, Ordenspriester, Mystiker"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[["Der begnadete Dominikaner, Mystiker und Schüler Meister Ekkeharts in Köln, durchwanderte als rastloser Prediger und Seelsorger besonders das Gebiet am Oberrhein und kam auch bis in die Niederlande. Seine bekannteste Schrift ist das “Büchlein der Ewigen Weisheit”. Er starb am 25. Januar 1366 in Ulm."]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"Commune-Texte für Ordensleute:"}],[{"m":"link","t":"1","to":"common.holy-men-and-women.10"},{"m":"link","t":"2","to":"common.holy-men-and-women.11"}],[{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Tagesgebet"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Gott, du Quell der Weisheit, du hast den seligen Heinrich Seuse in deine Nähe gerufen und ihn zu einem Leben der Buße ermutigt. Lass auch uns in der Nachfolge deines gekreuzigten Sohnes den Trost deiner Gegenwart erfahren. Darum bitten wir durch Jesus Christus."]]}]},"part":"collect"},{"slot":"90","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"91","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis virginibus et religiosis "},{"m":"link","t":"... In Sanctis enim, qui Christo se dedicavérunt...","to":"preface.57"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Das Santas Virgens e Religiosos "},{"m":"link","t":"...Recordando os santos e santas...","to":"preface.57"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY VIRGINS AND RELIGIOUS "},{"m":"link","t":"... For in the Saints who consecrated themselves...","to":"preface.57"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santas Vírgenes y Religiosos "},{"m":"link","t":"...Porque celebramos tu providencia admirable...","to":"preface.57"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DELLE SANTE VERGINI E DEI SANTI RELIGIOSI "},{"m":"link","t":"... Nei tuoi santi, che per il regno...","to":"preface.57"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des religieux "},{"m":"link","t":"... Nous célébrons les prévenances de ton amour...","to":"preface.57"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN JUNGFRAUEN UND ORDENSLEUTEN "},{"m":"link","t":"... Inmitten der Kirche berufst du Menschen...","to":"preface.57"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.57"],"commons":["common.holy-men-and-women.10","common.holy-men-and-women.11"],"title":{"*":"Sel. Heinrich Seuse, Ordenspriester, Mystiker"}}
