  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Diléxit nos Deus, et misit Fílium suum propitiatiónem pro peccátis nostris."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Deus nos amou e enviou o seu Filho"
       ],
       [
        "como vítima de reparação pelos nossos pecados."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "God loved us, and sent his Son as expiation for our sins."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Dios nos amó y nos envió a su Hijo como víctima de propiciación por nuestros pecados."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Dio ci ha amati e ha mandato il suo Figlio, vittima di espiazione per i nostri peccati."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "La pietra scartata dai costruttori è divenuta la pietra d'angolo."
       ]
      ],
      "cite": "Cf. Mt 21, 42"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Dieu nous a aimés et il a envoyé son Fils"
       ],
       [
        "en sacrifice de pardon pour nos péchés."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Gott hat uns geliebt und seinen Sohn gesandt als Sühne für unsere Sünden."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
