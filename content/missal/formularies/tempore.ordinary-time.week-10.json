  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Dóminus firmaméntum meum, et refúgium meum, et liberátor meus. Deus meus adiútor meus."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Ó meu Deus, sois o rochedo que me abriga,"
       ],
       [
        "minha força e poderosa salvação,"
       ],
       [
        "sois meu escudo e proteção, em vós espero!"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "The Lord is my rock, my fortress, and my deliverer; my God is my saving strength"
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Señor, mi roca, mi alcázar, mi libertador. Dios mío, peña mía."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Signore, mia roccia, mia fortezza, mio liberatore, mio Dio, mia rupe, in cui mi rifugio."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Le Seigneur est ma forteresse,"
       ],
       [
        "mon refuge et mon libérateur."
       ],
       [
        "Mon Dieu vient à mon aide."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, du bist mein Fels, meine Burg, mein Retter, mein Gott, meine Zuflucht."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
