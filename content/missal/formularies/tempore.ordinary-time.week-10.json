  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Tua nos, Dómine, medicinális operátio, et a nostris perversitátibus cleménter expédiat, et ad ea quæ sunt recta perdúcat. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Senhor de bondade,"
       ],
       [
        "a vossa força salvadora"
       ],
       [
        "nos liberte das más inclinações"
