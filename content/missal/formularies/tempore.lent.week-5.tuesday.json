  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Cum exaltátus fúero a terra, ómnia traham ad meípsum, dicit Dóminus."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Quando eu for elevado da terra, diz o Senhor,"
       ],
       [
        "atrairei todos a mim."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "When I am lifted up from the earth,"
       ],
       [
        "I will draw all to myself, says the Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Cuando yo sea elevado sobre la tierra, atraeré a todos hacia mí, dice el Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "«Quando sarò innalzato da terra, attirerò tutti a me», dice il Signore."
       ],
       [
        {
         "m": "rubric",
         "t": "Oppure:"
        }
       ],
       [
        "Quando avrete innalzato il Figlio dell'uomo, conoscerete che Io Sono."
       ]
      ],
      "cite": "Gv 8, 28"
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Quand j'aurai été élevé de terre, dit le Seigneur,"
       ],
       [
        "j'attirerai à moi tous les hommes."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Wenn ich von der Erde erhöht bin, werde ich alle an mich ziehen – so spricht der Herr."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
  {
