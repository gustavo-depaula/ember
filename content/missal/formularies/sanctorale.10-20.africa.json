{"id":"sanctorale.10-20.africa","source":"santos/santos_africa#1020","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of Africa]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["October 20"],["Blessed Daudi Okelo and Jildo Irwa, Martyrs"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"From the Common of Martyrs: For Several Martyrs outside the Easter"}," ",{"m":"rubric","t":"Season"}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Entrance Antiphon"]],"cite":"Cf. Is 52:7"}]},"part":"entranceAntiphon"},{"text":{"*":[{"k":"p","lines":[["The souls of the Saints are rejoicing in heaven,"],["the Saints who followed the footsteps of Christ,"],["and since for love of him they shed their blood,"],["they now exult with Christ for ever."]]}]},"part":"entranceAntiphon"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Almighty and eternal God,"],["who granted the crown of martyrdom to Blessed Daudi and Jildo"],["for their proclamation of the Gospel;"],["grant that we, through their example and their intercession,"],["may tirelessly comunícate the Good News of salvation"],["to the nations."],["Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"text":{"*":[{"k":"h4","lines":[["Prayer over the Offerings"]]}]},"part":"prayerOverOfferings"},{"text":{"*":[{"k":"p","lines":[["Receive, holy Father, the offerings we bring"],["in commemoration of the holy Martyrs,"],["and grant that we, your servants,"],["may be found steadfast"],["in confessing your name."],["Through Christ our Lord."]]}]},"part":"prayerOverOfferings"},{"slot":"30","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"31","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis martyribus"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Quóniam beáti mártyris N. pro confessióne...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Quóniam tu magnificáris in tuórum...","to":"preface.55"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Pelo (a) mártir S. N....","to":"preface.54"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY MARTYRS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For the blood of your blessed...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For you are glorified when your Saints...","to":"preface.55"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque la sangre del glorioso mártir...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Porque tú eres ensalzado en la alabanza de tus santos...","to":"preface.55"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI MARTIRI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... A imitazione del Cristo tuo Figlio...","to":"preface.54"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des saints martyrs"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nous reconnaissons un signe éclatant de ta grâce...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... En louant tes saints martyrs,...","to":"preface.55"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"MÄRTYRERN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...Im Martyrium des (der) heiligen N. ...","to":"preface.54"}]],"cls":"indicepref"}]},"part":"preface","suggested":true},{"text":{"*":[{"k":"h4","lines":[["Communion Antiphon"]]}]},"part":"communionAntiphon"},{"text":{"*":[{"k":"p","lines":[["See how rich is the Saints' reward from God;"],["they died for Christ and will live for ever."]]}]},"part":"communionAntiphon"},{"text":{"*":[{"k":"h4","lines":[["Prayer after communion"]]}]},"part":"postcommunion"},{"text":{"*":[{"k":"p","lines":[["O God, who in your holy Martyrs"],["have wonderfully made known the mystery of the Cross,"],["graciously grant"],["that, drawing strength from this sacrifice,"],["we may cling faithfully to Christ"],["and labour in the Church for the salvation of all."],["Through Christ our Lord."]]}]},"part":"postcommunion"}],"precedence":12.0,"prefaces":["preface.54","preface.55"],"title":{"*":"Blessed Daudi Okelo and Jildo Irwa, Martyrs"}}
