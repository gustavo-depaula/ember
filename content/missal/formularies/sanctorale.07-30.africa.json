  },
  {
   "text": {
    "*": [
     {
      "k": "p",
      "lines": [
       [
        "Father of mercy, who gave your saint, Bishop Justin,"
       ],
       [
        "the grace to become all things to all people,"
       ],
       [
        "in order to preach the good news of the Kingdom,"
       ],
       [
        "may his intercession help us to preach the Gospel"
       ],
       [
        "and to bring all peoples to the unity of one faith"
       ],
       [
        "through our fraternal service."
       ],
       [
        "Through our Lord Jesus Christ, your Son,"
       ],
       [
        "who lives and reigns with you in the unity of the Holy Spirit,"
       ],
       [
        "one God, for ever and ever."
       ]
      ]
     }
    ]
   },
   "part": "collect"
  },
