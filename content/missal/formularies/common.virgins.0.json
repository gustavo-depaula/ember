  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Qui díligit me, diligétur a Patre meo, et ad eum veniémus, et mansiónem apud eum faciémus ",
        {
         "m": "rubric",
         "t": "( T. P. "
        },
        "allelúia ",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Aquele que me ama será amado por meu Pai. Nós viremos a ele, e faremos nele nossa morada"
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Whoever loves me will be loved by my Father, and I will come to him and reveal myself to him ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Al que me ama, lo amará mi Padre, y vendremos a él y haremos morada en él ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Chi mi ama sarà amato dal Padre mio e verremo a lui e prenderemo dimora presso di lui ",
        {
         "m": "rubric",
         "t": "( T. P. "
        },
        "allelúia ",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Celui qui m'aime sera aimé de mon Père,"
       ],
       [
        "dit le Seigneur ;"
       ],
       [
        "nous viendrons vers lui"
       ],
       [
        "et, chez lui, nous nous ferons une demeure ",
        {
         "m": "rubric",
         "t": "( T. P. "
        },
        "alléluia ",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Wer mich liebt, wird von meinem Vater geliebt werden, und wir werden zu ihm kommen und bei ihm wohnen - so spricht der Herr ",
        {
         "m": "rubric",
         "t": "(Österl. Zeit "
        },
        "Halleluja",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ]
