   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Venit Sponsus, et vírgines, quæ parátæ erant, intravérunt cum eo ad núptias ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "allelúia",
