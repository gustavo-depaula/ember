    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Chegou o Esposo, e as virgens que estavam preparadas entraram com ele para as núpcias."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "The bridegroom has come, and the virgins who were ready have gone with him into the wedding feast ",
        {
         "m": "rubric",
         "t": "(E. T. "
        },
        "alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Llegó el Esposo, y las vírgenes que estaban preparadas entraron con él al banquete de bodas ",
        {
         "m": "rubric",
         "t": "(T. P."
        },
        " Aleluya",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
