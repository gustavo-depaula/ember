        {
         "m": "rubric",
         "t": "(T. P. "
        },
        "Alleluia",
        {
         "m": "rubric",
         "t": ")."
        }
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Quand l'Époux arriva,"
