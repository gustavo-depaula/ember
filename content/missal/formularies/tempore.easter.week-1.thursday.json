  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Hóstias, quǽsumus, Dómine, placátus assúme,"
       ],
       [
        "quas et pro renátis gratánter deférimus,"
       ],
       [
        "et pro acceleratióne cæléstis auxílii."
       ],
       [
        "Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Aceitai benigno, Senhor, as oferendas"
       ],
       [
        "que, agradecidos, vos apresentamos"
       ],
       [
        "pelos que renasceram no Batismo;"
       ],
       [
        "que elas apressem o vosso auxílio celeste."
       ],
       [
        "Por Cristo, nosso Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Graciously be pleased, O Lord,"
       ],
       [
        "to accept the sacrificial gifts we offer joyfully both for those who have been reborn"
       ],
       [
        "and in hope of your increased help from heaven."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Recibe, Señor, en tu bondad"
       ],
       [
        "las ofrendas que te presentamos con gratitud"
       ],
       [
        "por los nuevos bautizados, y para apresurar la ayuda del cielo."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Accogli, o Signore, nella tua bontà il sacrificio che ti offriamo per coloro che sono nati a vita nuova e per noi che siamo bisognosi del tuo sollecito aiuto. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Accueille avec bonté ce sacrifice,"
       ],
       [
        "nous t'en prions, Seigneur :"
       ],
       [
        "nous te l'offrons dans l'action de grâce,"
       ],
       [
        "pour ceux que tu as fait renaître par le baptême ;"
       ],
       [
        "accorde-nous d'obtenir sans tarder"
       ],
       [
        "le secours qui vient du ciel."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Herr, unser Gott, nimm die Gaben an, die wir in Dankbarkeit für die Neugetauften darbringen. Schenke ihnen und uns allen deine Hilfe zur rechten Zeit. Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
   },
   "part": "prayerOverOfferings"
  },
