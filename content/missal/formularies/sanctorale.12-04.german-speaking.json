{"id":"sanctorale.12-04.german-speaking","source":"santos/santos_dic#1204Z","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In den Diözesen deutscher Sprache]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["4. Dezember"],["Hl. Barbara, Märtyrin"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[["Barbara lebte vermutlich im 3. oder 4. Jh. in Nikomedien. Nach der Legende soll sie um 306 unter Maximinus Daja hingerichtet worden sein. Die Verehrung der hl. Barbara hat sich im Osten und Westen verbreitet. Sie zählt zu den 14 Nothelfern."]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"Commune-Texte für Märtyrer:"}],[{"m":"link","t":"1","to":"common.martyrs.6"},{"m":"link","t":"2","to":"common.martyrs.7"}],[{"m":"rubric","t":"."}]]}]},"part":"title"},{"text":{"*":[{"k":"h4","lines":[["Tagesgebet"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["Allmächtiger Gott, du hast der heiligen Märtyrin Barbara die Kraft gegeben, bis in den Tod dir treu zu bleiben. Im Vertrauen auf ihre Fürsprache bitten wir dich: Steh uns bei in jeder Not und Gefahr und stärke uns in der Todesstunde mit dem Leib und Blut deines Sohnes, unseres Herrn Jesus Christus, der in der Einheit des Heiligen Geistes mit dir lebt und herrscht in alle Ewigkeit."]]}]},"part":"collect"},{"slot":"22","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"23","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis martyribus"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Quóniam beáti mártyris N. pro confessióne...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... Quóniam tu magnificáris in tuórum...","to":"preface.55"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"Dos Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...O sangue que o Santo Mártir N. derramou...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Vós sois exaltado quando celebramos os santos...","to":"preface.55"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY MARTYRS"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... For the blood of your blessed...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... For you are glorified when your Saints...","to":"preface.55"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santos Mártires"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Porque la sangre del glorioso mártir...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"...Porque tú eres ensalzado en la alabanza de tus santos...","to":"preface.55"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DEI MARTIRI"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... A imitazione del Cristo tuo Figlio...","to":"preface.54"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"Des Martyrs"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"... Nous reconnaissons un signe éclatant de ta grâce...","to":"preface.54"}]],"cls":"indicepref"},{"k":"p","lines":[["II ",{"m":"link","t":"... En louant tes saints martyrs,...","to":"preface.55"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"MÄRTYRERN"}]],"cls":"indicepref"},{"k":"p","lines":[["I ",{"m":"link","t":"...Im Martyrium des (der) heiligen N. ...","to":"preface.54"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.54","preface.55"],"commons":["common.martyrs.6","common.martyrs.7"],"title":{"*":"Hl. Barbara, Märtyrin"}}
