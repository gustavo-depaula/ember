  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Sacrifícia, Dómine, quæ in hac festivitáte beáti ",
        {
         "m": "rubric",
         "t": "N. "
        },
        "tuæ offérimus maiestáti, nobis sint ad salútem efficácia, et tuæ plácita pietáti. Per Christum."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "May the sacrifices we offer to your majesty, O Lord, on this feast day of blessed ",
        {
         "m": "rubric",
         "t": "N."
        },
        " be effective for our salvation and pleasing to you in your loving kindness."
       ],
       [
        "Through Christ our Lord."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Señor, que el sacrificio que ofrecemos"
       ],
       [
        "a tu majestad en la fiesta de san ",
        {
         "m": "rubric",
         "t": "N."
        }
       ],
       [
        "sea eficaz para nuestra salvación"
       ],
       [
        "y agradable a tu misericordia."
       ],
       [
        "Por Jesucristo, nuestro Señor."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Il sacrificio che offriamo alla tua maestà, o Signore, nella memoria di san ",
        {
         "m": "rubric",
         "t": "N."
        },
        " giovi alla nostra salvezza e sia gradito al tuo amore di Padre. Per Cristo nostro Signore."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Seigneur, Dieu de majesté,"
       ],
       [
        "que le sacrifice présenté en la fête de saint ",
        {
         "m": "rubric",
         "t": "N."
        }
       ],
       [
        "soit efficace pour notre salut"
       ],
       [
        "et plaise à ta bonté."
       ],
       [
        "Par le Christ, notre Seigneur."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Allmächtiger Gott, am Gedenktag des heiligen ",
        {
         "m": "rubric",
         "t": "N."
        },
        " feiern wir das Opfer des Lobes. Es versöhne uns mit dir und helfe uns, das Heil zu erlangen. Darum bitten wir durch Christus, unseren Herrn."
       ]
      ]
     }
    ]
   },
