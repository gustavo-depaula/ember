  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Omnibus qui recepérunt eum, dedit eis potestátem fílios Dei fíeri."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "A todos que o acolheram,"
       ],
       [
        "deu-lhes o poder"
       ],
       [
        "de se tornarem filhos de Deus."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "To all who would accept him,"
       ],
       [
        "he gave the power to become children of God."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "A cuantos lo recibieron, les dio poder de ser hijos de Dios."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "A quanti lo hanno accolto il Verbo incarnato ha dato potere di diventare figli di Dio."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "À tous ceux qui l'ont reçu,"
       ],
       [
        "le Fils unique a donné de pouvoir devenir enfants de Dieu."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Allen, die ihn aufnahmen, gab er Macht, Kinder Gottes zu werden."
       ]
      ]
     }
    ]
   },
   "part": "communionAntiphon"
  },
