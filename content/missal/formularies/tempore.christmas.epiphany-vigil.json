      "k": "p",
      "lines": [
       [
        {
         "m": "rubric",
         "t": "Ubi sollemnitas Epiphaniæ non est de præcepto servanda, assignatur, tamquam diei proprio, dominicæ a die 2 ad diem 8 ianuarii occurrenti."
        }
       ],
       [
        {
         "m": "rubric",
         "t": "Hæc Missa adhibetur vespere pridie sollemnitatis sive ante sive post I Vesperas Epiphaniæ."
