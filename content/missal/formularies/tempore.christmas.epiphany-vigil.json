  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Surge, Ierúsalem, et circúmspice ad oriéntem et vide congregátos fílios tuos a solis ortu usque ad occásum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Levanta-te, Jerusalém, e olha para o oriente,"
       ],
       [
        "e vê teus filhos reunidos do nascer ao pôr do sol."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Arise, Jerusalem, and look to the East"
       ],
       [
        "and see your children gathered from the rising to the setting of the sun."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Álzate, Jerusalén, mira hacia oriente y contempla a tus hijos: reunidos desde donde sale el sol hasta el ocaso."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Sorgi, Gerusalemme, e guarda verso oriente: vedi i tuoi figli riuniti, dal tramonto del sole al suo sorgere."
       ]
      ]
     }
    ],
    "fr": [
