  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Sacra alimónia renováti, tuam, Dómine, misericórdiam deprecámur, ut semper in méntibus nostris tuæ appáreat stella iustítiæ et noster in tua sit confessióne thesáurus. Per Christum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Renovados pelo sagrado alimento,"
       ],
       [
        "pedimos, Senhor, a vossa misericórdia,"
       ],
       [
        "para que sempre apareça em nossas mentes"
       ],
       [
        "a estrela da vossa justiça"
       ],
       [
        "e o nosso tesouro esteja"
       ],
       [
