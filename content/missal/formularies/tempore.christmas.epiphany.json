  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Vídimus stellam eius in Oriénte, et vénimus cum munéribus adoráre Dóminum."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Vimos sua estrela no Oriente,"
       ],
       [
        "e viemos com presentes adorar o Senhor."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "We have seen his star in the East,"
       ],
       [
