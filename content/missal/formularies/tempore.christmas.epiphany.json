  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Ecce advénit Dominátor Dóminus; et regnum in manu eius et potéstas et impérium."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Eis que vem o Senhor dos senhores,"
       ],
       [
        "em suas mãos, o reino, o poder e o império."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Behold, the Lord, the Mighty One, has come;"
       ],
       [
        "and kingship is in his grasp, and power and dominion."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Mirad que llega el Señor que domina; en su mano está el reino y el poder y la fuerza."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Ecco, viene il Signore, il nostro re: nella sua mano è il regno, la forza e la potenza."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
        "Voici venir le Seigneur souverain ;"
       ],
       [
        "il tient en main la royauté, la puissance et l'empire."
       ]
      ]
     }
    ],
    "de": [
     {
      "k": "p",
      "lines": [
       [
        "Seht, gekommen ist der Herrscher, der Herr. In seiner Hand ist die Macht und das Reich."
       ]
      ]
     }
    ]
   },
   "part": "entranceAntiphon"
  },
