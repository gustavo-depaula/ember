{"id":"sanctorale.04-04.africa","source":"santos/santos_africa#0404","kind":"sanctoral","items":[{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"[In the Dioceses of Africa]"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h2","lines":[["April 4"],["Saint Benedict, Religious"]]}]},"part":"title"},{"text":{"*":[{"k":"p","lines":[[{"m":"rubric","t":"From the Common of Holy Men and Women: For Religious"}]]}]},"part":"title","role":"rubric"},{"text":{"*":[{"k":"h4","lines":[["Collect"]]}]},"part":"collect"},{"text":{"*":[{"k":"p","lines":[["O God, who choose the weak and the simple"],["to reveal your power and greatness;"],["grant us the grace to follow the example of Saint Benedict"],["in his spirit of service and prayer,"],["so that we too, like him, may be chosen instruments,"],["in the building of your Kingdom."],["Through our Lord Jesus Christ, your Son,"],["who lives and reigns with you in the unity of the Holy Spirit,"],["one God, for ever and ever."]]}]},"part":"collect"},{"slot":"9","text":{"la":[{"k":"h4","lines":[["Præfatio"]]}],"pt-BR":[{"k":"h4","lines":[["Prefácio"]]}],"en-US":[{"k":"h4","lines":[["Preface"]]}],"es":[{"k":"h4","lines":[["Prefacio"]]}],"it":[{"k":"h4","lines":[["Prefazio"]]}],"fr":[{"k":"h4","lines":[["Préface"]]}],"de":[{"k":"h4","lines":[["Präfation"]]}]},"part":"preface","suggested":true},{"slot":"10","text":{"la":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis virginibus et religiosis "},{"m":"link","t":"... In Sanctis enim, qui Christo se dedicavérunt...","to":"preface.57"}]],"cls":"indicepref"}],"pt-BR":[{"k":"p","lines":[[{"m":"rubric","t":"SANTAS VIRGENS E RELIGIOSOS "},{"m":"link","t":"... Neles, chamais novamente os fiéis...","to":"preface.57"}]],"cls":"indicepref"}],"en-US":[{"k":"p","lines":[[{"m":"rubric","t":"HOLY VIRGINS AND RELIGIOUS "},{"m":"link","t":"... For in the Saints who consecrated themselves...","to":"preface.57"}]],"cls":"indicepref"}],"es":[{"k":"p","lines":[[{"m":"rubric","t":"Santas Vírgenes y Religiosos "},{"m":"link","t":"...Porque celebramos tu providencia admirable...","to":"preface.57"}]],"cls":"indicepref"}],"it":[{"k":"p","lines":[[{"m":"rubric","t":"DELLE SANTE VERGINI E DEI SANTI RELIGIOSI "},{"m":"link","t":"... Nei tuoi santi, che per il regno...","to":"preface.57"}]],"cls":"indicepref"}],"fr":[{"k":"p","lines":[[{"m":"rubric","t":"De sanctis virginibus et religiosis "},{"m":"link","t":"... Nous célébrons les prévenances de ton amour...","to":"preface.57"}]],"cls":"indicepref"}],"de":[{"k":"p","lines":[[{"m":"rubric","t":"HEILIGEN JUNGFRAUEN UND ORDENSLEUTEN "},{"m":"link","t":"... Inmitten der Kirche berufst du Menschen...","to":"preface.57"}]],"cls":"indicepref"}]},"part":"preface","suggested":true}],"precedence":12.0,"prefaces":["preface.57"],"title":{"*":"Saint Benedict, Religious"}}
