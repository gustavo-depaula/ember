  {
   "text": {
    "la": [
     {
      "k": "p",
      "lines": [
       [
        "Veníte, benedícti Patris mei, dicit Dóminus: percípite regnum, quod vobis parátum est ab orígine mundi ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        " allelúia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Vinde, benditos do meu Pai, diz o Senhor. Recebei como herança o reino que meu Pai vos preparou desde a criação do mundo ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        " aleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Come, you blessed of my father, says the Lord; receive the kingdom prepared for you"
       ],
       [
        "from the foundation of the world ",
        {
         "m": "rubric",
         "t": "(E.T"
        },
        ". alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "es": [
     {
      "k": "p",
      "lines": [
       [
        "Venid vosotros, benditos de mi Padre; heredad el reino preparado para vosotros desde la creación del mundo ",
        {
         "m": "rubric",
         "t": "["
        },
        "T.P. Aleluya",
        {
         "m": "rubric",
         "t": "]"
        },
        "."
       ]
      ]
     }
    ],
    "it": [
     {
      "k": "p",
      "lines": [
       [
        "Venite, benedetti del Padre mio, ricevete in eredità il regno preparato per voi fin dalla creazione del mondo ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        " Alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "fr": [
     {
      "k": "p",
      "lines": [
       [
