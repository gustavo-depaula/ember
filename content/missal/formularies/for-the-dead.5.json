    "pt-BR": [
     {
      "k": "p",
      "lines": [
       [
        "Sepultados com Cristo na morte pelo Batismo, cremos que também viveremos com ele ",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        " aleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "en-US": [
     {
      "k": "p",
      "lines": [
       [
        "Buried with christ through baptism into death,"
       ],
       [
        "we believe that we shall also live with christ ",
        {
         "m": "rubric",
         "t": "(E.T"
        },
        ". alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
