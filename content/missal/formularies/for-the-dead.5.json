      "k": "p",
      "lines": [
       [
        "Sepolti insieme a Cristo nella morte per mezzo del Battesimo, crediamo che anche vivremo con lui",
        {
         "m": "rubric",
         "t": "(T. P. "
        },
        " Alleluia",
        {
         "m": "rubric",
         "t": ")"
        },
        "."
       ]
      ]
     }
    ],
    "fr": [
