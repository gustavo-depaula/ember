{
	"sections": [
		{
			"type": "rubric",
			"text": {
				"en-US": "At the fixed hour, rise without hesitation. Kiss the floor and say aloud:",
				"pt-BR": "À hora marcada, levante-se sem hesitar. Beije o chão e diga em voz alta:"
			}
		},
		{
			"type": "prayer",
			"inline": {
				"la": "Sérviam!",
				"en-US": "I will serve!",
				"pt-BR": "Servirei!"
			}
		},
		{
			"type": "prayer",
			"ref": "sign-of-cross"
		},
		{
			"type": "divider"
		},
		{
			"type": "heading",
			"text": {
				"en-US": "Morning Offering",
				"pt-BR": "Oferecimento do Dia"
			}
		},
		{
			"type": "rubric",
			"text": {
				"en-US": "Now offer the day — its work, its prayer, its contradictions — for God's glory.",
				"pt-BR": "Agora ofereça o dia — o seu trabalho, a sua oração, as suas contradições — para a glória de Deus."
			}
		},
		{
			"type": "prayer",
			"ref": "offering-to-sacred-heart",
			"defaultOpen": true
		},
		{
			"type": "divider"
		},
		{
			"type": "offering",
			"mode": "intercessory",
			"default": "all-active",
			"show": "list",
			"label": {
				"en-US": "Today's intentions",
				"pt-BR": "Intenções de hoje"
			}
		},
		{
			"type": "rubric",
			"text": {
				"en-US": "And to seal the offering:",
				"pt-BR": "E para selar o oferecimento:"
			}
		},
		{
			"type": "prayer",
			"inline": {
				"la": "Deo omnis glória!",
				"en-US": "All for the glory of God!",
				"pt-BR": "Tudo para a glória de Deus!"
			}
		},
		{
			"type": "divider"
		},
		{
			"type": "prayer",
			"ref": "sign-of-cross"
		}
	]
}
