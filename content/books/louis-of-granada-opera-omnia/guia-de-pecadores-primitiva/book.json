    }
  },
  "sources": [
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrascue10luisuoft",
      "edition": "Fr. Luis de Granada, Obras, ed. Justo Cuervo OP, vol. 10 (Madrid: Viuda e hija de Gómez Fuentenebro, 1906-1908). Text of the 1556-1557 Lisbon editions.",
      "description": "Both books of the first part and the second part of the original Guía; the Tratado de la oración y meditación of Peter of Alcántara and Hieronymus of Ferrara's treatise on the three vows that Cuervo prints in the same volume are not Granada's and are not imported. OCR of the University of Toronto scan, cleaned by script (running heads, page numbers and the editor's prologue removed; lost initial capitals restored from the corpus vocabulary), not proofread.",
      "tier": "A",
      "tierEvidence": "Granada's text of the 16th century, reprinted in 1906; Cuervo's edition is in the public domain on archive.org."
    }
  ],
