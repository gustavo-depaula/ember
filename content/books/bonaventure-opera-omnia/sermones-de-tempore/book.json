  "description": {
    "la": "Sermones dominicales et festivi de tempore, ab Adventu usque ad dominicam vicesimam quartam post Pentecosten, ex codicibus editi. Textus ex editione Quaracchi (Opera omnia IX, 1901), ex scanno OCR, sine notis criticis.",
    "en-US": "Bonaventure’s sermons for the Sundays and feasts of the liturgical year, from Advent to the twenty-fourth Sunday after Pentecost, edited from the manuscripts. The Latin is the Quaracchi edition (Opera omnia IX, 1901) from an OCR scan, without the editors’ critical notes.",
    "pt-BR": "Sermões do ano litúrgico."
  },
  "composed": "1250-1274",
  "languages": [
    "la"
  ],
  "work": "bonaventure/sermones-de-tempore",
  "editions": {
    "la": {
      "editor": "PP. Collegii S. Bonaventurae (Quaracchi)",
      "year": 1901
    }
  },
  "sources": [
    {
      "language": "la",
      "url": "https://archive.org/details/doctorisseraphic09bona",
      "edition": "S. Bonaventurae Opera omnia, tom. IX (Ad Claras Aquas, Quaracchi: Collegium S. Bonaventurae, 1901), pp. 23-461.",
      "description": "Archive.org OCR (djvu.xml word coordinates) of the folio edition. Each page is read in two columns; marginal notes, running heads, the editors’ footnotes (variant readings, cross-references) and small-type notes are removed by layout (line pitch and measure); line-end hyphens are joined; recognisable OCR slips are corrected by a lexicon pass, so some remain. Sermon numbers within each feast follow the edition; where the OCR lost a sermon head the number is inferred.",
      "tier": "A",
      "tierEvidence": "Bonaventure died in 1274; the Quaracchi edition of 1901 is public domain."
    }
  ],
