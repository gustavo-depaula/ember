{
  "id": "adam-sequentiae-wrangham",
  "cover": "classic",
  "name": {
    "en-US": "The Liturgical Poetry of Adam of St. Victor (Wrangham)",
    "pt-BR": "A poesia litúrgica de Adão de São Vítor (Wrangham)"
  },
  "author": {
    "la": "Adamus de Sancto Victore",
    "en-US": "Adam of St. Victor",
    "pt-BR": "Adão de São Vítor"
  },
  "description": {
    "en-US": "Digby S. Wrangham’s English verse translations of the sequences of Adam of St. Victor (1881), made in the original metres from Léon Gautier’s Latin text: sequences I to CII, for the feasts of the Lord, the saints and Our Lady. Gautier’s selection and numbering differ from the thirty-six prosae of Migne, so this is a separate book from the Latin Sequentiae; the same work. English only, from a machine-read scan (some slips remain); the translator’s notes and the doubtful sequences are not imported. One verse to a line.",
    "pt-BR": "As traduções em verso inglês de Digby S. Wrangham (1881) das sequências de Adão de São Vítor, nos metros originais, a partir do texto latino de Léon Gautier: sequências I a CII."
  },
  "composed": "c. 1130-1170 (translation 1881)",
  "languages": [
    "en-US"
  ],
  "work": "adam/sequentiae",
  "editions": {
    "en-US": {
      "translator": "Digby S. Wrangham",
      "year": 1881
    }
  },
  "sources": [
    {
      "language": "en-US",
      "url": "https://archive.org/details/liturgicalpoetry01adamuoft",
      "edition": "The Liturgical Poetry of Adam of St. Victor, from the text of Gautier, with translations into English in the original metres and short explanatory notes by Digby S. Wrangham, 3 vols (London: Trubner, 1881); archive.org liturgicalpoetry01adamuoft, 02adamuoft, 03adamuoft (OCR text).",
      "description": "Only the English translations of sequences I-CII are imported; the facing Latin of Gautier, the translator’s notes, the index and the doubtful sequences are left out. Stanza breaks are inferred from sentence ends; the OCR carries slips.",
      "tier": "A",
      "tierEvidence": "Published in London in 1881; the translator is out of copyright everywhere."
    }
  ],
