{
  "id": "avila-audi-filia",
  "cover": "quarter",
  "name": {
    "es-ES": "Audi, filia",
    "en-US": "Audi, Filia",
    "pt-BR": "Audi, filia"
  },
  "author": {
    "es-ES": "San Juan de Ávila",
    "en-US": "St. John of Ávila",
    "pt-BR": "São João de Ávila"
  },
  "description": {
    "es-ES": "Libro espiritual sobre el verso «Audi, filia, et vide» (Salmo 44): de los malos lenguajes del mundo, carne y demonio, y de los remedios contra ellos; de la fe y del propio conocimiento, de la penitencia, la oración, la Pasión del Señor y el amor del prójimo. Segunda redacción (Toledo 1574), 113 capítulos, en la edición modernizada del Apostolado Mariano; en inglés, «The Audi Filia, or a Rich Cabinet full of Spiritual Jewels» (St Omer 1620), con las glosas marginales del traductor como notas.",
    "en-US": "Spiritual book on the verse «Audi, filia, et vide» (Psalm 44): on the evil languages of the world, the flesh and the devil and their remedies; on faith and self-knowledge, penance, prayer, the Passion of the Lord and love of neighbour. The second redaction (Toledo 1574), 113 chapters, in the modernised Apostolado Mariano edition; in English, «The Audi Filia, or a Rich Cabinet full of Spiritual Jewels» (St Omer 1620), with the translator's marginal glosses as footnotes.",
    "pt-BR": "Livro espiritual sobre o verso «Audi, filia, et vide» (Salmo 44): das más linguagens do mundo, da carne e do demônio e dos remédios contra elas; da fé e do autoconhecimento, da penitência, da oração, da Paixão do Senhor e do amor ao próximo."
  },
  "composed": "1556–1574",
  "languages": [
    "es-ES",
    "en-US"
  ],
  "work": "john-of-avila/audi-filia",
  "editions": {
    "es-ES": {
      "editor": "Apostolado Mariano (modernised reprint of the 1574 text)",
      "year": 2007
    },
    "en-US": {
      "translator": "attributed to Sir Tobie Matthew",
      "year": 1620
    }
  },
  "sources": [
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obras-de-san-juan-de-avila-tomo-2",
      "edition": "San Juan de Ávila, Libro espiritual sobre el verso Audi, filia, Sevilla: Apostolado Mariano, 2007 (reprint of the Apostolado de la Prensa edition of 1941); archive.org upload 'Audi, filia', Tesseract OCR.",
      "description": "Complete 113 chapters with the author's prologue and Breve suma; archaic words are glossed in square brackets by the editor, and his few footnotes are kept. Page numbers and the approbation are removed.",
      "tier": "B",
      "tierEvidence": "The text is Ávila's of 1574 (public domain); the modernised reprint is freely posted on archive.org."
    },
    {
      "language": "es-ES",
      "url": "https://archive.org/details/bub_gb_twoHq3QVr8MC",
      "edition": "Toledo: Juan de Ayala, 1574 (first edition, Google scan); and Sevilla 1604 (archive.org A1020481). Used only to cross-check.",
      "description": "Early prints; OCR with long-s is poor.",
      "tier": "A",
      "tierEvidence": "Printed 1574 and 1604."
    },
    {
      "language": "en-US",
      "url": "https://distantreader.org/stacks/earlyprint/txt/A23406.txt",
      "edition": "The Audi Filia, or a Rich Cabinet full of Spiritual Jewels, St Omer 1620, translation attributed to Sir Tobie Matthew. EEBO-TCP A23406 (EarlyPrint normalised spelling).",
      "description": "Full 113 chapters. The translator's preface is not included. His marginal glosses, which the keyed text runs into the lines, are footnotes. Illegible characters of the keying appear as ●.",
      "tier": "A",
      "tierEvidence": "Printed 1620; the TCP keyed text is released CC0."
    }
  ],
