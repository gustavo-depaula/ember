{
  "id": "kempis-cantica",
  "cover": "classic",
  "name": {
    "la": "Cantica",
    "en-US": "Hymns and Sacred Songs",
    "pt-BR": "Cânticos"
  },
  "author": {
    "la": "Thomas a Kempis",
    "en-US": "Thomas à Kempis",
    "pt-BR": "Tomás de Kempis"
  },
  "description": {
    "la": "Cantica Thomae a Kempis: hymni, sequentiae, antiphonae et rhythmi de Iesu, de Maria, de angelis et sanctis (praesertim virginibus), de gloria caelesti et de vita spirituali.",
    "en-US": "The hymns, sequences, antiphons and rhymes of Thomas: on Jesus and his name, the Virgin, angels and saints (above all the virgin martyrs Agnes, Cecilia and Barbara), heavenly glory, patience and the spiritual life. Latin only: Pohl's critical edition (Freiburg 1918), from a raw OCR of the printed volume; no public-domain English translation has been found. Verse lines are kept as printed.",
    "pt-BR": "Os hinos, sequências, antífonas e rimas de Tomás: sobre Jesus e seu nome, a Virgem, os anjos e santos (sobretudo as virgens mártires Inês, Cecília e Bárbara), a glória celeste, a paciência e a vida espiritual."
  },
  "composed": "c. 1420-1470",
  "languages": [
    "la"
  ],
  "work": "thomas-a-kempis/cantica",
  "editions": {
    "la": {
      "editor": "Michael Joseph Pohl",
      "year": 1918
    }
  },
  "sources": [
    {
      "language": "la",
      "url": "https://archive.org/details/operaomnia0000thom_q8k7",
      "edition": "Thomae Hemerken a Kempis Cantica, ed. M. J. Pohl (Freiburg: Herder 1918), Opera omnia IV, pp. 241-; archive.org raw OCR (Pohl 1918 volume).",
      "description": "The hymns as Pohl numbers them (I-CX; a few numerals lost to OCR leave gaps or merge neighbours), with the verse lines kept as hard line breaks and stanzas as paragraphs. Titles are Pohl's upper-case headings recased, or the first line where there is none. Line numbers, running heads and page breaks stripped by script; the alphabetical index of incipits was used to restore first words lost to drop capitals. Raw OCR: drop capitals and many first lines remain garbled.",
      "tier": "A",
      "tierEvidence": "Pohl 1918; Thomas died in 1471."
    }
  ],
