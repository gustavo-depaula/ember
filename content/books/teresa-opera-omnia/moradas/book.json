    }
  },
  "sources": [
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdesantatere04tere",
      "edition": "Obras de Sta. Teresa de Jesús, ed. P. Silverio de Santa Teresa, C.D., t. IV (Biblioteca Mística Carmelitana 4), Burgos: El Monte Carmelo, 1917, pp. 5–210. Princeton Theological Seminary scan, primary OCR.",
      "description": "Spanish critical text from the autograph, with Silverio's notes kept as footnotes. OCR of two independent scans merged word by word, then proofread against both.",
      "tier": "A",
      "tierEvidence": "Teresa died in 1582; Silverio's edition was published in 1917 (public domain in the US, published before 1930) and P. Silverio died in 1954, so his notes are public domain under life+70 since 1 January 2025."
    },
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdestateresa04tere",
      "edition": "The same volume, Wellesley College scan, used as the second witness.",
      "tier": "A",
      "tierEvidence": "Same edition as above."
    },
    {
      "language": "en-US",
      "url": "https://ccel.org/ccel/teresa/castle2",
      "edition": "The Interior Castle or The Mansions, translated from the autograph by the Benedictines of Stanbrook, revised with notes by Benedict Zimmerman, O.C.D., 3rd ed., London: Thomas Baker, 1921. CCEL proofed e-text.",
      "description": "English translation with Zimmerman's notes and paragraph summaries; Zimmerman's introduction and the index are not included.",
      "tier": "A",
      "tierEvidence": "Published 1921 (before 1930: public domain in the US); anonymous corporate translation published over 70 years ago (UK); Zimmerman died in 1937. CCEL marks it Public Domain."
    }
