  "name": {
    "es-ES": "Relaciones espirituales (Cuentas de conciencia)",
    "en-US": "Spiritual Testimonies (Accounts of Conscience)",
    "pt-BR": "Relações espirituais (Contas de consciência)"
  },
  "author": {
    "es-ES": "Santa Teresa de Jesús",
    "en-US": "St. Teresa of Ávila",
    "pt-BR": "Santa Teresa de Ávila"
  },
  "description": {
    "es-ES": "Las sesenta y siete Relaciones espirituales de Santa Teresa a sus confesores y las mercedes que recibió de Dios, escritas entre 1560 y 1581. Texto del P. Silverio de Santa Teresa, con sus notas; una relación por capítulo.",
    "en-US": "The sixty-seven Spiritual Testimonies St. Teresa wrote for her confessors, recording the graces she received from God, 1560-1581. P. Silverio de Santa Teresa's text with his notes, one relation per chapter (Spanish only; Lewis's English groups the same pieces differently).",
    "pt-BR": "As sessenta e sete Relações espirituais de Santa Teresa aos seus confessores sobre as graças recebidas de Deus (1560-1581), uma por capítulo."
  },
  "composed": "1560–1581",
  "languages": [
    "es-ES"
  ],
  "work": "teresa-of-avila/relaciones",
  "editions": {
    "es-ES": {
      "editor": "P. Silverio de Santa Teresa",
      "year": 1915
    }
  },
  "sources": [
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdesantatere02tere",
      "edition": "Obras de Sta. Teresa de Jesús, ed. P. Silverio de Santa Teresa, C.D., t. 2: Relaciones espirituales y Apéndices al Libro de la Vida (Biblioteca Mística Carmelitana), Burgos: El Monte Carmelo, 1915, pp. 1–88. Princeton Theological Seminary scan, primary OCR.",
      "description": "Spanish critical text with Silverio's notes kept as footnotes; his introduction and appendices are not included. OCR of two independent scans merged word by word.",
      "tier": "A",
      "tierEvidence": "Teresa died in 1582; the volume was published in 1915 (public domain in the US) and P. Silverio died in 1954, so his notes are public domain under life+70 since 1 January 2025."
    },
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdestateresa02tere",
      "edition": "The same volume, Wellesley College scan, used as the second witness.",
      "tier": "A",
      "tierEvidence": "Same edition as above."
    }
