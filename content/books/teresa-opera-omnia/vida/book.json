      "translator": "David Lewis",
      "year": 1904
    }
  },
  "sources": [
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdesantatere01tere",
      "edition": "Obras de Sta. Teresa de Jesús, ed. P. Silverio de Santa Teresa, C.D., t. I: Libro de la Vida (Biblioteca Mística Carmelitana 1), Burgos: El Monte Carmelo, 1915. Princeton Theological Seminary scan, primary OCR.",
      "description": "Spanish critical text from the Escorial autograph, with Silverio's notes kept as footnotes; his introduction, appendices and indexes are not included. OCR of two independent scans merged word by word, then proofread against both.",
      "tier": "A",
      "tierEvidence": "Teresa died in 1582; the edition was published in 1915 (public domain in the US) and P. Silverio died in 1954, so his notes are public domain under life+70 since 1 January 2025."
    },
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdestateresa01tere",
      "edition": "The same volume, Wellesley College scan, used as the second witness.",
      "tier": "A",
      "tierEvidence": "Same edition as above."
    },
    {
      "language": "en-US",
      "url": "https://ccel.org/ccel/teresa/life",
      "edition": "The Life of St. Teresa of Jesus, of the Order of Our Lady of Carmel, written by herself, translated by David Lewis, 3rd ed. with an introduction by Benedict Zimmerman, London: Thomas Baker; New York: Benziger, 1904. CCEL proofed e-text (= Project Gutenberg #8120).",
      "description": "Lewis's translation with his notes; Zimmerman's introduction, the Relations and the index are not included here.",
      "tier": "A",
      "tierEvidence": "Published 1904 (public domain in the US); David Lewis died in 1895 and Zimmerman in 1937 (life+70 passed). CCEL marks it Public Domain."
    }
  ],
