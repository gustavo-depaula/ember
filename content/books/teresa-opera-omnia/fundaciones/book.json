      "from": "es-ES",
      "year": 2026
    }
  },
  "sources": [
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdesantatere05tere",
      "edition": "Obras de Sta. Teresa de Jesús, ed. P. Silverio de Santa Teresa, C.D., t. V: Libro de las Fundaciones (Biblioteca Mística Carmelitana 5), Burgos: El Monte Carmelo, 1918, pp. 1–329. Princeton Theological Seminary scan, primary OCR.",
      "description": "Spanish critical text with Silverio's notes kept as footnotes; his introduction and the appendices are not included. OCR of two independent scans merged word by word.",
      "tier": "A",
      "tierEvidence": "Teresa died in 1582; the volume was published in 1918 (public domain in the US) and P. Silverio died in 1954, so his notes are public domain under life+70 since 1 January 2025."
    },
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdestateresa05tere",
      "edition": "The same volume, Wellesley College scan, used as the second witness.",
      "tier": "A",
      "tierEvidence": "Same edition as above."
    },
    {
      "language": "en-US",
      "url": "https://archive.org/details/sainttheresahist00tereuoft",
      "edition": "Saint Theresa: the History of her Foundations, translated from the Spanish by Sister Agnes Mason, C.H.F., with a preface by Sir E. M. Satow, Cambridge: at the University Press, 1909. University of Toronto scan.",
      "description": "English translation with Mason's footnotes; the preface and the index are not included. Mason follows Teresa's 31 chapters, so the chapter ids match the Spanish. The Lewis/Zimmerman version (1913) was left aside because its OCR is too damaged to split reliably.",
      "tier": "A",
      "tierEvidence": "Published 1909 (public domain in the US); Mason died long ago; archive.org marks the scan NOT_IN_COPYRIGHT."
    }
  ],
