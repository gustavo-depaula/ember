{
  "id": "teresa-camino",
  "cover": "quarter",
  "name": {
    "es-ES": "Camino de perfección",
    "en-US": "The Way of Perfection",
    "pt-BR": "Caminho de perfeição"
  },
  "author": {
    "es-ES": "Santa Teresa de Jesús",
    "en-US": "St. Teresa of Ávila",
    "pt-BR": "Santa Teresa de Ávila"
  },
  "description": {
    "es-ES": "Avisos y consejos de Santa Teresa a sus monjas de San José de Ávila: la pobreza, el amor de unas con otras, el desasimiento y la humildad, y la oración, enseñada sobre el Paternóster. Segunda redacción (autógrafo de Valladolid), texto crítico del P. Silverio de Santa Teresa, con sus notas.",
    "en-US": "St. Teresa's counsels to her nuns of St. Joseph's at Ávila: poverty, love for one another, detachment and humility, and prayer, taught through the Our Father. The second redaction (Valladolid autograph) in P. Silverio de Santa Teresa's critical text with his notes; English translation by the Benedictines of Stanbrook, edited by Benedict Zimmerman, with the Escorial variants in brackets.",
    "pt-BR": "Conselhos de Santa Teresa às suas monjas de São José de Ávila: a pobreza, o amor mútuo, o desapego e a humildade, e a oração, ensinada a partir do Pai-Nosso."
  },
  "composed": "c. 1566–1569",
  "languages": [
    "es-ES",
    "en-US",
    "pt-BR"
  ],
  "work": "teresa-of-avila/camino",
  "editions": {
    "es-ES": {
      "editor": "P. Silverio de Santa Teresa",
      "year": 1916
    },
    "en-US": {
      "translator": "Benedictines of Stanbrook",
      "year": 1919
    },
    "pt-BR": {
      "translator": "Ember",
      "from": "es-ES",
      "year": 2026
    }
  },
  "sources": [
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdesantatere03tere",
      "edition": "Obras de Sta. Teresa de Jesús, ed. P. Silverio de Santa Teresa, C.D., t. III: Camino de perfección (Biblioteca Mística Carmelitana 3), Burgos: El Monte Carmelo, 1916, pp. 1–206: the Valladolid autograph. Princeton Theological Seminary scan, primary OCR.",
      "description": "Spanish critical text of the second redaction with Silverio's notes kept as footnotes; his introduction and the appendices (the Escorial autograph and the Toledo codex) are not included. OCR of two independent scans merged word by word, then proofread against both.",
      "tier": "A",
      "tierEvidence": "Teresa died in 1582; the volume was published in 1916 (public domain in the US) and P. Silverio died in 1954, so his notes are public domain under life+70 since 1 January 2025."
    },
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdestateresa03tere",
      "edition": "The same volume, Wellesley College scan, used as the second witness.",
      "tier": "A",
      "tierEvidence": "Same edition as above."
    },
    {
      "language": "en-US",
      "url": "https://archive.org/details/thewayofperfecti00tereuoft",
      "edition": "The Way of Perfection, translated from the autograph by the Benedictines of Stanbrook, including all the variants from both the Escorial and Valladolid editions, revised with notes and an introduction by Benedict Zimmerman, O.C.D., 2nd ed., London: Thomas Baker, 1919. University of Toronto scan, OCR cleaned against the 1st ed. (1911, archive.org/details/wayofperfection00tere_0).",
      "description": "English translation with Zimmerman's notes and paragraph summaries; his introduction and the index are not included.",
      "tier": "A",
      "tierEvidence": "Published 1911/1919 (before 1930: public domain in the US); anonymous corporate translation published over 70 years ago (UK); Zimmerman died in 1937. archive.org marks the scan NOT_IN_COPYRIGHT."
    }
  ],
