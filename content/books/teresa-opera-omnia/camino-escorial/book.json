{
  "id": "teresa-camino-escorial",
  "cover": "quarter",
  "name": {
    "es-ES": "Camino de perfección (redacción de El Escorial)",
    "en-US": "The Way of Perfection (Escorial redaction)",
    "pt-BR": "Caminho de perfeição (redação do Escorial)"
  },
  "author": {
    "es-ES": "Santa Teresa de Jesús",
    "en-US": "St. Teresa of Ávila",
    "pt-BR": "Santa Teresa de Ávila"
  },
  "description": {
    "es-ES": "La primera redacción del Camino de perfección, según el autógrafo de El Escorial (73 capítulos), en la ortografía de la Santa y con las notas del P. Silverio de Santa Teresa. La segunda redacción (autógrafo de Valladolid) es el libro «Camino de perfección».",
    "en-US": "The first redaction of the Way of Perfection, from the Escorial autograph (73 chapters), in the saint's own spelling with P. Silverio de Santa Teresa's notes (Spanish only). The second redaction, from the Valladolid autograph, is the book The Way of Perfection.",
    "pt-BR": "A primeira redação do Caminho de perfeição, segundo o autógrafo do Escorial (73 capítulos), na ortografia da Santa e com as notas do P. Silverio de Santa Teresa."
  },
  "composed": "1566–1567",
  "languages": [
    "es-ES"
  ],
  "work": "teresa-of-avila/camino-escorial",
  "editions": {
    "es-ES": {
      "editor": "P. Silverio de Santa Teresa",
      "year": 1916
    }
  },
  "sources": [
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdesantatere03tere",
      "edition": "Obras de Sta. Teresa de Jesús, ed. P. Silverio de Santa Teresa, C.D., t. 3: Camino de perfección, appendix: Autógrafo de El Escorial (Biblioteca Mística Carmelitana), Burgos: El Monte Carmelo, 1916, pp. 209–355. Princeton Theological Seminary scan, primary OCR.",
      "description": "Spanish text of the first redaction of the Camino de perfección (the Escorial autograph, 73 chapters) in the saint's own spelling, with Silverio's notes kept as footnotes; the Valladolid redaction is the separate book teresa-camino, and the Toledo codex is not included. OCR of two independent scans merged word by word.",
      "tier": "A",
      "tierEvidence": "Teresa died in 1582; the volume was published in 1916 (public domain in the US) and P. Silverio died in 1954, so his notes are public domain under life+70 since 1 January 2025."
    },
    {
      "language": "es-ES",
      "url": "https://archive.org/details/obrasdestateresa03tere",
      "edition": "The same volume, Wellesley College scan, used as the second witness.",
      "tier": "A",
      "tierEvidence": "Same edition as above."
    }
  ],
