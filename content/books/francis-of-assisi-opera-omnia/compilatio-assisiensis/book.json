  "name": {
    "la": "Compilatio Assisiensis (Legenda Perusina)",
    "en-US": "The Assisi Compilation (Legenda Perusina)",
    "pt-BR": "A Compilação de Assis (Legenda Perusina)"
  },
  "author": {
    "la": "Socii sancti Francisci",
    "en-US": "Companions of St. Francis (Compilatio Assisiensis)",
    "pt-BR": "Companheiros de São Francisco (Compilação de Assis)"
  },
  "description": {
    "la": "Compilatio Assisiensis seu Legenda Perusina, CXX capita ex testimonio sociorum beati Francisci, fratris Leonis praesertim, collecta (c. 1244-1260), secundum codicem Perusinum 1046.",
    "en-US": "The Assisi Compilation, or Legenda Perusina (c. 1244-1260): one hundred and twenty short chapters of memories of St. Francis gathered from his companions, above all Brother Leo, in the order of the Perugia manuscript 1046, in Latin. No public-domain English exists.",
    "pt-BR": "A Compilação de Assis, ou Legenda Perusina (c. 1244-1260): cento e vinte capítulos curtos de lembranças de São Francisco recolhidas dos seus companheiros."
  },
  "composed": "1244-1260",
  "languages": [
    "la"
  ],
  "work": "companions-of-francis/compilatio-assisiensis",
  "editions": {
    "la": {
      "editor": "transcription of the critical text of Fontes Franciscani (1995) by M. Mastrorilli, Politecnico di Bari; edition not stated"
    }
  },
  "sources": [
    {
      "language": "la",
      "url": "http://rilievo.poliba.it/bsc/bsc/st/cc/orm/francescani/fonti/ff_leggendaperugina_lat.html",
      "edition": "Legenda Perusina, poliba.it \"Fonti francescane\" (Wayback Machine snapshot).",
      "description": "120 numbered chapters (titled by their number in the source). Latin only.",
      "tier": "B",
      "tierEvidence": "Medieval text. The transcription (M. Mastrorilli, Politecnico di Bari, Biblioteca di Scienze del Cristianesimo, 2000-02) survives only in the Wayback Machine; it states no edition, but its biblical apparatus follows Fontes Franciscani (1995). Free in practice, edition unverified."
    }
  ],
