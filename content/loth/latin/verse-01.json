{"id":"verse-01","parts":[{"slot":"verse","body":[{"v":["Verbum caro factum est, allelúia.","Et habitávit in nobis, allelúia."]}]},{"slot":"verse","body":[{"v":["Cantáte Dómino, et benedícite nómini eius.","Annuntiáte de die in diem salutáre eius."]}]},null,{"slot":"verse","body":[{"v":["In ipso vita erat.","Et vita erat lux hóminum."]}]},{"slot":"verse","body":[{"v":["Annuntiavérunt cæli iustítiam eius.","Et vidérunt omnes pópuli glóriam eius."]}]},{"slot":"verse","body":[{"v":["Lauda, Ierúsalem, Dóminum.","Qui emíttit elóquium suum in terra."]}]},{"slot":"verse","body":[{"v":["Dóminus vias suas docébit nos.","Et ambulábimus in sémitis eius."]}]},{"slot":"verse","body":[{"v":["Fílius Dei venit, et dedit nobis sensum.","Ut cognoscámus verum Deum."]}]},{"slot":"verse","body":[{"v":["Erat lux vera.","Quæ illúminat omnem hóminem."]}]},{"slot":"verse","body":[{"v":["Hic est Fílius meus caríssimus.","Audíte illum."]}]},{"slot":"verse","body":[{"v":["Da mihi intelléctum, et servábo legem tuam.","Et custódiam illam in toto corde meo."]}]},{"slot":"verse","body":[{"v":["Díriget Dóminus mansuétos in iudício.","Docébit mites vias suas."]}]},{"slot":"verse","body":[{"v":["Omnes mirabántur in verbis grátiæ.","Quæ procedébant de ore ipsíus."]}]},{"slot":"verse","body":[{"v":["Revéla, Dómine, óculos meos.","Et considerábo mirabília de lege tua."]}]},null,{"slot":"verse","body":[{"v":["Veníte, et vidéte ópera Dómini.","Qui pósuit prodígia super terram."]}]},{"slot":"verse","body":[{"v":["Vestri beáti óculi quia vident.","Et aures vestræ quia áudiunt."]}]},{"slot":"verse","body":[{"v":["Dírige me, Dómine, in veritáte tua, et doce me.","Quia tu es Deus salútis meæ."]}]},{"slot":"verse","body":[{"v":["Bonitátem et prudéntiam et sciéntiam doce me.","Quia præcéptis tuis crédidi."]}]},{"slot":"verse","body":[{"v":["Sustínuit ánima mea in verbo eius.","Sperávit ánima mea in Dómino."]}]},{"slot":"verse","body":[{"v":["Dómine, ad quem íbimus?","Verba vitæ ætérnæ habes."]}]},{"slot":"verse","body":[{"v":["Oculi mei defecérunt in desidério salutáris tui.","Et elóquii iustítiæ tuæ."]}]},{"slot":"verse","body":[{"v":["Miserátor et miséricors Dóminus.","Longánimis et multum miséricors."]}]},{"slot":"verse","body":[{"v":["Auscúlta, fili mi, sermónes meos.","Et ad elóquia mea inclína aurem tuam."]}]},{"slot":"verse","body":[{"v":["Audi, pópule meus, et loquar.","Deus, Deus tuus ego sum."]}]},{"slot":"verse","body":[{"v":["Audiam quid loquántur Dóminus Deus.","Loquétur pacem ad plebem suam."]}]},{"slot":"verse","body":[{"v":["Declarátio sermónum tuórum illúminat.","Et intelléctum dat párvulis."]}]},{"slot":"verse","body":[{"v":["Dómine, apud te est fons vitæ.","Et in lúmine tuo vidébimus lumen."]}]},{"slot":"verse","body":[{"v":["Dóminus vias suas docébit nos.","Et ambulábimus in sémitis eius."]}]},{"slot":"verse","body":[{"v":["Dómine, véritas tua usque ad nubes.","Iudícia tua abýssus multa."]}]},{"slot":"verse","body":[{"v":["Recólimus, Deus, misericórdiam tuam.","In médio templi tui."]}]},{"slot":"verse","body":[{"v":["Quam dúlcia fáucibus meis elóquia tua, Dómine.","Super mel ori meo."]}]},{"slot":"verse","body":[{"v":["Atténdite, pópule meus, doctrínam meam.","Inclináte aurem vestram in verba oris mei."]}]},{"slot":"verse","body":[{"v":["Viam mandatórum tuórum, Dómine, fac me intellégere.","Et exercébor in mirabílibus tuis."]}]},{"slot":"verse","body":[{"v":["Fáciem tuam illúmina super servum tuum, Dómine.","Et doce me iustificatiónes tuas."]}]},{"slot":"verse","body":[{"v":["Fili mi, atténde ad sapiéntiam meam.","Et prudéntiæ meæ inclína aurem tuam."]}]},{"slot":"verse","body":[{"v":["Non cessámus pro vobis orántes et postulántes.","Ut impleámini agnitióne voluntátis Dei."]}]},{"slot":"verse","body":[{"v":["Verbum Christi hábitet in vobis abundánter.","In omni sapiéntia commonéntes vosmetípsos."]}]},{"slot":"verse","body":[{"v":["Verbum Dómini manet in ætérnum.","Hoc est, quod evangelizátum est in vos."]}]},{"slot":"verse","body":[{"v":["Convertímini et ágite pæniténtiam.","Fácite vobis cor novum et spíritum novum."]}]},{"slot":"verse","body":[{"v":["Qui meditátur in lege Dómini.","Dabit fructum suum in témpore suo."]}]},{"slot":"verse","body":[{"v":["Convertímini ad Dóminum Deum vestrum.","Quia benígnus et miséricors est."]}]},{"slot":"verse","body":[{"v":["Qui facit veritátem, venit ad lucem.","Ut manifesténtur ópera eius."]}]},{"slot":"verse","body":[{"v":["Non in solo pane vivit homo.","Sed in omni verbo, quod procédit de ore Dei."]}]},{"slot":"verse","body":[{"v":["Pænitémini et crédite Evangélio.","Appropinquávit enim regnum Dei."]}]},{"slot":"verse","body":[{"v":["Ecce nunc tempus acceptábile.","Ecce nunc dies salútis."]}]},null,{"slot":"verse","body":[{"v":["Vox Patris de nube audíta est.","Hic est Fílius meus diléctus: ipsum audíte"]}]},{"slot":"verse","body":[{"v":["Cibávit illum pane vitæ et intelléctus.","Et aqua sapiéntiæ salutáris potávit illum."]}]},{"slot":"verse","body":[{"v":["Iustus germinábit sicut lílium.","Et florébit in ætérnum ante Dóminum."]}]},{"slot":"verse","body":[{"v":["Verbum caro factum est.","Et habitávit in nobis."]}]},{"slot":"verse","body":[{"v":["Si quis sermónem meum serváverit.","Mortem non vidébit in ætérnum."]}]},{"slot":"verse","body":[{"v":["Cum exaltátus fúero a terra.","Omnia traham ad meípsum."]}]},{"slot":"verse","body":[{"v":["Insurrexérunt in me testes iníqui.","Et mentíta est iníquitas sibi."]}]},{"slot":"verse","body":[{"v":["Iúdica causam meam, et rédime me.","Propter elóquium tuum vivífica me."]}]},{"slot":"verse","body":[{"v":["Reflóruit caro mea, allelúia.","Et ex voluntáte mea confitébor illi, allelúia."]}]},{"slot":"verse","body":[{"v":["Gavísi sunt discípuli, allelúia.","Viso Dómino, allelúia."]}]},{"slot":"verse","body":[{"v":["Deus suscitávit Christum a mórtuis, allelúia.","Ut fides nostra et spes esset in Deo, allelúia."]}]},{"slot":"verse","body":[{"v":["Deus et Dóminum suscitávit, allelúia.","Et nos suscitábit per virtútem suam, allelúia."]}]},{"slot":"verse","body":[{"v":["In resurrectióne tua, Christe, allelúia.","Cæli et terra læténtur, allelúia."]}]},{"slot":"verse","body":[{"v":["Deus regenerávit nos in spem vivam, allelúia.","Per resurrectiónem Iesu Christi ex mórtuis, allelúia."]}]},{"slot":"verse","body":[{"v":["Cor meum et caro mea, allelúia.","Exsultavérunt in Deum vivum, allelúia."]}]},{"slot":"verse","body":[{"v":["Christus resúrgens ex mórtuis iam non móritur, allelúia.","Mors illi ultra non dominábitur, allelúia."]}]},{"slot":"verse","body":[{"v":["Dóminus dabit verbum evangelizántibus, allelúia.","Virtúte multa, allelúia."]}]},{"slot":"verse","body":[{"v":["Deus regenerávit nos in spem vivam, allelúia.","Per resurrectiónem Iesu Christi ex mórtuis, allelúia."]}]},null,{"slot":"verse","body":[{"v":["In resurrectióne tua, Christe, allelúia.","Cæli et terra læténtur, allelúia."]}]},{"slot":"verse","body":[{"v":["Dóminus apéruit illis sensum, allelúia.","Ut intellégerent Scriptúras, allelúia."]}]},{"slot":"verse","body":[{"v":["Spíritus Dómini replévit orbem terrárum, allelúia.","Et hoc quod cóntinet ómnia, sciéntiam habet vocis, allelúia."]}]},{"slot":"verse","body":[{"v":["Verbo Dómini cæli firmáti sunt.","Et Spíritu oris eius omnis virtus eórum."]}]},{"slot":"verse","body":[{"v":["Sapiéntia ædificávit sibi domum, allelúia.","Míscuit vinum et pósuit mensam, allelúia."]}]},{"slot":"verse","body":[{"v":["Vias tuas, Dómine, demónstra mihi.","Et sémitas tuas édoce me."]}]},{"slot":"verse","body":[{"v":["Memor ero óperum Dómini.","Memor ero ab inítio mirabílium suórum."]}]},{"slot":"verse","body":[{"v":["Hic venit ut testimónium perhibéret de lúmine.","Ut omnes créderent per illum."]}]},{"slot":"verse","body":[{"v":["Narravérunt laudes Dómini et virtútes eius.","Et mirabília eius quæ fecit."]}]},{"slot":"verse","body":[{"v":["María conservábat ómnia verba hæc.","Cónferens in corde suo."]}]},{"slot":"verse","body":[{"v":["Meditátio cordis mei in conspéctu tuo semper.","Dómine, adiútor meus et redémptor meus."]}]},{"slot":"verse","body":[{"v":["In colúmna nubis loquebátur ad eos.","Custodiébant testimónia eius."]}]},{"slot":"verse","body":[{"v":["Tribulátio et angústia invenérunt me.","Mandáta tua meditátio mea est."]}]},{"slot":"verse","body":[{"v":["Beáta es, María, quæ credidísti Dómino.","Perfécta sunt in te quæ dicta sunt tibi."]}]},{"slot":"verse","body":[{"v":["Sicut Móyses exaltávit serpéntem in desérto.","Ita exaltári opórtet Fílium hóminis."]}]},{"slot":"verse","body":[{"v":["Benedícite Dómino, omnes ángeli eius.","Poténtes virtúte, faciéntes verbum illíus."]}]},null,{"slot":"verse","body":[{"v":["Respícite ad Dóminum, et illuminámini.","Et fácies vestræ non confundéntur."]}]},{"slot":"verse","body":[{"v":["Misericórdiæ tuæ multæ Dómine.","Secúndum verbum tuum vivífica me."]}]},{"slot":"verse","body":[{"v":["Adorábo ad templum sanctum tuum.","Et confitébor nómini tuo, Dómine."]}]},{"slot":"verse","body":[{"v":["Ecce dedi te in lucem géntium.","Ut sis salus mea usque ad extrémum terræ."]}]},{"slot":"verse","body":[{"v":["Respícite et leváte cápita vestra.","Quóniam appropínquat redémptio vestra."]}]},{"slot":"verse","body":[{"v":["Vox clamántis in desérto: Paráte viam Dómini.","Rectas fácite sémitas Dei nostri."]}]},{"slot":"verse","body":[{"v":["Dómine Deus noster, convérte nos.","Et osténde fáciem tuam, et salvi érimus."]}]},{"slot":"verse","body":[{"v":["Audíte verbum Dómini, gentes.","Et annuntiáte illud in fínibus terræ."]}]},null,{"slot":"verse","body":[{"v":["Annúntiat Dóminus verbum suum Iacob.","Iustítias et iudícia sua Israel."]}]},{"slot":"verse","body":[{"v":["Osténde nobis, Dómine, misericórdiam tuam.","Et salutáre tuum da nobis."]}]},{"slot":"verse","body":[{"v":["Deus omnípotens præcínxit me virtúte.","Et pósuit immaculátam viam meam."]}]},{"slot":"verse","body":[{"v":["Véniat super me misericórdia tua, Dómine.","Salutáre tuum, secúndum elóquium tuum."]}]},null,{"slot":"verse","body":[{"v":["Annúntiat Dóminus verbum suum Iacob.","Iustítias et iudícia sua Israel."]}]},{"slot":"verse","body":[{"v":["Vox clamántis in desérto: Paráte viam Dómini.","Rectas fácite sémitas Dei nostri."]}]},{"slot":"verse","body":[{"v":["Véniat super me misericórdia tua, Dómine.","Salutáre tuum, secúndum elóquium tuum."]}]},{"slot":"verse","body":[{"v":["Ponam univérsos fílios tuos doctos a Dómino.","Et multitúdinem pacis fíliis tuis."]}]},{"slot":"verse","body":[{"v":["Cantábant sancti cánticum novum ante sedem Dei et Agni.","Et resonábat terra in voces illórum."]}]},{"slot":"verse","body":[{"v":["Vidéntes pastóres cognovérunt de verbo.","Quod dictum erat illis de Púero."]}]},{"slot":"verse","body":[{"v":["Notum fecit Dóminus, allelúia.","Salutáre suum, allelúia."]}]},{"slot":"verse","body":[{"v":["Novíssime Deus locútus est nobis in Fílio.","Per quem fecit et sǽcula."]}]},{"slot":"verse","body":[{"v":["Qui meditátur in lege Dómini.","Dabit fructum suum in témpore suo."]}]},{"slot":"verse","body":[{"v":["Deus regenerávit nos in spem vivam, allelúia.","Per resurrectiónem Iesu Christi ex mórtuis, allelúia."]}]},{"slot":"verse","body":[{"v":["Narravérunt laudes Dómini et virtútes eius, allelúia.","Et mirabília eius quæ fecit, allelúia."]}]},{"slot":"verse","body":[{"v":["María conservábat ómnia verba hæc, (allelúia).","Cónferens in corde suo, (allelúia)."]}]},{"slot":"verse","body":[{"v":["Notas mihi fecísti vias vitæ.","Adimplébis me lætítia cum vultu tuo."]}]},{"slot":"verse","body":[{"v":["Audiéntes gentes gavísæ sunt.","Et glorificábant verbum Dómini."]}]},{"slot":"verse","body":[{"v":["Annúntiat Dóminus verbum suum Iacob.","Iustítias et iudícia sua Israel."]}]},null,null,null]}
