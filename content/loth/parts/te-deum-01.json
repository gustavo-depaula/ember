{"id":"te-deum-01","parts":[[{"k":"title","lines":[["Hino"]]},{"k":"p","lines":[[{"m":"bold","t":"Te Deum"}],[{"m":"rubric","t":"(A VÓS, Ó DEUS, LOUVAMOS)"}]]},{"k":"p","lines":[["A vós, ó Deus, louvamos,"],["a vós, Senhor, cantamos."],["A vós, Eterno Pai,"],["adora toda a terra."]]},{"k":"p","lines":[["A vós cantam os anjos,"],["os céus e seus poderes:"],["Sois Santo, Santo, Santo,"],["Senhor, Deus do universo!"]]},{"k":"p","lines":[["Proclamam céus e terra"],["a vossa imensa glória."],["A vós celebra o coro"],["glorioso dos Apóstolos,"]]},{"k":"p","lines":[["Vos louva dos Profetas"],["a nobre multidão"],["e o luminoso exército"],["dos vossos santos Mártires."]]},{"k":"p","lines":[["A vós por toda a terra"],["proclama a Santa Igreja,"],["ó Pai onipotente,"],["de imensa majestade,"]]},{"k":"p","lines":[["e adora juntamente"],["o vosso Filho único,"],["Deus vivo e verdadeiro,"],["e ao vosso Santo Espírito."]]},{"k":"p","lines":[["Ó Cristo, Rei da glória,"],["do Pai eterno Filho,"],["nascestes duma Virgem,"],["a fim de nos salvar."]]},{"k":"p","lines":[["Sofrendo vós a morte,"],["da morte triunfastes,"],["abrindo aos que têm fé"],["dos céus o reino eterno."]]},{"k":"p","lines":[["Sentastes à direita"],["de Deus, do Pai na glória."],["Nós cremos que de novo"],["vireis como juiz."]]},{"k":"p","lines":[["Portanto, vos pedimos:"],["salvai os vossos servos,"],["que vós, Senhor, remistes"],["com sangue precioso."]]},{"k":"p","lines":[["Fazei-nos ser contados,"],["Senhor, vos suplicamos,"],["em meio a vossos santos"],["na vossa eterna glória."]]},{"k":"p","lines":[[{"m":"rubric","t":"(A parte que se segue pode ser omitida, se for oportuno)."}]]},{"k":"p","lines":[["Salvai o vosso povo."],["Senhor, abençoai-o."],["Regei-nos e guardai-nos"],["até a vida eterna."]]},{"k":"p","lines":[["Senhor, em cada dia,"],["fiéis, vos bendizemos,"],["louvamos vosso nome"],["agora e pelos séculos."]]},{"k":"p","lines":[["Dignai-vos, neste dia,"],["guardar-nos do pecado."],["Senhor, tende piedade"],["de nós, que a vós clamamos."]]},{"k":"p","lines":[["Que desça sobre nós,"],["Senhor, a vossa graça,"],["porque em vós pusemos"],["a nossa confiança."]]},{"k":"p","lines":[["Fazei que eu, para sempre,"],["não seja envergonhado:"],["Em vós, Senhor, confio,"],["sois vós minha esperança!"]]}],[{"k":"title","lines":[["Hino"]]},{"k":"p","lines":[["TE DEUM"],["(A VÓS, Ó DEUS, LOUVAMOS)"],[{"m":"link","t":"em latim","to":"tedeum_latim"}]]},{"k":"p","lines":[["A vós, ó Deus, louvamos,"],["a vós, Senhor, cantamos."],["A vós, Eterno Pai,"],["adora toda a terra."]]},{"k":"p","lines":[["A vós cantam os anjos,"],["os céus e seus poderes:"],["Sois Santo, Santo, Santo,"],["Senhor, Deus do universo!"]]},{"k":"p","lines":[["Proclamam céus e terra"],["a vossa imensa glória."],["A vós celebra o coro"],["glorioso dos Apóstolos,"]]},{"k":"p","lines":[["Vos louva dos Profetas"],["a nobre multidão"],["e o luminoso exército"],["dos vossos santos Mártires."]]},{"k":"p","lines":[["A vós por toda a terra"],["proclama a Santa Igreja,"],["ó Pai onipotente,"],["de imensa majestade,"]]},{"k":"p","lines":[["e adora juntamente"],["o vosso Filho único,"],["Deus vivo e verdadeiro,"],["e ao vosso Santo Espírito."]]},{"k":"p","lines":[["Ó Cristo, Rei da glória,"],["do Pai eterno Filho,"],["nascestes duma Virgem,"],["a fim de nos salvar."]]},{"k":"p","lines":[["Sofrendo vós a morte,"],["da morte triunfastes,"],["abrindo aos que têm fé"],["dos céus o reino eterno."]]},{"k":"p","lines":[["Sentastes à direita"],["de Deus, do Pai na glória."],["Nós cremos que de novo"],["vireis como juiz."]]},{"k":"p","lines":[["Portanto, vos pedimos:"],["salvai os vossos servos,"],["que vós, Senhor, remistes"],["com sangue precioso."]]},{"k":"p","lines":[["Fazei-nos ser contados,"],["Senhor, vos suplicamos,"],["em meio a vossos santos"],["na vossa eterna glória."]]},{"k":"p","lines":[[{"m":"rubric","t":"(A parte que se segue pode ser omitida, se for oportuno)."}]]},{"k":"p","lines":[["Salvai o vosso povo."],["Senhor