{"id":"responsory-04","parts":[[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Felizes, ó Senhor,"],[{"m":"rubric","t":"*"}," Os que habitam vossa casa! ",{"m":"rubric","t":"℟."}," Felizes."],[{"m":"rubric","t":"V."}," Para sempre haverão de vos louvar."],[{"m":"rubric","t":"*"}," Os que habitam."],["Glória ao Pai. ",{"m":"rubric","t":"℟."},"Felizes."]]}],[{"k":"p","lines":[["Responsório breve"],[{"m":"rubric","t":"℟."}," Vossa é a grandeza e o poder,"],["* Vosso é o reino, ó Senhor. R. Vossa."],[{"m":"rubric","t":"℣."}," Sobre tudo dominais. * Vosso é o reino."],["Glória ao Pai. R. Vossa é a grandeza."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Vosso trono, ó Deus,"],[{"m":"rubric","t":"*"}," É eterno, sem fim. ",{"m":"rubric","t":"℟."}," Vosso trono."],[{"m":"rubric","t":"V."}," Vosso cetro real é sinal de justiça. ",{"m":"rubric","t":"*"}," É eterno."],["Glória ao Pai. ",{"m":"rubric","t":"℟."}," Vosso trono."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Que o universo rejubile e dê gritos de alegria:"],[{"m":"rubric","t":"*"}," Pois o Senhor há de chegar ",{"m":"rubric","t":"℟."},"Que o universo."],[{"m":"rubric","t":"℣."},"Eu vi um novo céu, eu vi uma nova terra;"],["nunca mais haverá choro nem clamor nem aflição."],[{"m":"rubric","t":"*"}," Pois o Senhor. Glória ao Pai. ",{"m":"rubric","t":"℟."},"Que o universo."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Alegremo-nos, todos, no Senhor!"],[{"m":"rubric","t":"*"}," Alegremos, pois ele está bem perto! ",{"m":"rubric","t":"℟."}," Alegremo-nos."],[{"m":"rubric","t":"℣."}," Favorecestes, ó Senhor, a vossa terra, libertastes os cativos de Jacó."],[{"m":"rubric","t":"*"}," Alegremo-nos. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Alegremo-nos."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Nossa alma espera no Senhor,"],[{"m":"rubric","t":"*"}," Nele se alegra o nosso coração. ",{"m":"rubric","t":"℟."}," Nossa alma."],[{"m":"rubric","t":"V."}," Está perto a salvação dos que o respeitam."],[{"m":"rubric","t":"*"}," Nele se alegra. Glória ao Pai. ",{"m":"rubric","t":"℟."},"Nossa alma."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Eis o tempo favorável,"],[{"m":"rubric","t":"*"}," Eis o dia da salvação! ",{"m":"rubric","t":"℟."}," Eis o tempo."],[{"m":"rubric","t":"℣."}," O Reino de Deus está bem perto. ",{"m":"rubric","t":"*"}," Eis o dia."],["Glória ao Pai. ",{"m":"rubric","t":"℟."}," Eis o tempo."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," A vós, ó Deus, a nossa gratidão:"],[{"m":"rubric","t":"*"}," Vosso nome está perto. ",{"m":"rubric","t":"℟."}," A vós, ó Deus."],[{"m":"rubric","t":"V."}," De vós, Senhor, virá a renovação. ",{"m":"rubric","t":"*"}," Vosso nome."],["Glória ao Pai. ",{"m":"rubric","t":"℟."}," A vós, ó Deus."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Nossa alma espera no Senhor,"],[{"m":"rubric","t":"*"}," Nele se alegra o nosso coração. ",{"m":"rubric","t":"℟."}," Nossa alma."],[{"m":"rubric","t":"℣."}," Sua glória habitará em nossa terra. ",{"m":"rubric","t":"*"}," Nele se alegra."],["Glória ao Pai. ",{"m":"rubric","t":"℟."}," Nossa alma."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Alegremo-nos, todos, no Senhor!"],[{"m":"rubric","t":"*"}," Alegremo-nos, pois ele está bem perto!"],[{"m":"rubric","t":"R."}," Alegremo-nos."],[{"m":"rubric","t":"℣."}," Favorecestes, ó Senhor, a vossa terra,"],["libertastes os cativos de Jacó. ",{"m":"rubric","t":"*"}," Alegremo-nos."],["Glória ao Pai.",{"m":"rubric","t":"℟."},"Alegremo-nos."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Eu vos exalto, ó Senhor,"],[{"m":"rubric","t":"*"}," Pois me livrastes. ",{"m":"rubric","t":"℟."}," Eu vos."],[{"m":"rubric","t":"℣."}," E não deixastes rir de mim meus inimigos."],[{"m":"rubric","t":"*"}," Pois me. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Eu vos exalto."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Foi nisto que eu vi."],[{"m":"rubric","t":"*"}," Porque vós me escolhestes. ",{"m":"rubric","t":"℟."}," Foi nisto."],[{"m":"rubric","t":"℣."}," Porque não triunfou sobre mim o inimigo."],[{"m":"rubric","t":"*"}," Porque vós. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Foi nisto."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Eis o tempo favorável,"],[{"m":"rubric","t":"*"}," Eis o dia da salvação!. ",{"m":"rubric","t":"℟."}," Eis o tempo."],[{"m":"rubric","t":"℣."}," O Reino de Deus está perto. ",{"m":"rubric","t":"*"}," Eis o dia."],["Glória ao Pai. ",{"m":"rubric","t":"℟."}," Eis o tempo."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Nossa alma espera no Senhor,"],[{"m":"rubric","t":"*"}," Nele se alegra o nosso coração. ",{"m":"rubric","t":"℟."}," Nossa alma."],[{"m":"rubric","t":"℣."}," Está perto a salvação dos que o repeitam."],[{"m":"rubric","t":"*"}," Nele se alegra. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Nossa alma."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Que o universo rejubile e dê gritos de alegria:"],[{"m":"rubric","t":"*"}," Pois o Senhor há de chegar! ",{"m":"rubric","t":"℟."},"Que o universo."],[{"m":"rubric","t":"V."}," Eis aqui a habitação de Deus no meio de nós,"],["nós seremos o seu povo, e ele, o Deus conosco!"],[{"m":"rubric","t":"*"}," Pois o Senhor. Glória ao Pai. ",{"m":"rubric","t":"℟."},"Que o universo."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Que o universo rejubile e dê gritos de alegria:"],[{"m":"rubric","t":"*"}," Pois o Senhor há de chegar! ",{"m":"rubric","t":"℟."}," Que o universo."],[{"m":"rubric","t":"℣."}," Nunca mais haverá noite"],["e eles não precisarão da luz da lâmpada ou do sol."],["O Senhor será sua luz."],[{"m":"rubric","t":"*"}," Pois o Senhor. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Que o universo."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Alegremo-nos, todos, no Senhor!"],[{"m":"rubric","t":"*"}," Alegremo-nos, pois ele está bem perto!"],[{"m":"rubric","t":"℟."}," Alegremo-nos."],[{"m":"rubric","t":"℣."}," A justiça andará na sua frente,"],["e a salvação no vestígio de seus passos. ",{"m":"rubric","t":"*"}," Alegremo-nos."],["Glória ao Pai. ",{"m":"rubric","t":"℟."},"Alegremo-nos."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Hoje sabereis:"],[{"m":"rubric","t":"*"}," O Senhor mesmo virá. ",{"m":"rubric","t":"℟."},"Hoje."],[{"m":"rubric","t":"V."}," E amanhã haveis de ver sua glória em nosso meio."],[{"m":"rubric","t":"*"}," O Senhor. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Hoje."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," A Palavra se fez carne."],[{"m":"rubric","t":"*"}," E habitou entre nós. ",{"m":"rubric","t":"℟."}," A Palavra."],[{"m":"rubric","t":"℣."}," Todos nós recebemos de sua plenitude. ",{"m":"rubric","t":"*"}," E habitou."],["Glória ao Pai. ",{"m":"rubric","t":"℟."}," A Palavra."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Convinha que em tudo fosse igual a seus irmãos,"],[{"m":"rubric","t":"*"}," Para poder ter pena deles. ",{"m":"rubric","t":"℟."}," Convinha."],[{"m":"rubric","t":"V."}," Deus foi visto em nossa terra convivendo com seu povo."],[{"m":"rubric","t":"*"}," Para poder. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Convinha."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Senhor, eu vos dou graças"],[{"m":"rubric","t":"*"}," De todo o coração! ",{"m":"rubric","t":"℟."},"Senhor."],[{"m":"rubric","t":"℣."}," Vou louvar-vos entre os povos. ",{"m":"rubric","t":"*"}," De todo."],["Glória ao Pai. ",{"m":"rubric","t":"℟."}," Senhor."]]}],[{"k":"p","lines":[[{"m":"rubric","t":"Responsório breve"}]]},{"k":"p","lines":[[{"m":"note","t":"No Tempo da Páscoa"}],[{"m":"rubric","t":"℟."}," Maria, alegra-te, ó cheia de graça;"],["o Senhor é contigo!"]]},{"k":"p","lines":[[{"m":"rubric","t":"*"}," Aleluia, aleluia. ",{"m":"rubric","t":"℟."}," Maria."],[{"m":"rubric","t":"V."}," És bendita entre todas as mulheres da terra"],["e bendito é o fruto que nasceu do teu ventre!"],[{"m":"rubric","t":"*"}," Aleluia, aleluia. Glória ao Pai."]]},{"k":"p","lines":[[{"m":"note","t":"No Tempo Comum"}],[{"m":"rubric","t":"℟."}," Maria, alegra-te, ó cheia de graça;"]]},{"k":"p","lines":[[{"m":"rubric","t":"*"}," O Senhor é contigo! ",{"m":"rubric","t":"℟."}," Maria."],[{"m":"rubric","t":"V."}," És bendita entre todas as mulheres da terra"],["e bendito é o fruto que nasceu do teu ventre!"],[{"m":"rubric","t":"*"}," O Senhor. Glória ao Pai."]]}],[{"k":"p","lines":[[{"m":"rubric","t":"Responsório breve"}],[{"m":"rubric","t":"R."}," Acolhe Israel, seu servidor,"],[{"m":"rubric","t":"*"}," Fiel ao seu amor. ",{"m":"rubric","t":"℟."},"Acolhe."],[{"m":"rubric","t":"℣."},"Como havia prometido a nossos pais.",{"m":"rubric","t":"*"}," Fiel."],["Glória ao Pai. ",{"m":"rubric","t":"℟."},"Acolhe."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Anunciai, entre as nações,"],[{"m":"rubric","t":"*"}," A glória do Senhor. ",{"m":"rubric","t":"℟."}," Anunciai."],[{"m":"rubric","t":"℣."}," E entre os povos do universo, as suas maravilhas."],[{"m":"rubric","t":"*"}," A glória. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Anunciai."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."},"Anunciai, entre as nações, a glória do Senhor."],[{"m":"rubric","t":"*"}," Aleluia, aleluia. ",{"m":"rubric","t":"℟."},"Anunciai."],[{"m":"rubric","t":"℣."},"E entre os povos do universo, as suas maravilhas."],[{"m":"rubric","t":"*"},"Aleluia, aleluia. Glória ao Pai. ",{"m":"rubric","t":"℟."},"Anunciai."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," No meio da assembléia falou palavras sábias."],[{"m":"rubric","t":"*"}," Aleluia, aleluia. ",{"m":"rubric","t":"℟."}," No meio."],[{"m":"rubric","t":"℣."}," Deus o encheu com seu Espírito de saber e inteligência."],[{"m":"rubric","t":"*"}," Aleluia. Glória ao Pai. ",{"m":"rubric","t":"℟."}," No meio."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."},"O amigo do Esposo se alegra,"],[{"m":"rubric","t":"*"}," Ouvindo a voz do Esposo. ",{"m":"rubric","t":"℟."},"O amigo."],[{"m":"rubric","t":"℣."},"Eis minha perfeita alegria! ",{"m":"rubric","t":"*"}," Ouvindo."],["Glória ao Pai. ",{"m":"rubric","t":"℟."},"O amigo."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Seus filhos se levantarão,"],[{"m":"rubric","t":"*"}," Eles hão de chamá-la ditosa. ",{"m":"rubric","t":"℟."}," Seus filhos."],[{"m":"rubric","t":"V."}," Ele abriu os seus lábios com sabedoria,"],["sua língua ensinou com amor e bondade. ",{"m":"rubric","t":"*"}," Eles hão."],["Glória ao Pai. ",{"m":"rubric","t":"℟."}," Seus filhos."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Glorioso aparecestes ante a face do Senhor."],[{"m":"rubric","t":"*"}," Aleluia, aleluia. ",{"m":"rubric","t":"℟."}," Glorioso."],[{"m":"rubric","t":"℣."}," Foi por isso que o Senhor vos vestiu de majestade."],[{"m":"rubric","t":"*"}," Aleluia. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Glorioso."]]}],[{"k":"p","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," O sinal da santa Cruz estará no céu,"],["* Quando o Senhor Jesus vier para julgar. R. O sinal."],[{"m":"rubric","t":"℣."}," Levantai vossa cabeça e olhai,"],["pois, a vossa redenção se aproxima. * Quando o Senhor."],["Glória ao Pai. R. O sinal."]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Senhor, em vossas mãos"],[{"m":"rubric","t":"*"}," Eu entrego o meu espírito. ",{"m":"rubric","t":"℟."}," Senhor."],[{"m":"rubric","t":"℣."}," Vós sois o Deus fiel, que salvastes vosso povo."],[{"m":"rubric","t":"*"}," Eu entrego. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Senhor."]]}],[{"k":"title","lines":[["Responsório breve"]]}],[{"k":"title","lines":[["Responsório breve"]]},{"k":"p","lines":[[{"m":"rubric","t":"℟."}," Senhor, em vossas mãos eu entrego o meu espírito."],[{"m":"rubric","t":"*"}," Aleluia, aleluia. ",{"m":"rubric","t":"℟."}," Senhor."],[{"m":"rubric","t":"℣."}," Vós sois o Deus fiel, que salvastes vosso povo."],[{"m":"rubric","t":"*"}," Aleluia, aleluia. Glória ao Pai. ",{"m":"rubric","t":"℟."}," Senhor."]]}]]}
