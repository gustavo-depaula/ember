{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ember-relay",
  "main": "src/app.ts",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  // No database_id: the first deploy creates the database and binds it. The Worker makes its own
  // tables (src/schema.ts), so there is no migration step to run against it.
  "d1_databases": [{ "binding": "DB", "database_name": "ember-relay" }],
  "ratelimits": [
    // Everyday traffic of one device: a pull a minute, a push after each change.
    { "name": "LIMITER", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
    // Guesses at a pairing code, per address.
    { "name": "PAIRING_LIMITER", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } }
  ]
}
