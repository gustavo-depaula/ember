{
  "expo": {
    "name": "Ember",
    "slug": "ember",
    "scheme": "ember",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0D0C",
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "me.dpgu.ember",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4E8CF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "me.dpgu.ember",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" },
          "android": { "enableMinifyInReleaseBuilds": true }
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A84C"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-image",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Ember to use your location to find Mass and confession times at nearby churches.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Ember does not read motion data. This text is required by an animation library the app includes."
        }
      ],
      "expo-maps",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ember to attach a photo (e.g. a parish bulletin) to your correction.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "./plugins/withAndroidTheme",
      "./plugins/withAndroidGradleMemory",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4E8CF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E0D0C"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f282c90-7689-4b7e-b8c0-707279d09c5c"
      }
    },
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/4f282c90-7689-4b7e-b8c0-707279d09c5c"
    }
  }
}
