---
// The day's plan of life, for a browser connected to an account: drawn by
// `personal/plan.ts` into these empty, hidden places, so the page a visitor or
// a search engine reads is the same without it. On a wide screen it stands at
// the top of the right column, as the app's wide-window panel does; on a
// narrow one it is a card on the Pray shelf that opens the list in a sheet.
import Icon from '~/components/Icon.astro'
import { practiceIcons } from '~/lib/icons'
import { type Locale, translator } from '~/lib/locale'
import { siteStrings } from '~/lib/strings'

interface Props {
  locale: Locale
  part: 'panel' | 'card'
}

const { locale, part } = Astro.props
const t = translator(locale)
const s = siteStrings(locale)
const glyphs = [...Object.keys(practiceIcons), 'sparkles', 'check', 'chevron-right', 'x']
---

{
  part === 'card' ? (
    <button class="plan-card" type="button" data-plan-card hidden aria-label={t('a11y.openTodayPlan')} />
  ) : (
    <>
      <section class="plan-panel" data-plan-panel data-plan hidden>
        <h2 class="pl-marker">{t('home.planOfLife')}</h2>
        <div data-plan-list />
      </section>
      <div class="plan-scrim" data-plan-scrim hidden />
      <aside class="plan-sheet" data-plan-sheet hidden role="dialog" aria-modal="true" aria-label={t('home.planOfLife')}>
        <button class="plan-close" type="button" data-plan-close aria-label={s('dismiss')}>
          <Icon name="x" size={22} />
        </button>
        <h2 class="t-screen">{t('home.planOfLife')}</h2>
        <div data-plan-list />
      </aside>
      <template data-plan-icons>
        {glyphs.map((name) => (
          <span data-icon={name}>
            <Icon name={name} size={name === 'check' ? 14 : name === 'chevron-right' ? 16 : 20} />
          </span>
        ))}
      </template>
    </>
  )
}

<style is:global>
  /* The app's TimeBlockSection, in its own type: Cinzel parts of the day,
     EB Garamond names, the subtle check. */
  .pl {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pl-marker {
    margin: 0 0 16px;
    font-family: var(--font-heading);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-burgundy);
  }
  .pl-part {
    font-family: var(--font-heading);
    font-size: 15px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-secondary);
  }
  .pl-count {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-secondary);
    font-variant-numeric: lining-nums;
  }
  .pl-head {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 4px;
    background: none;
    border: 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .pl-head svg {
    color: var(--accent);
  }
  .pl-head.pl-preview {
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
  }
  .pl-line {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pl-names {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 20px;
    color: var(--color-secondary);
    opacity: 0.6;
  }
  .pl-open > .pl-head {
    justify-content: space-between;
    padding: 0 4px 4px;
    border-bottom: 0.5px solid var(--accent-subtle);
  }
  .pl-open {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pl-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 4px;
  }
  .pl-check {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--background);
    cursor: pointer;
  }
  .pl-row.done .pl-check {
    background: var(--accent-subtle);
    border-color: var(--accent-subtle);
  }
  .pl-check:focus-visible,
  .pl-head:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .pl-icon {
    display: flex;
    color: var(--accent);
  }
  .pl-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pl-name {
    font-family: var(--font-body);
    font-size: 21px;
    line-height: 27px;
    color: var(--color);
  }
  a.pl-name:hover {
    color: var(--gold-ink);
  }
  .pl-row.done .pl-name {
    color: var(--color-secondary);
  }
  .pl-sub {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 23px;
    color: var(--color-secondary);
  }
  .pl-dots {
    display: flex;
    gap: 4px;
  }
  .pl-dots i {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 3px;
  }
  .pl-dots .essential {
    background: var(--color-burgundy);
  }
  .pl-dots .ideal {
    background: var(--accent);
  }
  .pl-chev {
    display: flex;
    color: var(--accent-subtle);
  }
  .pl-legend {
    display: flex;
    justify-content: center;
    gap: 24px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-secondary);
  }
  .pl-legend span {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .pl-empty {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-secondary);
    text-align: center;
  }

  .plan-panel {
    padding-bottom: 32px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border-color);
  }

  /* The card: a page of the Ordo, its band the day's standing (PlanOfLifeCard). */
  .plan-card {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: var(--plan-card, 150px);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .plan-card .sheet {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: #f3ead6;
    box-shadow: 0 5px 14px rgba(0, 0, 0, 0.3);
    overflow: hidden;
  }
  .plan-card .band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 20%;
    padding: 0 9%;
    background: linear-gradient(var(--from), var(--to));
    border-bottom: 1px solid var(--to);
    box-shadow: 0 2px 0 #f3ead6, 0 3px 0 var(--to);
    font-family: var(--font-heading);
    font-size: 10px;
    letter-spacing: 1.6px;
    color: #f5efe2;
  }
  .plan-card .band b {
    font-weight: 400;
    color: #d4af5a;
  }
  .plan-card .title {
    margin: 9% 9% 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.1;
    color: #2a1f16;
  }
  .plan-card ul {
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: 8%;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .plan-card li {
    font-family: var(--font-heading);
    font-size: 8.5px;
    line-height: 1.2;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    color: #2a1f16;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .plan-card li.done {
    opacity: 0.45;
  }
  .plan-card li.late {
    color: #9b2226;
  }
  .plan-card .note {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 13px;
    color: #5b4a38;
    text-transform: none;
    letter-spacing: 0;
    white-space: normal;
  }
  .plan-card .caption {
    font-family: var(--font-heading);
    font-size: 15px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color);
  }

  .plan-scrim {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(0, 0, 0, 0.35);
  }
  .plan-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 61;
    max-height: calc(100dvh - 64px);
    overflow: auto;
    padding: 44px 22px calc(40px + env(safe-area-inset-bottom));
    border-radius: 22px 22px 0 0;
    background: var(--background);
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.4);
  }
  .plan-sheet::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    width: 40px;
    height: 5px;
    margin-left: -20px;
    border-radius: 3px;
    background: var(--color-secondary);
    opacity: 0.4;
  }
  .plan-sheet h2 {
    margin: 0 0 16px;
  }
  .plan-close {
    position: absolute;
    top: 30px;
    right: 18px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    color: var(--color-secondary);
    cursor: pointer;
  }
  body:has(.plan-sheet:not([hidden])) {
    overflow: hidden;
  }

  /* One place at a time: the column on a wide screen, the card on a narrow one. */
  @media (min-width: 1000px) {
    .plan-card,
    .plan-sheet,
    .plan-scrim {
      display: none !important;
    }
  }
  @media (max-width: 999px) {
    .plan-panel {
      display: none !important;
    }
  }
</style>
