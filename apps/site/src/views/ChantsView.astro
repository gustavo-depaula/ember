---
import Base from '~/layouts/Base.astro'
import { loadChantLibrary } from '~/lib/chants'
import type { Locale } from '~/lib/locale'

interface Props {
  locale: Locale
  alternates: Partial<Record<Locale, string>>
}

const { locale, alternates } = Astro.props
const pt = locale === 'pt-BR'
const books = await loadChantLibrary(locale)
const title = pt ? 'Canto gregoriano' : 'Gregorian chant'
const description = pt
  ? 'O Kyriale, hinos e antífonas em notação quadrada: o canto da Missa e das orações da Igreja, de leitura gratuita.'
  : 'The Kyriale, hymns and antiphons in square notes: the chant of the Mass and of the Church’s prayers, free to read.'
---

<Base locale={locale} title={title} description={description} alternates={alternates} section="chant">
  <div class="wide">
    <header class="page-head">
      <h1 class="t-screen">{title}</h1>
    </header>
    {books.map((book) => (
      <section class="book" id={book.id}>
        <div class="row-head"><h2>{book.title}</h2></div>
        <p class="lede">{book.description}</p>
        <div class="masses">
          {book.sections.map((section) => (
            <section class="mass" id={section.id}>
              <h3 class="row-title">{section.title}{section.name && <em>{section.name}</em>}</h3>
              {section.occasion && <p class="t-caption">{section.occasion}</p>}
              <ul>
                {section.chants.map((chant) => (
                  <li>
                    <a href={chant.href}>
                      <span>{chant.name}</span>
                      {chant.subtitle && <span class="nick">{chant.subtitle}</span>}
                      {chant.mode && <span class="mode">{chant.mode}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
    ))}
    <p class="t-annotation source">GregoBase, CC0</p>
  </div>
</Base>

<style>
  .book {
    padding-bottom: var(--space-lg);
    scroll-margin-top: 88px;
  }
  .book .lede {
    max-width: 34em;
    padding-bottom: var(--space-md);
    color: var(--color-secondary);
  }
  /* The table of a chant book: Masses in columns, as its index prints them. */
  .masses {
    columns: 300px 3;
    column-gap: var(--space-xl);
  }
  .mass {
    break-inside: avoid;
    padding-bottom: var(--space-lg);
    scroll-margin-top: 88px;
  }
  .mass h3 em {
    margin-left: 0.5em;
    color: var(--color-secondary);
  }
  .mass ul {
    margin-top: 6px;
    border-top: 1px solid var(--border-color);
  }
  .mass a {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    padding-block: 7px;
    border-bottom: 1px solid var(--border-color);
  }
  .mass a:hover span:first-child {
    color: var(--gold-ink);
  }
  .nick {
    font-style: italic;
    color: var(--color-secondary);
  }
  /* The mode, set at the row's end as the books set it over the initial. */
  .mode {
    margin-left: auto;
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--color-secondary);
    font-variant-numeric: lining-nums;
  }
  .source {
    padding-block: var(--space-md) var(--space-xl);
  }
</style>
