---
import { getImage } from 'astro:assets'
import { aspirationFor } from '@/features/home/aspirations'
import appShotEn from '../../../hearth/site/img/en-US-01-today.webp'
import appShotPt from '../../../hearth/site/img/pt-BR-01-today.webp'
import Celebrations from '~/components/Celebrations.astro'
import MassTimesNotice from '~/components/MassTimesNotice.astro'
import Shelf from '~/components/Shelf.astro'
import Base from '~/layouts/Base.astro'
import { bibleRefFor } from '~/lib/citations'
import { calendarYears } from '~/lib/dates'
import { loadHome } from '~/lib/home'
import { type Locale, translator } from '~/lib/locale'
import { siteStrings } from '~/lib/strings'
import { addDays, today } from '~/lib/today'
import { hourNames, href, officeHours } from '~/routes'

interface Props {
  locale: Locale
  alternates: Partial<Record<Locale, string>>
}

const { locale, alternates } = Astro.props
const t = translator(locale)
const s = siteStrings(locale)
const pt = locale === 'pt-BR'
const home = await loadHome(today, locale)

const weekday = new Intl.DateTimeFormat(locale, { weekday: 'long' }).format(today)
const monthDay = new Intl.DateTimeFormat(locale, { month: 'long', day: 'numeric' }).formatToParts(today)
const dateTitle = monthDay.map((p) => (p.type === 'month' ? p.value.charAt(0).toUpperCase() + p.value.slice(1) : p.value)).join('')
const years = calendarYears()
const ahead = [1, 2, 3, 4].map((n) => addDays(today, n)).filter((d) => years.includes(d.getFullYear()))


const appShot = await getImage({ src: pt ? appShotPt : appShotEn, width: 420, format: 'webp' })

const slotLabel = pt
  ? { first: 'Primeira leitura', psalm: 'Salmo', second: 'Segunda leitura', gospel: 'Evangelho' }
  : { first: 'First reading', psalm: 'Psalm', second: 'Second reading', gospel: 'Gospel' }
const obligations = home.of.obligations.details
  .map((d) => (d as Record<string, string | undefined>)[locale] ?? d['en-US'])
  .filter(Boolean)

const pillars = pt
  ? [
      { title: 'Um plano de vida', body: 'Monte uma regra diária de oração e guarde-a, com lembretes e um céu de estrelas que mostra a sua fidelidade.' },
      { title: 'Santinhos', body: 'Cartões recebidos pela prática da oração, cada um a apresentação de uma vida santa.' },
      { title: 'Um leitor para a leitura longa', body: 'Fontes, margens e paletas à sua escolha, marcadores, destaques e notas, tudo disponível sem conexão.' },
    ]
  : [
      { title: 'A plan of life', body: 'Build a daily rule of prayer and keep it, with reminders and a wall of stars that shows how faithfully you have kept it.' },
      { title: 'Holy cards', body: 'Given through the practice of prayer, each one an introduction to a holy life.' },
      { title: 'A reader for long reading', body: 'Your choice of typeface, margins and palette, with bookmarks, highlights and notes, all available offline.' },
    ]
---

<Base
  locale={locale}
  title={s('siteName')}
  alternates={alternates}
  section="home"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Ember',
    url: new URL(href.home(locale), Astro.site).href,
    description: s('description'),
    inLanguage: locale,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${new URL(href.section(locale, 'search'), Astro.site).href}?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <div class="wide home">
    <header class="today">
      <p class="kicker">
        <a href={href.section(locale, 'calendar')}>{weekday} · {home.of.seasonName}</a>
      </p>
      <h1 class="date">
        <span>{dateTitle}</span>
        {ahead.map((d, i) => (
          <a class={`ahead a${i}`} href={href.calendarDay(locale, d)} aria-label={new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(d)}>
            {d.getDate()}
          </a>
        ))}
      </h1>
      <p class="day-name">{home.of.celebrations[0]?.title ?? home.of.dayName}</p>
    </header>

    <section class="carousel" aria-label={s('today')}>
      <div class="features" data-carousel>
        {home.features.map((feature) => (
          <a class="feature" href={feature.href} style={`--from:${feature.tone.from};--to:${feature.tone.to}`}>
            {feature.art ? (
              <span class="feature-art"><img src={feature.art} alt="" loading="lazy" decoding="async" /></span>
            ) : (
              <span class="feature-plate" aria-hidden="true">✠</span>
            )}
            <span class="feature-foot">
              <span class="feature-kicker">{feature.kicker}</span>
              <span class="feature-title">{feature.title}</span>
              {feature.subtitle && <span class="feature-sub">{feature.subtitle}</span>}
            </span>
          </a>
        ))}
        <a class="feature app" href={href.landing(locale)}>
          <span class="feature-phone"><img src={appShot.src} alt="" loading="lazy" decoding="async" /></span>
          <span class="feature-foot">
            <span class="feature-kicker">{pt ? 'O aplicativo' : 'The app'}</span>
            <span class="feature-title">{pt ? 'Ember no seu celular' : 'Ember on your phone'}</span>
            <span class="feature-sub">{s('nudgeBody')}</span>
            <span class="feature-cta">{s('seeTheApp')} →</span>
          </span>
        </a>
      </div>
      <button class="carousel-next" type="button" data-carousel-next hidden aria-label={pt ? 'Próximos' : 'More'}>→</button>
    </section>

    <div class="dash">
      <div class="dash-main">
        <Shelf title={pt ? 'Rezar' : 'Pray'} tiles={home.pray} locale={locale} more={href.section(locale, 'prayers')} width={150} />

        {home.meditations.length > 0 && (
          <section>
            <div class="row-head"><h2>{t('explore.dailyMeditations')}</h2></div>
            <div class="shelf">
              {home.meditations.map((m) => (
                <a class="meditation" href={m.href}>
                  {m.art && <img src={m.art} alt="" loading="lazy" decoding="async" />}
                  <span class="meditation-text">
                    <span class="meditation-title">{m.title}</span>
                    <span class="meditation-sub">{m.tagline}</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="dash-aside" aria-label={pt ? 'A liturgia de hoje' : 'The liturgy today'}>
        <section class="panel">
          <h2 class="t-marker">{pt ? 'Santa Missa' : 'Holy Mass'}</h2>
          <p class="t-kicker">{home.of.dayName}</p>
          <Celebrations celebrations={home.of.celebrations} />
          {home.of.holyDay && <p class="gold">{t('calendar.holyDay')}</p>}
          {obligations.map((detail) => <p class="t-rubric">{detail}</p>)}
          {home.of.readings.length > 0 && (
            <ul class="readings">
              {home.of.readings.map((reading) => {
                const ref = bibleRefFor(reading.citation, locale)
                return (
                  <li>
                    <span class="t-kicker">{slotLabel[reading.slot]}</span>
                    {ref ? <a class="xref" href={href.bibleChapter('en-US', ref.book, ref.chapter)}>{reading.citation}</a> : <span>{reading.citation}</span>}
                  </li>
                )
              })}
            </ul>
          )}
          <a class="go" href={href.mass(locale)}>{pt ? 'Missa do dia' : 'Mass of the day'} →</a>
        </section>

        <section class="panel">
          <h2 class="t-marker">{pt ? 'Missal de 1962' : 'The 1962 Missal'}</h2>
          <p class="t-kicker">{home.ef.dayName}</p>
          <p class="ef-name" lang="la">{home.ef.name}</p>
          <p class="t-kicker" lang="la">{home.ef.rankText}</p>
          <a class="go" href={href.latinMass(locale)}>{pt ? 'Missa tridentina' : 'Traditional Latin Mass'} →</a>
        </section>

        <section class="panel">
          <h2 class="t-marker">{pt ? 'Ofício Divino' : 'The Divine Office'}</h2>
          <nav class="hours">
            {officeHours.map((hour) => <a href={href.office(locale, today, hour)}>{hourNames[locale][hour]}</a>)}
          </nav>
        </section>

        <MassTimesNotice locale={locale} />
      </aside>
    </div>

    <section class="places">
      <a class="place jewel" style="--from:#1E3A5C;--to:#0A1626" href={href.section(locale, 'bible')}>
        <span>{s('navBible')}</span>
      </a>
      <a class="place jewel" style="--from:#5A1722;--to:#24090E" href={href.section(locale, 'library')}>
        <span>{s('navLibrary')}</span>
      </a>
      <a class="place jewel" style="--from:#1E4A32;--to:#0C2418" href={href.section(locale, 'saints')}>
        <span>{s('navSaints')}</span>
      </a>
      <a class="place jewel" style="--from:#4A2860;--to:#1F1030" href={href.section(locale, 'calendar')}>
        <span>{s('navCalendar')}</span>
      </a>
    </section>

    <section class="pitch">
      <div class="pitch-text">
        <p class="t-kicker">{pt ? 'O aplicativo' : 'The app'}</p>
        <h2 class="t-sacred">{s('tagline')}</h2>
        <p class="lede">
          {pt
            ? 'Tudo o que está neste site, e mais o que é só seu: o plano de vida, os santinhos, as suas leituras. Gratuito e de código aberto, sem anúncios, contas nem rastreamento.'
            : 'Everything on this site, and what is yours alone: your plan of life, your holy cards, your reading. Free and open source, with no ads, no accounts and no tracking.'}
        </p>
        <a class="go" href={href.landing(locale)}>{s('seeTheApp')} →</a>
      </div>
      <ul class="pillars">
        {pillars.map((pillar) => (
          <li>
            <h3 class="t-label">{pillar.title}</h3>
            <p>{pillar.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <p class="aspiratio" lang="la">{aspirationFor(today)}</p>
  </div>
</Base>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .today {
    padding-top: var(--space-xl);
  }
  .kicker {
    font-family: var(--font-heading);
    font-size: 15px;
    line-height: 20px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .kicker a:hover {
    color: var(--gold-ink);
  }
  /* The screen's one typographic peak. */
  .date {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    margin-top: 4px;
    font-family: var(--font-title);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(46px, 9vw, 72px);
    line-height: 1.3;
    white-space: nowrap;
  }
  .ahead {
    font-size: 0.6em;
    transition: opacity 0.2s ease;
  }
  .ahead.a0 { opacity: 0.4; }
  .ahead.a1 { opacity: 0.25; }
  .ahead.a2 { opacity: 0.14; }
  .ahead.a3 { opacity: 0.07; }
  .ahead:hover { opacity: 0.8; }
  .day-name {
    font-size: 21px;
    line-height: 28px;
    color: var(--color-secondary);
    max-width: 30em;
  }

  .dash {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }
  .dash-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    min-width: 0;
  }
  .dash-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  @media (min-width: 1000px) {
    .dash {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 56px;
    }
    .dash-aside {
      padding-left: 40px;
      border-left: 0.5px solid var(--border-color);
    }
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .panel + .panel {
    padding-top: var(--space-lg);
    border-top: 0.5px solid var(--hairline);
  }
  .panel .t-marker {
    text-align: left;
    font-size: 14px;
    line-height: 20px;
  }
  .panel :global(.celebration-title) {
    font-size: 20px !important;
    line-height: 26px !important;
  }
  .panel :global(.principal .celebration-title) {
    font-size: 24px !important;
    line-height: 30px !important;
  }
  .readings li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: 6px;
    border-bottom: 0.5px solid var(--hairline);
    font-size: 17px;
  }
  .ef-name {
    font-family: var(--font-title);
    font-size: 21px;
    line-height: 27px;
    text-wrap: balance;
  }
  /* The app's carousel: the next card shows its edge, so the row reads as one to turn. */
  .carousel {
    position: relative;
  }
  .features {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    /* Room for the cards' shadow and lift, which a scroller would clip. */
    padding: 6px 2px 18px;
    margin: -6px -2px -18px;
  }
  .features::-webkit-scrollbar {
    display: none;
  }
  .carousel-next {
    position: absolute;
    right: -18px;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--glass-rim);
    background: var(--background);
    box-shadow: 0 4px 12px var(--glass-shadow);
    color: var(--color);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }
  @media (max-width: 900px) {
    .carousel-next {
      display: none;
    }
  }
  .feature {
    flex: 0 0 clamp(220px, 66vw, 290px);
    scroll-snap-align: start;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 1 / 1.3;
    border-radius: var(--radius-xl);
    overflow: hidden;
    color: #f5efe2;
    background: color-mix(in srgb, var(--from) 28%, #0b0908);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.18);
    transition: transform 0.25s ease;
  }
  /* The app's card: its Today screen, standing in the light. */
  .feature.app {
    background: radial-gradient(120% 75% at 50% 0%, #5a431c, #17120b 72%);
  }
  .feature-phone {
    position: absolute;
    inset: 6% 0 0 0;
    display: flex;
    justify-content: center;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 54%);
    mask-image: linear-gradient(180deg, #000 30%, transparent 54%);
  }
  .feature-phone img {
    align-self: flex-start;
    width: 68%;
    height: auto;
    border-radius: 9% / 4.2%;
    border: 1px solid rgba(232, 201, 122, 0.55);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.55);
    transition: transform 0.35s ease;
  }
  .feature.app:hover .feature-phone img {
    transform: translateY(-6px);
  }
  .feature-cta {
    align-self: flex-start;
    margin-top: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    background: #e8c97a;
    color: #1a1408;
    font-family: var(--font-heading);
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  .feature:hover {
    transform: translateY(-3px);
  }
  .feature-art {
    position: absolute;
    inset: 0 0 38% 0;
  }
  .feature-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .feature-art::after {
    content: '';
    position: absolute;
    inset: 55% 0 0 0;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--from) 28%, #0b0908));
  }
  .feature-plate {
    position: absolute;
    inset: 12% 22% auto 22%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: linear-gradient(162deg, var(--from), var(--to));
    font-family: var(--font-heading);
    font-size: 56px;
    color: #e8c97a;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.35);
  }
  .feature-foot {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 18px;
  }
  .feature-kicker {
    font-family: var(--font-heading);
    font-size: 11px;
    line-height: 14px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: rgba(245, 239, 226, 0.62);
  }
  .feature-title {
    font-family: var(--font-title);
    font-weight: 500;
    font-size: 21px;
    line-height: 25px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .feature-sub {
    font-size: 14px;
    line-height: 19px;
    color: rgba(245, 239, 226, 0.7);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 1000px) {
    .features {
      gap: 20px;
    }
    /* Four to the row, and the edge of a fifth. */
    .feature {
      flex-basis: clamp(240px, 22.5vw, 286px);
    }
    .feature-foot {
      padding: 24px;
      gap: 7px;
    }
    .feature-kicker {
      font-size: 12px;
    }
    .feature-title {
      font-size: 26px;
      line-height: 31px;
    }
    .feature-sub {
      font-size: 16px;
      line-height: 22px;
    }
  }

  .hours {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
  }
  .hours a {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    font-size: 19px;
    color: var(--color-secondary);
    transition: color 0.2s ease;
  }
  .hours a:hover {
    color: var(--gold-ink);
  }

  .meditation {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 200px;
    height: 240px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: #24090e;
    color: #f5efe2;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.18);
    transition: transform 0.25s ease;
  }
  .meditation:hover {
    transform: translateY(-3px);
  }
  .meditation img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .meditation::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.55) 58%, rgba(0, 0, 0, 0.88));
  }
  .meditation-text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
  }
  .meditation-title {
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 19px;
    line-height: 22px;
  }
  .meditation-sub {
    font-size: 14px;
    line-height: 19px;
    color: rgba(245, 239, 226, 0.82);
  }

  .places {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }
  .place {
    display: flex;
    align-items: flex-end;
    min-height: 132px;
    padding: 18px;
    font-family: var(--font-title);
    font-size: 22px;
    line-height: 26px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--from) 92%, #fff), color-mix(in srgb, var(--from) 76%, #000));
  }
  @media (max-width: 760px) {
    .places {
      grid-template-columns: repeat(2, 1fr);
    }
    .place {
      min-height: 104px;
      font-size: 18px;
    }
  }

  .pitch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl) var(--space-xxl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--accent-subtle);
  }
  .pitch-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pitch .lede {
    color: var(--color-secondary);
  }
  .pillars {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .pillars p {
    margin-top: 4px;
    color: var(--color-secondary);
  }
  @media (max-width: 760px) {
    .pitch {
      grid-template-columns: 1fr;
    }
  }

  .aspiratio {
    text-align: center;
    font-size: 17px;
    color: var(--color-secondary);
    opacity: 0.75;
    margin-top: calc(-1 * var(--space-md));
  }
</style>
