---
import { getCatalog } from '@/content/contentIndex'
import { flowReference, sourceUrl } from '~/lib/developers/flowReference'
import type { Locale } from '~/lib/locale'
import { massTimesApi } from '~/lib/massTimes/data'
import { href } from '~/routes'
import Code from './Code.astro'
import DevShell from './DevShell.astro'

interface Props {
  locale: Locale
  alternates: Partial<Record<Locale, string>>
}

const { locale, alternates } = Astro.props
const site = Astro.site ?? new URL('https://ember.dpgu.me')
const corpusUrl = new URL('/hearth/v2', site).href
const items = Object.keys(getCatalog().items).length
const flows = flowReference()

const doors = [
  {
    kicker: 'REST · JSON',
    title: 'Mass-times API',
    body: 'Churches near a point, by name or on a map, each with its Mass, confession and adoration times written as recurrence rules.',
    base: massTimesApi,
    to: href.developers(locale, 'api'),
    cta: 'API reference',
  },
  {
    kicker: 'Static · content-addressed',
    title: 'The corpus',
    body: `${items.toLocaleString('en-US')} items: prayers, books, Mass propers, the Liturgy of the Hours and chant, as JSON files any static host can serve.`,
    base: corpusUrl,
    to: href.developers(locale, 'corpus'),
    cta: 'Corpus guide',
  },
  {
    kicker: 'JSON · declarative',
    title: 'Flow DSL',
    body: `The language ${flows.itemCount.toLocaleString('en-US')} prayers and chapters are written in: ${flows.sections.length} section types, each shown with an example from the corpus.`,
    base: undefined,
    to: href.developers(locale, 'flows'),
    cta: 'Language reference',
  },
]

const quickStart = `# The five churches nearest the Sé of São Paulo
curl '${massTimesApi}/churches/near?lat=-23.5505&lng=-46.6333&limit=5'

# Every item in the corpus, by id
curl '${corpusUrl}/catalog.json'`

const fetchRosary = `const base = '${corpusUrl}'
const blob = (hash) => fetch(\`\${base}/blobs/\${hash.slice(0, 2)}/\${hash.slice(2, 4)}/\${hash}\`)

const { items } = await (await fetch(\`\${base}/catalog.json\`)).json()
const manifest = await (await blob(items['practice/rosary'].hash)).json()
const flow = await (await blob(manifest.flowHash.hash)).json()`

const toc = [
  { id: 'start', label: 'Quick start' },
  { id: 'manners', label: 'Using it well' },
  { id: 'licence', label: 'Licence' },
  { id: 'source', label: 'Source' },
]
---

<DevShell
  locale={locale}
  alternates={alternates}
  doc="overview"
  title="Build with Ember"
  kicker="Developers"
  lede="Ember’s data is open: a directory of Mass times to query, and a corpus of prayers, books and liturgy to fetch as static files. There are no keys and no sign-up, and every response allows any origin."
  toc={toc}
>
  <div class="dev-doors">
    {doors.map((d) => (
      <a class="dev-door" href={d.to}>
        <span class="t-kicker">{d.kicker}</span>
        <span class="t-sacred">{d.title}</span>
        <span class="body">{d.body}</span>
        {d.base && <code class="base">{d.base}</code>}
        <span class="go">{d.cta} →</span>
      </a>
    ))}
  </div>

  <section class="dev-section" id="start">
    <h2 class="t-section">Quick start</h2>
    <p>Both resources answer plain HTTP GETs. From a shell:</p>
    <Code code={quickStart} label="Shell" />
    <p>And a prayer, from catalog to text, in a browser or any JavaScript runtime:</p>
    <Code code={fetchRosary} label="JavaScript" />
  </section>

  <section class="dev-section" id="manners">
    <h2 class="t-section">Using it well</h2>
    <ul class="dev-list">
      <li><strong>Cache what you fetch.</strong> A corpus blob is named by the hash of its bytes and never changes; keep it for good. API reads may be held five minutes, map tiles an hour.</li>
      <li><strong>Walk the directory once.</strong> <code>/churches/index</code> pages through every church for a sitemap or a mirror. Run it on a schedule, not per visitor.</li>
      <li><strong>Writes are suggestions.</strong> A correction or a confirmation lands in a queue a person reviews. It never edits a church directly, and each client is rate-limited.</li>
      <li><strong>Name your installation.</strong> Send a stable <code>X-Client-Id</code> with writes, so your users are not counted together.</li>
    </ul>
  </section>

  <section class="dev-section" id="licence">
    <h2 class="t-section">Licence</h2>
    <p>
      Ember’s code and its own content are dedicated to the public domain
      (<a class="xref" href={sourceUrl('LICENSE')} rel="noopener">LICENSE</a>): copy, adapt and sell them without asking.
      Most texts in the corpus are public-domain works and translations. Some come from living publishers,
      so check a book’s stated source before republishing it.
    </p>
  </section>

  <section class="dev-section" id="source">
    <h2 class="t-section">Source</h2>
    <ul class="rows">
      <li><a class="row" href={sourceUrl('apps/backend')} rel="noopener"><span class="grow"><span class="row-title">apps/backend</span><span class="t-caption" style="display:block">The Mass-times Worker: Hono on Cloudflare Workers and D1</span></span></a></li>
      <li><a class="row" href={sourceUrl('packages/api')} rel="noopener"><span class="grow"><span class="row-title">packages/api</span><span class="t-caption" style="display:block">The API’s schemas, its OpenAPI document and a schedule expander</span></span></a></li>
      <li><a class="row" href={sourceUrl('scripts/build-corpus.py')} rel="noopener"><span class="grow"><span class="row-title">scripts/build-corpus.py</span><span class="t-caption" style="display:block">How content/ becomes the published corpus</span></span></a></li>
      <li><a class="row" href={sourceUrl('packages/content-engine')} rel="noopener"><span class="grow"><span class="row-title">packages/content-engine</span><span class="t-caption" style="display:block">The engine that turns a flow into text to pray</span></span></a></li>
    </ul>
  </section>
</DevShell>
