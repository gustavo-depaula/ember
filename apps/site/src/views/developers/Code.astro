---
import { escapeHtml, highlightJson } from '~/lib/developers/json'
import { chooser } from '~/lib/developers/text'
import type { Locale } from '~/lib/locale'

interface Props {
  locale: Locale
  code: string
  json?: boolean
  /** A caption above the block: the file, the shell, where it runs. */
  label?: string
}

const { locale, code, json, label } = Astro.props
const html = json ? highlightJson(code) : escapeHtml(code)
---

<figure class="code">
  {label && <figcaption class="t-kicker">{label}</figcaption>}
  <button class="code-copy" type="button" data-copy={code}>{chooser(locale)('Copy', 'Copiar')}</button>
  <pre><code set:html={html} /></pre>
</figure>
