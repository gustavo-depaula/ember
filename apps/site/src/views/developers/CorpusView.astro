---
import { getCatalog } from '@/content/contentIndex'
import { sourceUrl } from '~/lib/developers/flowReference'
import type { Locale } from '~/lib/locale'
import { href } from '~/routes'
import Code from './Code.astro'
import DevShell from './DevShell.astro'

interface Props {
  locale: Locale
  alternates: Partial<Record<Locale, string>>
}

const { locale, alternates } = Astro.props
const site = Astro.site ?? new URL('https://ember.dpgu.me')
const base = new URL('/hearth/v2', site).href
const catalog = getCatalog()
const counts = Object.values(catalog.items).reduce<Record<string, number>>((out, entry) => {
  out[entry.kind] = (out[entry.kind] ?? 0) + 1
  return out
}, {})
const count = (...kinds: string[]) =>
  kinds.reduce((sum, k) => sum + (counts[k] ?? 0), 0).toLocaleString('en-US')

// Kinds a reader of the corpus meets first, then the liturgical data the engines assemble from.
const kinds: { kinds: string[]; what: string; example?: string }[] = [
  { kinds: ['practice'], what: 'A prayer or devotion: its names, descriptions and length, and its flow, inline as `flow` or by `flowHash`.', example: 'practice/rosary' },
  { kinds: ['book'], what: 'A book: its `toc`, and each chapter’s Markdown under `chapters[node][language]`.', example: 'book/kempis-imitation-of-christ' },
  { kinds: ['chapter'], what: 'A short reading, written as a flow (`contentHash`).', example: 'chapter/about-montfort' },
  { kinds: ['collection'], what: 'A curated index: sections of refs to other items, with notes on each.', example: 'collection/alphonsus-liguori' },
  { kinds: ['plan-of-life-template'], what: 'A rule of life: the practices it keeps, with their schedules.', example: 'plan-of-life-template/beginner-minimum' },
  { kinds: ['creator'], what: 'A Catholic voice: a biography and podcast, YouTube or RSS channels.', example: 'creator/ariel-lazari' },
  { kinds: ['chant'], what: 'A Gregorian chant. Its blob is the score itself, in GABC, from GregoBase (CC0).', example: 'chant/a-solis-ortus-cardine' },
  { kinds: ['chant-book', 'chant-index', 'chant-bundle'], what: 'Books of chant for browsing, and the tables that set a sung text to its score.' },
  { kinds: ['mass-calendar', 'mass-formulary', 'mass-lectionary', 'mass-order', 'mass-prefaces', 'mass-eucharistic-prayer', 'mass-extra'], what: 'The Roman Missal of the ordinary form: its calendar, the propers and readings of each Mass, the Order of Mass, prefaces and Eucharistic Prayers. `@ember/missal` assembles a day’s Mass from them.' },
  { kinds: ['loth-calendar', 'loth-index', 'loth-parts', 'loth-library', 'loth-extras'], what: 'The Brazilian Liturgy of the Hours, which `@ember/loth` assembles hour by hour.' },
  { kinds: ['do-data'], what: 'The Divinum Officium data the extraordinary form’s Mass and Office are assembled from.' },
  { kinds: ['checkup'], what: 'Data for the app’s spiritual check-up.' },
]
const described = new Set(kinds.flatMap((k) => k.kinds))
const undescribed = Object.keys(counts).filter((k) => !described.has(k))
if (undescribed.length) throw new Error(`Developer portal: describe the corpus kinds ${undescribed.join(', ')}`)

const inlineCode = (text: string) => text.replace(/`([^`]+)`/g, '<code>$1</code>')

const catalogExample = JSON.stringify(
  {
    version: 2,
    generated: catalog.generated,
    items: { 'practice/rosary': catalog.items['practice/rosary'] },
  },
  null,
  2,
)

const readBook = `const base = '${base}'
const blob = (hash) => fetch(\`\${base}/blobs/\${hash.slice(0, 2)}/\${hash.slice(2, 4)}/\${hash}\`)

const { items } = await (await fetch(\`\${base}/catalog.json\`)).json()
const book = await (await blob(items['book/kempis-imitation-of-christ'].hash)).json()

// The table of contents names each chapter; chapters[id][language] is its Markdown.
const first = book.toc.find((node) => book.chapters[node.id])
const markdown = await (await blob(book.chapters[first.id]['pt-BR'].hash)).text()`

const verify = `// A blob's name is the SHA-256 of its bytes, so a copy can be checked anywhere.
const bytes = await (await blob(hash)).arrayBuffer()
const digest = await crypto.subtle.digest('SHA-256', bytes)
const ok = [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('') === hash`

const sync = `# Keep a mirror current: ask for the catalog with the ETag you hold
curl -s -D - -o catalog.json -H 'If-None-Match: "<the ETag you saved>"' '${base}/catalog.json'
# 304 → nothing changed. 200 → fetch the hashes you don't have yet; the rest are unchanged.`

const toc = [
  { id: 'layout', label: 'Layout' },
  { id: 'catalog', label: 'The catalog' },
  { id: 'blobs', label: 'Blobs' },
  { id: 'kinds', label: 'Kinds' },
  { id: 'refs', label: 'Refs' },
  { id: 'reading', label: 'Reading a book' },
  { id: 'mirror', label: 'Keeping a mirror' },
  { id: 'explorer', label: 'Explorer' },
]
---

<DevShell
  locale={locale}
  alternates={alternates}
  doc="corpus"
  title="The corpus"
  kicker="Developers · Guide"
  lede={`Everything Ember prays and reads is published as ${Object.keys(catalog.items).length.toLocaleString('en-US')} items of static JSON and text: one catalog, and blobs named by their hash. Any HTTP client can read it, and a copy can be checked byte for byte.`}
  toc={toc}
>
  <section class="dev-section" id="layout">
    <h2 class="t-section">Layout</h2>
    <dl class="dev-facts">
      <dt>Base URL</dt>
      <dd><code>{base}</code> <button class="code-copy inline" type="button" data-copy={base}>Copy</button></dd>
      <dt>Catalog</dt>
      <dd><code>/catalog.json</code>, every item by id (about {Math.round(JSON.stringify(catalog).length / 1024)} KB)</dd>
      <dt>Blobs</dt>
      <dd><code>{'/blobs/{ab}/{cd}/{hash}'}</code>, where <code>ab</code> and <code>cd</code> are the hash’s first four characters</dd>
      <dt>Hosting</dt>
      <dd>GitHub Pages: any origin, <code>ETag</code>s, <code>max-age=600</code>. Rebuilt from <a class="xref" href={sourceUrl('content')} rel="noopener">content/</a> on every change.</dd>
    </dl>
  </section>

  <section class="dev-section" id="catalog">
    <h2 class="t-section">The catalog</h2>
    <p>
      One file maps each item’s id to its <code>kind</code> and the <code>hash</code> and <code>size</code> of its blob.
      It also carries what a list needs without opening the item: names, authors, tags, length, languages.
    </p>
    <Code code={catalogExample} json label="catalog.json, one item of it" />
  </section>

  <section class="dev-section" id="blobs">
    <h2 class="t-section">Blobs</h2>
    <p>
      An item’s blob is usually a JSON manifest, and a manifest points at more blobs by hash: a practice at its flow,
      a book at the Markdown of each chapter, any item at its images. Blobs are served as
      <code>application/octet-stream</code>, so parse a JSON one yourself. JSON blobs are written canonically, with
      sorted keys, no spaces and UTF-8, so the same content always has the same name.
    </p>
    <Code code={verify} label="JavaScript" />
    <p class="t-annotation">
      Because a changed text gets a new name, a fix to one prayer publishes one new flow blob, one new manifest
      and a new catalog. A client fetches those three files and nothing else.
    </p>
  </section>

  <section class="dev-section" id="kinds">
    <h2 class="t-section">Kinds</h2>
    <table class="fields kinds">
      <tbody>
        {kinds.map((k) => (
          <tr>
            <th scope="row">
              {k.kinds.map((kind) => <code class="kind">{kind}</code>)}
              <span class="count">{count(...k.kinds)}</span>
            </th>
            <td>
              <p set:html={inlineCode(k.what)} />
              {k.example && <button class="xref linkish" type="button" data-explore={k.example}>Open {k.example}</button>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="t-annotation">
      Each manifest’s shape is a TypeScript type in
      <a class="xref" href={sourceUrl('apps/app/src/content/manifestTypes.ts')} rel="noopener">manifestTypes.ts</a>.
    </p>
  </section>

  <section class="dev-section" id="refs">
    <h2 class="t-section">Refs</h2>
    <p>
      Items point at one another by id: <code>practice/our-father</code>, <code>book/augustine-confessions</code>.
      A fragment names a place inside an item (<code>book/augustine-confessions#book-eight</code>). Inside a flow a bare ref
      such as <code>sign-of-cross</code> means a practice. Texts in several languages are objects keyed by language,
      <code>{'{ "en-US": …, "pt-BR": …, "la": … }'}</code>; the <a class="xref" href={href.developers(locale, 'flows')}>flow DSL</a> describes them.
    </p>
  </section>

  <section class="dev-section" id="reading">
    <h2 class="t-section">Reading a book</h2>
    <Code code={readBook} label="JavaScript" />
  </section>

  <section class="dev-section" id="mirror">
    <h2 class="t-section">Keeping a mirror</h2>
    <p>
      Blobs never change, so a mirror only ever adds files. Poll the catalog with the <code>ETag</code> you hold, and on
      a change fetch only the hashes you don’t have yet.
    </p>
    <Code code={sync} label="Shell" />
  </section>

  <section class="dev-section" id="explorer">
    <h2 class="t-section">Explorer</h2>
    <p>Open any item and follow its hashes and refs, straight from the published corpus.</p>
    <div class="explorer" data-explorer data-base={base}>
      <form class="try-bar" data-explorer-form>
        <input name="id" list="corpus-ids" placeholder="practice/rosary" aria-label="Item id or blob hash" autocomplete="off" spellcheck="false" />
        <datalist id="corpus-ids"></datalist>
        <button class="try-send" type="submit">Open</button>
      </form>
      <ol class="trail" data-trail></ol>
      <div class="try-result" data-result hidden></div>
    </div>
  </section>
</DevShell>
