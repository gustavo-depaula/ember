---
import { getLiturgicalDayName, rankColors } from '@ember/liturgical'
import Base from '~/layouts/Base.astro'
import { calendarYears, monthName } from '~/lib/dates'
import { efYear, loadOfMonth } from '~/lib/liturgy'
import { type Locale, translator } from '~/lib/locale'
import { today } from '~/lib/today'
import { href, isoDate } from '~/routes'

interface Props {
  locale: Locale
  alternates: Partial<Record<Locale, string>>
  year: number
  month: number
}

const { locale, alternates, year, month } = Astro.props
const t = translator(locale)
const pt = locale === 'pt-BR'
const days = await loadOfMonth(year, month, locale)
const ef = await efYear(year)
const years = calendarYears()
const has = (y: number) => years.includes(y)
const previous = month === 1 ? { year: year - 1, month: 12 } : { year, month: month - 1 }
const next = month === 12 ? { year: year + 1, month: 1 } : { year, month: month + 1 }
const lead = days[0].date.getDay()
const letters = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'].map((d) => t(`calendar.dayLetters.${d}`))
const label = monthName(year, month, locale)
const dayFormat = new Intl.DateTimeFormat(locale, { weekday: 'short', day: 'numeric' })
const named = days.filter((d) => d.principal)
const description = pt
  ? `Calendário litúrgico de ${label}: as solenidades, festas e memórias de cada dia, no calendário atual e no de 1962.`
  : `The liturgical calendar for ${label}: the solemnities, feasts and memorials of each day, in the current calendar and that of 1962.`
---

<Base locale={locale} title={`${t('calendar.title')} — ${label}`} description={description} alternates={alternates} section="calendar">
  <div class="wide cal-page">
    <header class="page-head center">
      <h1 class="t-sacred gold" style="font-size:38px;line-height:46px">{t('calendar.title')}</h1>
    </header>

    <nav class="month-nav" aria-label={t('calendar.title')}>
      {has(previous.year) ? <a href={href.calendarMonth(locale, previous.year, previous.month)} rel="prev" aria-label={monthName(previous.year, previous.month, locale)}>‹</a> : <span />}
      <span class="month-label">{label}</span>
      {has(next.year) ? <a href={href.calendarMonth(locale, next.year, next.month)} rel="next" aria-label={monthName(next.year, next.month, locale)}>›</a> : <span />}
    </nav>

    <div class="cal" role="grid" aria-label={label}>
      {letters.map((letter) => <span class="dow" role="columnheader">{letter}</span>)}
      {Array.from({ length: lead }, () => <span />)}
      {days.map((d) => (
        <a
          class="cell"
          role="gridcell"
          href={href.calendarDay(locale, d.date)}
          aria-current={isoDate(d.date) === isoDate(today) ? 'date' : undefined}
          title={d.principal?.name}
        >
          <span class="cell-day">
            <span>{d.date.getDate()}</span>
            <i style={d.principal ? `background:${rankColors[d.principal.rank as keyof typeof rankColors]}` : undefined} class={d.principal?.rank === 'feast' ? 'ring' : ''} />
          </span>
          <span class="cell-name">{d.principal?.name ?? (d.date.getDay() === 0 ? getLiturgicalDayName(d.date, 'of', { t }) : '')}</span>
          <span class="cell-old" lang="la">{ef.get(`${d.date.getMonth() + 1}-${d.date.getDate()}`)?.name}</span>
        </a>
      ))}
    </div>

    <ul class="rows month-list">
      {days.map((d) => {
        const old = ef.get(`${d.date.getMonth() + 1}-${d.date.getDate()}`)
        const sunday = d.date.getDay() === 0
        if (!d.principal && !old && !sunday) return undefined
        return (
          <li>
            <a class="row" href={href.calendarDay(locale, d.date)}>
              <span class="when">{dayFormat.format(d.date)}</span>
              <span class="grow">
                {d.principal && (
                  <>
                    <span class="row-title">{d.principal.name}</span>
                    <span class="t-kicker" style="display:block">{t(`calendar.rank.${d.principal.rank}`)}</span>
                  </>
                )}
                {!d.principal && sunday && <span class="row-title">{getLiturgicalDayName(d.date, 'of', { t })}</span>}
                {old && <span class="t-annotation old" lang="la">1962 · {old.name}</span>}
              </span>
            </a>
          </li>
        )
      })}
    </ul>
    <p class="t-annotation month-count" style="padding-top:16px">
      {named.length} {pt ? 'celebrações no calendário atual' : 'celebrations in the current calendar'}
    </p>
  </div>
</Base>

<style>
  .month-nav {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    text-align: center;
    padding-block: var(--space-sm);
  }
  .month-nav a {
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    color: var(--gold-ink);
  }
  .month-label {
    font-family: var(--font-heading);
    font-size: 18px;
    letter-spacing: 0.5px;
  }
  .cal {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    max-width: 420px;
    margin-inline: auto;
    padding-block: var(--space-md) var(--space-lg);
  }
  .dow {
    text-align: center;
    font-size: 14px;
    color: var(--color-secondary);
  }
  .cell {
    height: 46px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 17px;
    line-height: 20px;
    font-variant-numeric: lining-nums;
    transition: background-color 0.2s ease;
  }
  .cell:hover {
    background: var(--background-surface);
  }
  .cell[aria-current='date'] {
    color: var(--gold-ink);
    font-weight: 700;
  }
  .cell i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }
  .cell i.ring {
    box-shadow: 0 0 0 1px var(--color-secondary);
  }
  .cell-day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .cell-name,
  .cell-old {
    display: none;
  }
  .cal-page {
    max-width: calc(var(--column) + 2 * var(--gutter));
  }
  /* A wall calendar on a wide screen: each day's square names its feast. */
  @media (min-width: 900px) {
    .cal-page {
      max-width: calc(var(--wide) + 2 * var(--gutter));
    }
    .cal {
      max-width: none;
      gap: 0;
      border-top: 0.5px solid var(--border-color);
      border-left: 0.5px solid var(--border-color);
      padding-block: 0;
      margin-block: var(--space-md) var(--space-xl);
    }
    .dow {
      padding-block: 8px;
      font-family: var(--font-heading);
      font-size: 12px;
      letter-spacing: 1.6px;
      border-right: 0.5px solid var(--border-color);
      border-bottom: 0.5px solid var(--border-color);
    }
    .cal > span:not(.dow) {
      border-right: 0.5px solid var(--border-color);
      border-bottom: 0.5px solid var(--border-color);
    }
    .cell {
      height: auto;
      min-height: 124px;
      border-radius: 0;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 4px;
      padding: 8px 10px 10px;
      border-right: 0.5px solid var(--border-color);
      border-bottom: 0.5px solid var(--border-color);
    }
    .cell-day {
      flex-direction: row;
      align-items: center;
      gap: 8px;
      font-family: var(--font-title);
      font-size: 22px;
      line-height: 26px;
    }
    .cell i {
      width: 7px;
      height: 7px;
    }
    .cell-name {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 15px;
      line-height: 19px;
      font-weight: 400;
      color: var(--color);
    }
    .cell-old {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 13px;
      line-height: 16px;
      font-style: italic;
      font-weight: 400;
      color: var(--color-secondary);
    }
    .month-list,
    .month-count {
      display: none;
    }
    .month-nav {
      max-width: 520px;
      margin-inline: auto;
    }
    .month-label {
      font-size: 22px;
    }
  }
  .when {
    flex: none;
    width: 76px;
    font-family: var(--font-heading);
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-secondary);
  }
  .row {
    align-items: baseline;
  }
  .old {
    display: block;
    font-style: italic;
  }
</style>
