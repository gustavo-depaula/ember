---
import Base from '~/layouts/Base.astro'
import { href } from '~/routes'
---

<Base locale="en-US" title="Page not found" alternates={{}} noindex>
  <div class="column center" style="padding-block:96px">
    <p class="rubric-red" style="font-size:22px" aria-hidden="true">✠</p>
    <h1 class="t-sacred" style="padding-top:16px">This page is not here.</h1>
    <p class="muted" style="padding-top:8px">Esta página não está aqui.</p>
    <p style="padding-top:32px;display:flex;gap:24px;justify-content:center">
      <a class="go" href={href.home('en-US')}>Today →</a>
      <a class="go" href={href.home('pt-BR')}>Hoje →</a>
    </p>
  </div>
</Base>
