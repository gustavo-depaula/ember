---
// The card a prayer's link unfolds into in a chat: the practice's own stamp on
// its jewel tone, its name, and the app's mark. Built as a 1200×630 page and
// photographed to `<slug>.jpg` after the build (scripts/share-cards.mjs), which
// then removes the page.
import { getImage } from 'astro:assets'
import { coverFor } from '@/features/covers/coverFor'
import { toneForKey } from '@/features/explore/bgColor'
import { localizeContent } from '@/lib/i18n'
import appIcon from '../../../../../app/assets/icon.png'
import Cover from '~/components/Cover.astro'
import { htmlLang, type Locale, locales, withLocale } from '~/lib/locale'
import { listPrayers, type PrayerListing } from '~/lib/prayers'
import { siteStrings } from '~/lib/strings'
import { shareDirs, slugOf } from '~/routes'
import '~/styles/global.css'

export async function getStaticPaths() {
  const prayers = await listPrayers()
  return locales.flatMap((locale) =>
    prayers.map((prayer) => ({
      params: { lang: shareDirs[locale], slug: slugOf(prayer.id) },
      props: { locale, prayer },
    })),
  )
}

interface Props {
  locale: Locale
  prayer: PrayerListing
}

const { locale, prayer } = Astro.props
const { id, manifest, entry } = prayer
const s = siteStrings(locale)
const name = withLocale(locale, () => localizeContent(manifest.name))
const cover = withLocale(locale, () => coverFor(entry))
const tone = toneForKey(id)
const days = manifest.program?.totalDays ?? 0
const label = [
  days > 1 ? s('dayCount', { count: days }) : s('prayer'),
  manifest.estimatedMinutes && s('minutes', { count: manifest.estimatedMinutes }),
]
  .filter(Boolean)
  .join(' · ')
// The name is set as large as its length allows beside the stamp.
const nameSize = (() => {
  if (name.length > 100) return 44
  if (name.length > 64) return 54
  if (name.length > 40) return 68
  if (name.length > 24) return 88
  return name.length > 14 ? 108 : 132
})()
const icon = await getImage({ src: appIcon, width: 168, format: 'png' })
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{name}</title>
  </head>
  <body>
    <div class="share-card" style={`--from:${tone.from};--to:${tone.to}`}>
      <div class="main">
        {cover && <div class="stamp"><Cover cover={cover} id={id} title={name} locale={locale} /></div>}
        <div class="txt">
          <div class="lab">{label}</div>
          <div class="name" style={`font-size:${nameSize}px`}>{name}</div>
        </div>
      </div>
      <div class="brand">
        <img src={icon.src} alt="" />
        <p>{s('prayWith')} <b>Ember</b></p>
      </div>
    </div>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
  }
  .share-card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: linear-gradient(155deg, var(--from), var(--to));
    color: #f5efe2;
  }
  .share-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.07),
      transparent 35%,
      transparent 70%,
      rgba(0, 0, 0, 0.18)
    );
  }
  .share-card .main {
    position: absolute;
    inset: 0 72px 110px;
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .share-card .stamp {
    width: 340px;
    flex: none;
    transform: rotate(-3deg);
  }
  /* The stamp is a tile's size here: a name longer than it holds is cut, and
     read in full beside it. */
  .share-card .stamp .t {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }
  .share-card .txt {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  .share-card .lab {
    font-family: var(--font-heading);
    font-size: 24px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #e8c97a;
  }
  .share-card .name {
    font-family: var(--font-title);
    line-height: 1.02;
    text-wrap: balance;
  }
  .share-card .brand {
    position: absolute;
    inset: auto 72px 44px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding-top: 26px;
    border-top: 1px solid rgba(232, 201, 122, 0.35);
  }
  .share-card .brand img {
    width: 84px;
    height: 84px;
    border-radius: 19px;
  }
  .share-card .brand p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 48px;
    line-height: 1;
  }
  .share-card .brand b {
    font-weight: 700;
  }
</style>
